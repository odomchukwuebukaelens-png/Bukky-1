#!/usr/bin/env bash
# City Studio launcher. Usage:
#   ./studio setup                     - install Blender and FFmpeg (run after every pod start)
#   ./studio check                     - confirm Blender can use the GPU
#   ./studio preview briefs/X.json     - render 3 still frames (cheap look)
#   ./studio run briefs/X.json         - render everything and make the MP4
#   ./studio sample briefs/X.json      - 15-second sample cut from moments of the full video
#   ./studio songs LINK1 LINK2         - download the two background songs from Google Drive
#   ./studio start briefs/X.json       - same as run, but in the background (safe to close the page)
#   ./studio progress                  - show how far a background render has got
#   ./studio stop                      - stop a background render
#   ./studio share                     - serve the output folder (on RunPod, JupyterLab on port 8888 is easier)
# Optional: WORKERS=4 ./studio run ...   ENGINE=cycles ./studio run ...
set -euo pipefail
cd "$(dirname "$0")"
BLENDER_VERSION="4.2.3"
if [ -z "${BLENDER:-}" ]; then
  if [ -x tools/blender/blender ]; then BLENDER="$PWD/tools/blender/blender"; else BLENDER="blender"; fi
fi
SCRIPT="citystudio/make_video.py"
bl() { "$BLENDER" -b -P "$SCRIPT" -- "$@"; }
say() { grep --line-buffered -F "[city-studio]" || true; }
need_blender() {
  command -v "$BLENDER" >/dev/null 2>&1 || { echo "Blender not found. Run ./studio setup first."; exit 1; }
  # a restarted pod loses its system libraries; reinstall them automatically
  if ! ldconfig -p 2>/dev/null | grep -q "libEGL.so.1" || ! command -v ffmpeg >/dev/null 2>&1 \
     || [ ! -f /usr/share/fonts/truetype/lato/Lato-Bold.ttf ]; then
    echo "[city-studio] Pod was restarted - reinstalling system libraries first..."
    "$0" setup
  fi
}

pick_engine() {   # fast EEVEE if it works on this machine, otherwise Cycles
  if [ -n "${ENGINE:-}" ]; then echo "$ENGINE"; return; fi
  if bl --probe-eevee >/dev/null 2>&1; then echo eevee; else echo cycles; fi
}

case "${1:-}" in
  setup)
    SUDO=""; [ "$(id -u)" -ne 0 ] && SUDO="sudo"
    echo "[city-studio] Installing FFmpeg and system libraries..."
    $SUDO apt-get update -qq
    $SUDO apt-get install -y -qq ffmpeg xz-utils curl libgl1 libegl1 libxi6 libxxf86vm1 libxfixes3 \
      libxrender1 libxkbcommon0 libsm6 libice6 python3-pil python3-numpy \
      fonts-bebas-neue fonts-roboto-unhinted fonts-dejavu-core fonts-league-spartan fonts-lato >/dev/null
    if [ ! -x tools/blender/blender ]; then
      echo "[city-studio] Downloading Blender $BLENDER_VERSION (about 350 MB)..."
      mkdir -p tools
      curl -fL --retry 3 -o tools/blender.tar.xz \
        "https://download.blender.org/release/Blender${BLENDER_VERSION%.*}/blender-${BLENDER_VERSION}-linux-x64.tar.xz"
      rm -rf tools/blender tools/unpack && mkdir tools/unpack
      tar -xJf tools/blender.tar.xz -C tools/unpack
      mv tools/unpack/blender-* tools/blender
      rm -rf tools/unpack tools/blender.tar.xz
    fi
    for f in /usr/share/fonts/opentype/league-spartan/LeagueSpartan-Bold.otf /usr/share/fonts/truetype/lato/Lato-Bold.ttf \
             /usr/share/fonts/opentype/bebas-neue/BebasNeue-Regular.otf; do
      [ -f "$f" ] || echo "[city-studio] WARNING: missing font $f"
    done
    echo "[city-studio] Setup finished. Next: ./studio check"
    ;;
  check)
    need_blender
    bl --check 2>&1 | say
    if bl --probe-eevee >/dev/null 2>&1; then echo "[city-studio] Fast renderer (EEVEE): AVAILABLE"
    else echo "[city-studio] Fast renderer (EEVEE): not available here - Cycles will be used"; fi
    ;;
  preview)
    need_blender
    bl "${2:?give a brief file}" --stills --engine="$(pick_engine)" 2>&1 | say
    ;;
  run)
    need_blender
    BRIEF="${2:?give a brief file}"
    ENGINE_USED="$(pick_engine)"
    if [ -z "${WORKERS:-}" ]; then
      if command -v nvidia-smi >/dev/null 2>&1; then WORKERS=3; else WORKERS=1; fi
    fi
    START=$(date +%s)
    PIDS=()
    for ((i = 0; i < WORKERS; i++)); do
      bl "$BRIEF" --engine="$ENGINE_USED" --worker="$i/$WORKERS" 2>&1 | say &
      PIDS+=($!)
    done
    FAIL=0
    for p in "${PIDS[@]}"; do wait "$p" || FAIL=1; done
    [ "$FAIL" -eq 0 ] || { echo "[city-studio] A worker stopped early. Run the same command again to continue."; exit 1; }
    bl "$BRIEF" --assemble 2>&1 | say
    echo "[city-studio] Total time: $(( ($(date +%s) - START) / 60 )) min $(( ($(date +%s) - START) % 60 )) s"
    ;;
  songs)
    # ./studio songs <drive link for Packed> <drive link for Outside the Box>
    mkdir -p assets/music
    get() {
      id=$(echo "$1" | sed -E 's#.*/d/([^/?]+).*#\1#; s#.*[?&]id=([^&]+).*#\1#')
      curl -fsSL --retry 3 -o "assets/music/$2" "https://drive.usercontent.google.com/download?id=$id&export=download&confirm=t" \
        && echo "[city-studio] Saved assets/music/$2 ($(du -h "assets/music/$2" | cut -f1))" \
        || echo "[city-studio] Could not download $2 - check the link is shared as 'Anyone with the link'"
    }
    get "${2:?give the Drive link for Packed}" packed.mp3
    get "${3:?give the Drive link for Outside the Box}" outside_the_box.mp3
    ;;
  sample)
    need_blender
    BRIEF="${2:?give a brief file}"
    ENGINE_USED="$(pick_engine)"
    if [ -z "${WORKERS:-}" ]; then
      if command -v nvidia-smi >/dev/null 2>&1; then WORKERS=3; else WORKERS=1; fi
    fi
    START=$(date +%s)
    PIDS=()
    for ((i = 0; i < WORKERS; i++)); do
      bl "$BRIEF" --sample --engine="$ENGINE_USED" --worker="$i/$WORKERS" 2>&1 | say &
      PIDS+=($!)
    done
    FAIL=0
    for p in "${PIDS[@]}"; do wait "$p" || FAIL=1; done
    [ "$FAIL" -eq 0 ] || { echo "[city-studio] A worker stopped early. Run the same command again to continue."; exit 1; }
    bl "$BRIEF" --sample --assemble 2>&1 | say
    echo "[city-studio] Total time: $(( ($(date +%s) - START) / 60 )) min $(( ($(date +%s) - START) % 60 )) s"
    ;;
  start)
    BRIEF="${2:?give a brief file}"
    need_blender
    if pgrep -f "make_video.py" >/dev/null; then
      echo "[city-studio] A render is already running. Check it with ./studio progress (or stop it with ./studio stop)."
      exit 0
    fi
    mkdir -p output
    # setsid puts the render in its own session, so closing the web terminal cannot stop it
    setsid nohup "$0" run "$BRIEF" > output/render.log 2>&1 < /dev/null &
    echo "[city-studio] Rendering in the background. You can close this page."
    echo "[city-studio] Check on it any time with: ./studio progress"
    ;;
  progress)
    for d in output/*/chunks; do
      [ -d "$d" ] && echo "[city-studio] $(basename "$(dirname "$d")"): $(ls "$d" | grep -c '^chunk_.*[0-9]\.mp4$') chunks finished"
    done
    if [ -f output/render.log ]; then grep -v "font .* not found" output/render.log | tail -n 6
    else echo "No render log yet."; fi
    pgrep -f "make_video.py" >/dev/null && echo "[city-studio] Status: rendering" || echo "[city-studio] Status: not running"
    ;;
  stop)
    pkill -f "studio run" || true
    pkill -f "make_video.py" || true
    echo "[city-studio] Render stopped. Run ./studio start again later to carry on."
    ;;
  share)
    PORT="${2:-8890}"
    echo "[city-studio] Serving the output folder on port $PORT."
    echo "[city-studio] In RunPod, open Connect > HTTP Service [Port $PORT], then tap your video to download."
    echo "[city-studio] Press Ctrl+C here when you are done."
    cd output && python3 -m http.server "$PORT"
    ;;
  *) sed -n '2,10p' "$0" ;;
esac
