[
{
"scene": "01",
"t0": 0.0,
"t1": 1.02,
"text": "Antarctica."
},
{
"scene": "01",
"t0": 1.02,
"t1": 2.95,
"text": "2006."
},
{
"scene": "01",
"t0": 2.95,
"t1": 4.76,
"text": "A photographer slips into the freezing"
},
{
"scene": "01",
"t0": 4.76,
"t1": 5.88,
"text": "water under the ice, alone,"
},
{
"scene": "01",
"t0": 5.88,
"t1": 6.99,
"text": "\u2026"
},
{
"scene": "01",
"t0": 6.99,
"t1": 8.31,
"text": "with his camera."
},
{
"scene": "01",
"t0": 8.31,
"t1": 9.36,
"text": "The water is just below freezing."
},
{
"scene": "01",
"t0": 9.36,
"t1": 10.4,
"text": "\u2026"
},
{
"scene": "01",
"t0": 10.4,
"t1": 12.29,
"text": "The light fades fast."
},
{
"scene": "01",
"t0": 12.29,
"t1": 13.42,
"text": "All he can hear is his own breathing."
},
{
"scene": "01",
"t0": 13.42,
"t1": 14.55,
"text": "\u2026"
},
{
"scene": "01",
"t0": 14.55,
"t1": 16.24,
"text": "Out of the dark comes a female"
},
{
"scene": "01",
"t0": 16.24,
"t1": 17.38,
"text": "leopard seal."
},
{
"scene": "01",
"t0": 17.38,
"t1": 19.13,
"text": "Three and a half metres long."
},
{
"scene": "01",
"t0": 19.13,
"t1": 20.66,
"text": "Heavier than a horse."
},
{
"scene": "01",
"t0": 20.66,
"t1": 22.2,
"text": "She swims straight at him."
},
{
"scene": "01",
"t0": 22.2,
"t1": 23.81,
"text": "And she opens her mouth around his"
},
{
"scene": "01",
"t0": 23.81,
"t1": 25.55,
"text": "camera, and his head."
},
{
"scene": "01",
"t0": 25.55,
"t1": 27.07,
"text": "So what happens when a leopard seal"
},
{
"scene": "01",
"t0": 27.07,
"t1": 28.43,
"text": "decides what you are?"
},
{
"scene": "01",
"t0": 28.43,
"t1": 30.18,
"text": "Why does it look like it's smiling?"
},
{
"scene": "01",
"t0": 30.18,
"t1": 31.72,
"text": "Has it ever killed a person?"
},
{
"scene": "01",
"t0": 31.72,
"t1": 33.32,
"text": "And why would a killer like this try"
},
{
"scene": "01",
"t0": 33.32,
"t1": 34.51,
"text": "to feed a human?"
},
{
"scene": "02",
"t0": 0.0,
"t1": 1.07,
"text": "This is the leopard seal."
},
{
"scene": "02",
"t0": 1.07,
"t1": 2.15,
"text": "\u2026"
},
{
"scene": "02",
"t0": 2.15,
"t1": 3.67,
"text": "It lives on the pack ice around"
},
{
"scene": "02",
"t0": 3.67,
"t1": 5.35,
"text": "Antarctica, and it is the"
},
{
"scene": "02",
"t0": 5.35,
"t1": 6.97,
"text": "only seal known to hunt other"
},
{
"scene": "02",
"t0": 6.97,
"t1": 8.75,
"text": "seals. Its head looks"
},
{
"scene": "02",
"t0": 8.75,
"t1": 10.35,
"text": "less like a seal's and more"
},
{
"scene": "02",
"t0": 10.35,
"t1": 11.85,
"text": "like a reptile's."
},
{
"scene": "02",
"t0": 11.85,
"t1": 13.55,
"text": "Long. Flat."
},
{
"scene": "02",
"t0": 13.55,
"t1": 15.27,
"text": "Built around its jaws."
},
{
"scene": "02",
"t0": 15.27,
"t1": 17.24,
"text": "Its name comes from its coat."
},
{
"scene": "02",
"t0": 17.24,
"t1": 18.74,
"text": "Dark grey on the back,"
},
{
"scene": "02",
"t0": 18.74,
"t1": 19.82,
"text": "and pale on the throat and sides,"
},
{
"scene": "02",
"t0": 19.82,
"t1": 20.91,
"text": "\u2026"
},
{
"scene": "02",
"t0": 20.91,
"t1": 22.42,
"text": "covered in dark spots,"
},
{
"scene": "02",
"t0": 22.42,
"t1": 23.78,
"text": "like a leopard."
},
{
"scene": "02",
"t0": 23.78,
"t1": 24.8,
"text": "The females are bigger than the males,"
},
{
"scene": "02",
"t0": 24.8,
"t1": 25.83,
"text": "\u2026"
},
{
"scene": "02",
"t0": 25.83,
"t1": 27.48,
"text": "which is rare for a mammal."
},
{
"scene": "02",
"t0": 27.48,
"t1": 29.05,
"text": "A large female can be more than"
},
{
"scene": "02",
"t0": 29.05,
"t1": 30.69,
"text": "three and a half metres long"
},
{
"scene": "02",
"t0": 30.69,
"t1": 32.25,
"text": "and weigh more than five hundred"
},
{
"scene": "02",
"t0": 32.25,
"t1": 33.44,
"text": "kilograms."
},
{
"scene": "02",
"t0": 33.44,
"t1": 34.66,
"text": "It hunts alone."
},
{
"scene": "02",
"t0": 34.66,
"t1": 36.32,
"text": "It does not need anyone."
},
{
"scene": "02",
"t0": 36.32,
"t1": 37.93,
"text": "And when it opens its mouth,"
},
{
"scene": "02",
"t0": 37.93,
"t1": 38.96,
"text": "it opens it very, very wide."
},
{
"scene": "02",
"t0": 38.96,
"t1": 39.99,
"text": "\u2026"
},
{
"scene": "03",
"t0": 0.0,
"t1": 1.5,
"text": "At the front, it has"
},
{
"scene": "03",
"t0": 1.5,
"t1": 3.15,
"text": "long canine teeth,"
},
{
"scene": "03",
"t0": 3.15,
"t1": 5.11,
"text": "made for gripping and killing."
},
{
"scene": "03",
"t0": 5.11,
"t1": 6.5,
"text": "But behind them is something"
},
{
"scene": "03",
"t0": 6.5,
"t1": 7.56,
"text": "stranger."
},
{
"scene": "03",
"t0": 7.56,
"t1": 9.19,
"text": "Its cheek teeth have three"
},
{
"scene": "03",
"t0": 9.19,
"t1": 10.71,
"text": "sharp points each,"
},
{
"scene": "03",
"t0": 10.71,
"t1": 12.35,
"text": "and they lock together like the teeth"
},
{
"scene": "03",
"t0": 12.35,
"t1": 13.68,
"text": "of a comb."
},
{
"scene": "03",
"t0": 13.68,
"t1": 15.43,
"text": "Scientists in Australia watched"
},
{
"scene": "03",
"t0": 15.43,
"t1": 17.24,
"text": "leopard seals feed and found"
},
{
"scene": "03",
"t0": 17.24,
"t1": 18.92,
"text": "what they were for."
},
{
"scene": "03",
"t0": 18.92,
"t1": 20.54,
"text": "The seal sucks in a mouthful"
},
{
"scene": "03",
"t0": 20.54,
"t1": 22.12,
"text": "of water full of krill,"
},
{
"scene": "03",
"t0": 22.12,
"t1": 23.63,
"text": "and pushes the water back out"
},
{
"scene": "03",
"t0": 23.63,
"t1": 24.8,
"text": "through those teeth."
},
{
"scene": "03",
"t0": 24.8,
"t1": 26.78,
"text": "The krill stay inside."
},
{
"scene": "03",
"t0": 26.78,
"t1": 28.35,
"text": "In some places, krill"
},
{
"scene": "03",
"t0": 28.35,
"t1": 30.27,
"text": "make up most of what it eats."
},
{
"scene": "03",
"t0": 30.27,
"t1": 32.0,
"text": "So this is an animal that can strain"
},
{
"scene": "03",
"t0": 32.0,
"t1": 33.82,
"text": "food as small as a paperclip,"
},
{
"scene": "03",
"t0": 33.82,
"t1": 34.91,
"text": "and kill prey as big as a seal."
},
{
"scene": "03",
"t0": 34.91,
"t1": 35.99,
"text": "\u2026"
},
{
"scene": "03",
"t0": 35.99,
"t1": 37.49,
"text": "With the same mouth."
},
{
"scene": "04",
"t0": 0.0,
"t1": 1.49,
"text": "Here is the answer to the first"
},
{
"scene": "04",
"t0": 1.49,
"t1": 2.5,
"text": "question."
},
{
"scene": "04",
"t0": 2.5,
"t1": 4.04,
"text": "The corners of a leopard seal's"
},
{
"scene": "04",
"t0": 4.04,
"t1": 5.83,
"text": "mouth curve upwards."
},
{
"scene": "04",
"t0": 5.83,
"t1": 7.4,
"text": "From the front, it looks like"
},
{
"scene": "04",
"t0": 7.4,
"t1": 8.82,
"text": "it's smiling at you."
},
{
"scene": "04",
"t0": 8.82,
"t1": 9.96,
"text": "It isn't."
},
{
"scene": "04",
"t0": 9.96,
"t1": 11.58,
"text": "That shape is just how its jaw"
},
{
"scene": "04",
"t0": 11.58,
"t1": 12.67,
"text": "is built."
},
{
"scene": "04",
"t0": 12.67,
"t1": 14.18,
"text": "It has nothing to do with how it"
},
{
"scene": "04",
"t0": 14.18,
"t1": 15.53,
"text": "feels about you."
},
{
"scene": "04",
"t0": 15.53,
"t1": 17.3,
"text": "People who work in Antarctica learn"
},
{
"scene": "04",
"t0": 17.3,
"t1": 18.33,
"text": "to read the rest of the animal instead."
},
{
"scene": "04",
"t0": 18.33,
"t1": 19.36,
"text": "\u2026"
},
{
"scene": "04",
"t0": 19.36,
"t1": 20.65,
"text": "Where it is looking."
},
{
"scene": "04",
"t0": 20.65,
"t1": 21.87,
"text": "How close it is."
},
{
"scene": "04",
"t0": 21.87,
"t1": 23.47,
"text": "Whether it keeps following."
},
{
"scene": "04",
"t0": 23.47,
"t1": 25.1,
"text": "Because that friendly face"
},
{
"scene": "04",
"t0": 25.1,
"t1": 26.62,
"text": "is the last thing many animals"
},
{
"scene": "04",
"t0": 26.62,
"t1": 27.4,
"text": "ever see."
},
{
"scene": "05",
"t0": 0.0,
"t1": 1.63,
"text": "Its favourite place is the edge"
},
{
"scene": "05",
"t0": 1.63,
"t1": 2.79,
"text": "of the ice."
},
{
"scene": "05",
"t0": 2.79,
"t1": 4.34,
"text": "Penguins have to cross it twice"
},
{
"scene": "05",
"t0": 4.34,
"t1": 5.95,
"text": "a day. Out to sea to"
},
{
"scene": "05",
"t0": 5.95,
"t1": 7.85,
"text": "feed, and back again."
},
{
"scene": "05",
"t0": 7.85,
"t1": 8.91,
"text": "The penguins seem to know the danger."
},
{
"scene": "05",
"t0": 8.91,
"t1": 9.97,
"text": "\u2026"
},
{
"scene": "05",
"t0": 9.97,
"t1": 11.31,
"text": "They crowd at the edge,"
},
{
"scene": "05",
"t0": 11.31,
"t1": 12.89,
"text": "hesitating, waiting for"
},
{
"scene": "05",
"t0": 12.89,
"t1": 14.86,
"text": "someone else to go first."
},
{
"scene": "05",
"t0": 14.86,
"t1": 16.49,
"text": "The leopard seal waits just under"
},
{
"scene": "05",
"t0": 16.49,
"t1": 18.3,
"text": "the edge, almost completely"
},
{
"scene": "05",
"t0": 18.3,
"t1": 20.03,
"text": "hidden. When a penguin"
},
{
"scene": "05",
"t0": 20.03,
"t1": 21.61,
"text": "jumps in, it strikes from"
},
{
"scene": "05",
"t0": 21.61,
"t1": 22.61,
"text": "below."
},
{
"scene": "05",
"t0": 22.61,
"t1": 24.55,
"text": "Then it does something brutal."
},
{
"scene": "05",
"t0": 24.55,
"t1": 26.07,
"text": "It grabs the bird and whips"
},
{
"scene": "05",
"t0": 26.07,
"t1": 28.05,
"text": "it against the surface of the water,"
},
{
"scene": "05",
"t0": 28.05,
"t1": 29.8,
"text": "again and again, until"
},
{
"scene": "05",
"t0": 29.8,
"t1": 31.66,
"text": "the skin comes away."
},
{
"scene": "05",
"t0": 31.66,
"t1": 33.04,
"text": "It is fast."
},
{
"scene": "05",
"t0": 33.04,
"t1": 34.35,
"text": "It is patient."
},
{
"scene": "05",
"t0": 34.35,
"t1": 36.09,
"text": "And it hunts the place where the ice"
},
{
"scene": "05",
"t0": 36.09,
"t1": 37.53,
"text": "meets the water."
},
{
"scene": "05",
"t0": 37.53,
"t1": 39.49,
"text": "Which is exactly where people stand,"
},
{
"scene": "05",
"t0": 39.49,
"t1": 40.12,
"text": "too."
},
{
"scene": "06",
"t0": 0.0,
"t1": 1.55,
"text": "In 1916,"
},
{
"scene": "06",
"t0": 1.55,
"t1": 3.03,
"text": "the men of Ernest Shackleton's"
},
{
"scene": "06",
"t0": 3.03,
"t1": 4.58,
"text": "expedition were stranded on the"
},
{
"scene": "06",
"t0": 4.58,
"t1": 6.35,
"text": "sea ice after their ship,"
},
{
"scene": "06",
"t0": 6.35,
"t1": 7.52,
"text": "the Endurance, had been crushed."
},
{
"scene": "06",
"t0": 7.52,
"t1": 8.69,
"text": "\u2026"
},
{
"scene": "06",
"t0": 8.69,
"t1": 9.95,
"text": "One of them, Thomas"
},
{
"scene": "06",
"t0": 9.95,
"t1": 11.54,
"text": "Orde-Lees, was out on"
},
{
"scene": "06",
"t0": 11.54,
"t1": 13.22,
"text": "the ice alone, looking for"
},
{
"scene": "06",
"t0": 13.22,
"t1": 14.93,
"text": "food. A leopard seal"
},
{
"scene": "06",
"t0": 14.93,
"t1": 16.65,
"text": "burst out of the water and went"
},
{
"scene": "06",
"t0": 16.65,
"t1": 17.84,
"text": "after him."
},
{
"scene": "06",
"t0": 17.84,
"t1": 19.65,
"text": "It chased him across the ice."
},
{
"scene": "06",
"t0": 19.65,
"t1": 20.66,
"text": "He ran."
},
{
"scene": "06",
"t0": 20.66,
"t1": 22.25,
"text": "It dived under the ice,"
},
{
"scene": "06",
"t0": 22.25,
"t1": 23.76,
"text": "and burst up again right in"
},
{
"scene": "06",
"t0": 23.76,
"t1": 24.88,
"text": "front of him."
},
{
"scene": "06",
"t0": 24.88,
"t1": 26.63,
"text": "He screamed for help."
},
{
"scene": "06",
"t0": 26.63,
"t1": 28.41,
"text": "Frank Wild, the expedition's"
},
{
"scene": "06",
"t0": 28.41,
"t1": 30.01,
"text": "second-in-command, ran out"
},
{
"scene": "06",
"t0": 30.01,
"t1": 31.55,
"text": "with a rifle and shot it,"
},
{
"scene": "06",
"t0": 31.55,
"t1": 33.5,
"text": "about nine metres from him."
},
{
"scene": "06",
"t0": 33.5,
"t1": 35.01,
"text": "The men had travelled to the bottom of"
},
{
"scene": "06",
"t0": 35.01,
"t1": 36.6,
"text": "the world. And one of them"
},
{
"scene": "06",
"t0": 36.6,
"t1": 38.15,
"text": "had nearly been taken by the thing"
},
{
"scene": "06",
"t0": 38.15,
"t1": 39.55,
"text": "that lived under it."
},
{
"scene": "07",
"t0": 0.0,
"t1": 1.62,
"text": "For a hundred years,"
},
{
"scene": "07",
"t0": 1.62,
"t1": 3.15,
"text": "almost every meeting between"
},
{
"scene": "07",
"t0": 3.15,
"t1": 4.83,
"text": "people and leopard seals happened"
},
{
"scene": "07",
"t0": 4.83,
"t1": 6.04,
"text": "on the ice."
},
{
"scene": "07",
"t0": 6.04,
"t1": 7.67,
"text": "Then people started to dive in"
},
{
"scene": "07",
"t0": 7.67,
"t1": 8.92,
"text": "Antarctica."
},
{
"scene": "07",
"t0": 8.92,
"t1": 10.04,
"text": "Scientists, photographers,"
},
{
"scene": "07",
"t0": 10.04,
"t1": 11.15,
"text": "\u2026"
},
{
"scene": "07",
"t0": 11.15,
"t1": 12.52,
"text": "film crews."
},
{
"scene": "07",
"t0": 12.52,
"t1": 14.07,
"text": "Under the water, the leopard"
},
{
"scene": "07",
"t0": 14.07,
"t1": 16.03,
"text": "seal is in its own world."
},
{
"scene": "07",
"t0": 16.03,
"t1": 17.48,
"text": "It is faster than you."
},
{
"scene": "07",
"t0": 17.48,
"t1": 19.06,
"text": "It sees better than you."
},
{
"scene": "07",
"t0": 19.06,
"t1": 20.58,
"text": "And it can stay down longer than"
},
{
"scene": "07",
"t0": 20.58,
"t1": 22.46,
"text": "you. To a seal,"
},
{
"scene": "07",
"t0": 22.46,
"t1": 23.98,
"text": "a diver is slow,"
},
{
"scene": "07",
"t0": 23.98,
"t1": 25.73,
"text": "clumsy and loud."
},
{
"scene": "07",
"t0": 25.73,
"t1": 27.29,
"text": "Every breath sends a stream of"
},
{
"scene": "07",
"t0": 27.29,
"t1": 28.98,
"text": "bubbles to the surface."
},
{
"scene": "07",
"t0": 28.98,
"t1": 30.14,
"text": "Every kick stirs the water."
},
{
"scene": "07",
"t0": 30.14,
"t1": 31.31,
"text": "\u2026"
},
{
"scene": "07",
"t0": 31.31,
"t1": 32.43,
"text": "Many divers say the same thing."
},
{
"scene": "07",
"t0": 32.43,
"t1": 33.55,
"text": "\u2026"
},
{
"scene": "07",
"t0": 33.55,
"t1": 35.48,
"text": "They did not see it arrive."
},
{
"scene": "07",
"t0": 35.48,
"t1": 37.19,
"text": "It was just there, beside"
},
{
"scene": "07",
"t0": 37.19,
"t1": 38.98,
"text": "them, watching."
},
{
"scene": "07",
"t0": 38.98,
"t1": 40.73,
"text": "Some seals swim away."
},
{
"scene": "07",
"t0": 40.73,
"t1": 41.84,
"text": "Some follow."
},
{
"scene": "07",
"t0": 41.84,
"t1": 43.44,
"text": "And some come closer,"
},
{
"scene": "07",
"t0": 43.44,
"t1": 45.09,
"text": "and closer, to find out"
},
{
"scene": "07",
"t0": 45.09,
"t1": 46.19,
"text": "what you are."
},
{
"scene": "07",
"t0": 46.19,
"t1": 48.17,
"text": "That is what happened to the photographer."
},
{
"scene": "08",
"t0": 0.0,
"t1": 1.76,
"text": "His name is Paul Nicklen,"
},
{
"scene": "08",
"t0": 1.76,
"t1": 3.58,
"text": "and he was in Antarctica to photograph"
},
{
"scene": "08",
"t0": 3.58,
"t1": 4.78,
"text": "leopard seals for National"
},
{
"scene": "08",
"t0": 4.78,
"t1": 6.05,
"text": "Geographic."
},
{
"scene": "08",
"t0": 6.05,
"t1": 7.65,
"text": "When the big female first swam"
},
{
"scene": "08",
"t0": 7.65,
"t1": 8.75,
"text": "at him, he thought he might die."
},
{
"scene": "08",
"t0": 8.75,
"t1": 9.85,
"text": "\u2026"
},
{
"scene": "08",
"t0": 9.85,
"t1": 11.79,
"text": "She opened her jaws around his camera,"
},
{
"scene": "08",
"t0": 11.79,
"t1": 13.25,
"text": "and around his head."
},
{
"scene": "08",
"t0": 13.25,
"t1": 14.68,
"text": "Then she let go."
},
{
"scene": "08",
"t0": 14.68,
"t1": 16.22,
"text": "And then she swam away, and"
},
{
"scene": "08",
"t0": 16.22,
"t1": 17.92,
"text": "came back with a penguin."
},
{
"scene": "08",
"t0": 17.92,
"t1": 19.02,
"text": "She let it go in front of him."
},
{
"scene": "08",
"t0": 19.02,
"t1": 20.11,
"text": "\u2026"
},
{
"scene": "08",
"t0": 20.11,
"t1": 22.05,
"text": "Alive. When he did nothing,"
},
{
"scene": "08",
"t0": 22.05,
"t1": 23.63,
"text": "she brought another one."
},
{
"scene": "08",
"t0": 23.63,
"t1": 25.19,
"text": "For four days, every"
},
{
"scene": "08",
"t0": 25.19,
"t1": 26.85,
"text": "time he got into the water,"
},
{
"scene": "08",
"t0": 26.85,
"t1": 28.69,
"text": "she brought him penguins."
},
{
"scene": "08",
"t0": 28.69,
"t1": 29.7,
"text": "Live ones that swam away."
},
{
"scene": "08",
"t0": 29.7,
"t1": 30.7,
"text": "\u2026"
},
{
"scene": "08",
"t0": 30.7,
"t1": 32.35,
"text": "Then dead ones, pushed"
},
{
"scene": "08",
"t0": 32.35,
"t1": 33.5,
"text": "right up against his camera."
},
{
"scene": "08",
"t0": 33.5,
"t1": 34.65,
"text": "\u2026"
},
{
"scene": "08",
"t0": 34.65,
"t1": 36.23,
"text": "She seemed frustrated that he could"
},
{
"scene": "08",
"t0": 36.23,
"t1": 37.65,
"text": "not catch anything."
},
{
"scene": "08",
"t0": 37.65,
"t1": 39.15,
"text": "When he kept refusing,"
},
{
"scene": "08",
"t0": 39.15,
"t1": 40.19,
"text": "she blew bubbles in his face,"
},
{
"scene": "08",
"t0": 40.19,
"t1": 41.22,
"text": "\u2026"
},
{
"scene": "08",
"t0": 41.22,
"t1": 42.76,
"text": "and swam past him with another"
},
{
"scene": "08",
"t0": 42.76,
"t1": 44.28,
"text": "penguin, as if to show"
},
{
"scene": "08",
"t0": 44.28,
"t1": 45.88,
"text": "him how it was done."
},
{
"scene": "08",
"t0": 45.88,
"t1": 47.45,
"text": "He came out of the water with some of"
},
{
"scene": "08",
"t0": 47.45,
"t1": 48.85,
"text": "the most famous wildlife"
},
{
"scene": "08",
"t0": 48.85,
"t1": 50.68,
"text": "photographs ever taken."
},
{
"scene": "08",
"t0": 50.68,
"t1": 52.29,
"text": "And a story no one had heard"
},
{
"scene": "08",
"t0": 52.29,
"t1": 53.08,
"text": "before."
},
{
"scene": "09",
"t0": 0.0,
"t1": 1.63,
"text": "So why would a predator"
},
{
"scene": "09",
"t0": 1.63,
"t1": 3.02,
"text": "feed a human?"
},
{
"scene": "09",
"t0": 3.02,
"t1": 4.76,
"text": "No one knows for sure."
},
{
"scene": "09",
"t0": 4.76,
"t1": 6.32,
"text": "One idea is that she saw"
},
{
"scene": "09",
"t0": 6.32,
"t1": 8.09,
"text": "a clumsy, slow creature"
},
{
"scene": "09",
"t0": 8.09,
"t1": 9.7,
"text": "in her water, one that could"
},
{
"scene": "09",
"t0": 9.7,
"t1": 11.47,
"text": "not hunt, and tried to help"
},
{
"scene": "09",
"t0": 11.47,
"t1": 13.04,
"text": "it. Another is"
},
{
"scene": "09",
"t0": 13.04,
"t1": 14.58,
"text": "that she was teaching it, the"
},
{
"scene": "09",
"t0": 14.58,
"t1": 16.18,
"text": "way a mother seal shows a young"
},
{
"scene": "09",
"t0": 16.18,
"t1": 18.05,
"text": "one how to hunt."
},
{
"scene": "09",
"t0": 18.05,
"t1": 19.56,
"text": "Nicklen himself said it felt"
},
{
"scene": "09",
"t0": 19.56,
"t1": 20.67,
"text": "like she had decided he was useless,"
},
{
"scene": "09",
"t0": 20.67,
"t1": 21.78,
"text": "\u2026"
},
{
"scene": "09",
"t0": 21.78,
"t1": 22.86,
"text": "and was trying to keep him alive."
},
{
"scene": "09",
"t0": 22.86,
"t1": 23.94,
"text": "\u2026"
},
{
"scene": "09",
"t0": 23.94,
"t1": 25.6,
"text": "Whatever it was, it shows"
},
{
"scene": "09",
"t0": 25.6,
"t1": 26.62,
"text": "something important about this animal."
},
{
"scene": "09",
"t0": 26.62,
"t1": 27.65,
"text": "\u2026"
},
{
"scene": "09",
"t0": 27.65,
"t1": 29.17,
"text": "It is not a machine."
},
{
"scene": "09",
"t0": 29.17,
"t1": 30.76,
"text": "It makes choices."
},
{
"scene": "09",
"t0": 30.76,
"t1": 32.15,
"text": "And not every choice goes the"
},
{
"scene": "09",
"t0": 32.15,
"t1": 33.41,
"text": "photographer's way."
},
{
"scene": "10",
"t0": 0.0,
"t1": 1.6,
"text": "In 1985,"
},
{
"scene": "10",
"t0": 1.6,
"t1": 3.29,
"text": "a British expedition was following"
},
{
"scene": "10",
"t0": 3.29,
"t1": 5.11,
"text": "the route of Captain Scott,"
},
{
"scene": "10",
"t0": 5.11,
"t1": 6.13,
"text": "the explorer who died in Antarctica"
},
{
"scene": "10",
"t0": 6.13,
"t1": 7.16,
"text": "\u2026"
},
{
"scene": "10",
"t0": 7.16,
"t1": 8.75,
"text": "in 1912."
},
{
"scene": "10",
"t0": 8.75,
"t1": 10.42,
"text": "One of them, Gareth Wood,"
},
{
"scene": "10",
"t0": 10.42,
"t1": 11.99,
"text": "was walking across thin sea"
},
{
"scene": "10",
"t0": 11.99,
"t1": 13.67,
"text": "ice. A leopard seal"
},
{
"scene": "10",
"t0": 13.67,
"t1": 15.43,
"text": "came up through the edge of the ice,"
},
{
"scene": "10",
"t0": 15.43,
"t1": 16.97,
"text": "seized his leg, and began"
},
{
"scene": "10",
"t0": 16.97,
"t1": 17.98,
"text": "to drag him toward the water."
},
{
"scene": "10",
"t0": 17.98,
"t1": 19.0,
"text": "\u2026"
},
{
"scene": "10",
"t0": 19.0,
"t1": 20.65,
"text": "It let go, then bit him"
},
{
"scene": "10",
"t0": 20.65,
"t1": 21.9,
"text": "again."
},
{
"scene": "10",
"t0": 21.9,
"t1": 22.92,
"text": "His companions kicked it in the head,"
},
{
"scene": "10",
"t0": 22.92,
"t1": 23.95,
"text": "\u2026"
},
{
"scene": "10",
"t0": 23.95,
"t1": 25.62,
"text": "again and again, with"
},
{
"scene": "10",
"t0": 25.62,
"t1": 26.66,
"text": "the steel spikes of their crampons,"
},
{
"scene": "10",
"t0": 26.66,
"t1": 27.69,
"text": "\u2026"
},
{
"scene": "10",
"t0": 27.69,
"t1": 28.79,
"text": "until it finally let him go."
},
{
"scene": "10",
"t0": 28.79,
"t1": 29.89,
"text": "\u2026"
},
{
"scene": "10",
"t0": 29.89,
"t1": 31.55,
"text": "He survived, with deep"
},
{
"scene": "10",
"t0": 31.55,
"t1": 33.15,
"text": "wounds in his leg."
},
{
"scene": "10",
"t0": 33.15,
"t1": 34.88,
"text": "For eighty years, the story"
},
{
"scene": "10",
"t0": 34.88,
"t1": 36.07,
"text": "had been the same."
},
{
"scene": "10",
"t0": 36.07,
"t1": 37.25,
"text": "Close calls."
},
{
"scene": "10",
"t0": 37.25,
"t1": 38.49,
"text": "Scares. Lucky escapes."
},
{
"scene": "10",
"t0": 38.49,
"t1": 39.73,
"text": "\u2026"
},
{
"scene": "10",
"t0": 39.73,
"t1": 40.54,
"text": "Then, in"
},
{
"scene": "10",
"t0": 40.54,
"t1": 42.02,
"text": "2003, it"
},
{
"scene": "10",
"t0": 42.02,
"t1": 42.97,
"text": "changed."
},
{
"scene": "11",
"t0": 0.0,
"t1": 1.05,
"text": "Kirsty Brown was twenty-eight,"
},
{
"scene": "11",
"t0": 1.05,
"t1": 2.1,
"text": "\u2026"
},
{
"scene": "11",
"t0": 2.1,
"t1": 3.95,
"text": "a marine biologist with the British"
},
{
"scene": "11",
"t0": 3.95,
"t1": 5.66,
"text": "Antarctic Survey, working"
},
{
"scene": "11",
"t0": 5.66,
"t1": 6.71,
"text": "at Rothera Research Station."
},
{
"scene": "11",
"t0": 6.71,
"t1": 7.75,
"text": "\u2026"
},
{
"scene": "11",
"t0": 7.75,
"t1": 9.19,
"text": "On the twenty-second of July"
},
{
"scene": "11",
"t0": 9.19,
"t1": 10.73,
"text": "2003, she"
},
{
"scene": "11",
"t0": 10.73,
"t1": 12.25,
"text": "went snorkelling in the bay with a"
},
{
"scene": "11",
"t0": 12.25,
"t1": 13.85,
"text": "colleague, part of a survey"
},
{
"scene": "11",
"t0": 13.85,
"t1": 15.55,
"text": "of the sea floor."
},
{
"scene": "11",
"t0": 15.55,
"t1": 17.07,
"text": "A leopard seal that no one had"
},
{
"scene": "11",
"t0": 17.07,
"t1": 18.72,
"text": "seen came up and took hold"
},
{
"scene": "11",
"t0": 18.72,
"t1": 20.32,
"text": "of her. Her partner saw"
},
{
"scene": "11",
"t0": 20.32,
"t1": 21.86,
"text": "her under the water, with the"
},
{
"scene": "11",
"t0": 21.86,
"t1": 23.51,
"text": "seal holding on to her."
},
{
"scene": "11",
"t0": 23.51,
"t1": 24.53,
"text": "The seal let her go near the boat,"
},
{
"scene": "11",
"t0": 24.53,
"t1": 25.55,
"text": "\u2026"
},
{
"scene": "11",
"t0": 25.55,
"t1": 27.06,
"text": "and the team pulled her out"
},
{
"scene": "11",
"t0": 27.06,
"t1": 28.08,
"text": "and tried everything to save her."
},
{
"scene": "11",
"t0": 28.08,
"t1": 29.1,
"text": "\u2026"
},
{
"scene": "11",
"t0": 29.1,
"t1": 30.51,
"text": "She did not survive."
},
{
"scene": "12",
"t0": 0.0,
"t1": 1.49,
"text": "Here is the answer to the second"
},
{
"scene": "12",
"t0": 1.49,
"t1": 2.55,
"text": "question."
},
{
"scene": "12",
"t0": 2.55,
"t1": 4.11,
"text": "Yes, a leopard seal has"
},
{
"scene": "12",
"t0": 4.11,
"t1": 5.34,
"text": "killed a person."
},
{
"scene": "12",
"t0": 5.34,
"t1": 7.08,
"text": "Once. Kirsty Brown's"
},
{
"scene": "12",
"t0": 7.08,
"t1": 8.88,
"text": "death is the only known fatal"
},
{
"scene": "12",
"t0": 8.88,
"t1": 10.42,
"text": "leopard seal attack."
},
{
"scene": "12",
"t0": 10.42,
"t1": 12.24,
"text": "Scientists who studied it found something"
},
{
"scene": "12",
"t0": 12.24,
"t1": 13.46,
"text": "else unusual."
},
{
"scene": "12",
"t0": 13.46,
"t1": 15.29,
"text": "The seal attacked at the surface,"
},
{
"scene": "12",
"t0": 15.29,
"t1": 16.91,
"text": "and nobody had seen it before it"
},
{
"scene": "12",
"t0": 16.91,
"t1": 18.02,
"text": "struck."
},
{
"scene": "12",
"t0": 18.02,
"t1": 19.92,
"text": "Afterwards, the British Antarctic Survey"
},
{
"scene": "12",
"t0": 19.92,
"t1": 21.73,
"text": "brought in new safety rules for diving"
},
{
"scene": "12",
"t0": 21.73,
"t1": 22.9,
"text": "and snorkelling."
},
{
"scene": "12",
"t0": 22.9,
"t1": 24.52,
"text": "And a small island near Rothera"
},
{
"scene": "12",
"t0": 24.52,
"t1": 25.97,
"text": "was named after her."
},
{
"scene": "12",
"t0": 25.97,
"t1": 27.48,
"text": "Kirsty Island."
},
{
"scene": "12",
"t0": 27.48,
"t1": 29.15,
"text": "One death in more than a century of"
},
{
"scene": "12",
"t0": 29.15,
"t1": 30.2,
"text": "people working beside these animals."
},
{
"scene": "12",
"t0": 30.2,
"t1": 31.25,
"text": "\u2026"
},
{
"scene": "12",
"t0": 31.25,
"t1": 32.89,
"text": "But it showed what could happen."
},
{
"scene": "13",
"t0": 0.0,
"t1": 1.93,
"text": "And you do not have to go to Antarctica"
},
{
"scene": "13",
"t0": 1.93,
"t1": 3.1,
"text": "to meet one."
},
{
"scene": "13",
"t0": 3.1,
"t1": 4.62,
"text": "Leopard seals turn up on"
},
{
"scene": "13",
"t0": 4.62,
"t1": 6.01,
"text": "the coasts of New Zealand,"
},
{
"scene": "13",
"t0": 6.01,
"t1": 7.58,
"text": "Australia, South Africa"
},
{
"scene": "13",
"t0": 7.58,
"t1": 9.05,
"text": "and South America."
},
{
"scene": "13",
"t0": 9.05,
"t1": 10.72,
"text": "In New Zealand, one female,"
},
{
"scene": "13",
"t0": 10.72,
"t1": 12.23,
"text": "named Owha, lived for"
},
{
"scene": "13",
"t0": 12.23,
"t1": 14.0,
"text": "years around the marinas and beaches"
},
{
"scene": "13",
"t0": 14.0,
"t1": 15.5,
"text": "of Auckland."
},
{
"scene": "13",
"t0": 15.5,
"t1": 17.02,
"text": "Scientists there have identified"
},
{
"scene": "13",
"t0": 17.02,
"t1": 18.72,
"text": "more than two hundred different leopard"
},
{
"scene": "13",
"t0": 18.72,
"t1": 20.45,
"text": "seals visiting the country,"
},
{
"scene": "13",
"t0": 20.45,
"t1": 21.98,
"text": "and the government now counts them as"
},
{
"scene": "13",
"t0": 21.98,
"t1": 23.02,
"text": "residents, not visitors."
},
{
"scene": "13",
"t0": 23.02,
"t1": 24.07,
"text": "\u2026"
},
{
"scene": "13",
"t0": 24.07,
"t1": 25.69,
"text": "They haul out on boat ramps and"
},
{
"scene": "13",
"t0": 25.69,
"t1": 27.33,
"text": "pontoons, a few metres"
},
{
"scene": "13",
"t0": 27.33,
"t1": 28.38,
"text": "from where people walk their dogs."
},
{
"scene": "13",
"t0": 28.38,
"t1": 29.44,
"text": "\u2026"
},
{
"scene": "13",
"t0": 29.44,
"t1": 30.5,
"text": "Some have even given birth there."
},
{
"scene": "13",
"t0": 30.5,
"t1": 31.56,
"text": "\u2026"
},
{
"scene": "13",
"t0": 31.56,
"t1": 33.09,
"text": "Researchers have recorded leopard"
},
{
"scene": "13",
"t0": 33.09,
"t1": 34.69,
"text": "seal pups born on New Zealand's"
},
{
"scene": "13",
"t0": 34.69,
"t1": 36.19,
"text": "coast. The country has a"
},
{
"scene": "13",
"t0": 36.19,
"t1": 37.74,
"text": "phone line just for leopard seal"
},
{
"scene": "13",
"t0": 37.74,
"t1": 39.4,
"text": "sightings, so scientists"
},
{
"scene": "13",
"t0": 39.4,
"t1": 41.08,
"text": "can track every visitor."
},
{
"scene": "13",
"t0": 41.08,
"t1": 42.69,
"text": "So in some places, the leopard"
},
{
"scene": "13",
"t0": 42.69,
"t1": 44.65,
"text": "seal is not at the end of the world."
},
{
"scene": "13",
"t0": 44.65,
"t1": 46.47,
"text": "It is at the end of the jetty."
},
{
"scene": "14",
"t0": 0.0,
"t1": 1.65,
"text": "Look at what it hunts, and"
},
{
"scene": "14",
"t0": 1.65,
"t1": 3.24,
"text": "you understand why people take it"
},
{
"scene": "14",
"t0": 3.24,
"t1": 4.25,
"text": "seriously."
},
{
"scene": "14",
"t0": 4.25,
"t1": 6.11,
"text": "Krill. Fish."
},
{
"scene": "14",
"t0": 6.11,
"t1": 8.1,
"text": "Squid. Penguins."
},
{
"scene": "14",
"t0": 8.1,
"t1": 9.45,
"text": "And other seals."
},
{
"scene": "14",
"t0": 9.45,
"t1": 11.11,
"text": "Young crabeater seals and fur"
},
{
"scene": "14",
"t0": 11.11,
"t1": 12.62,
"text": "seals, much bigger than"
},
{
"scene": "14",
"t0": 12.62,
"t1": 13.7,
"text": "a penguin."
},
{
"scene": "14",
"t0": 13.7,
"t1": 15.45,
"text": "Up to three in every four crabeater"
},
{
"scene": "14",
"t0": 15.45,
"t1": 16.53,
"text": "seals that survive their first year"
},
{
"scene": "14",
"t0": 16.53,
"t1": 17.61,
"text": "\u2026"
},
{
"scene": "14",
"t0": 17.61,
"t1": 19.16,
"text": "carry scars from leopard seal"
},
{
"scene": "14",
"t0": 19.16,
"t1": 20.42,
"text": "attacks."
},
{
"scene": "14",
"t0": 20.42,
"t1": 21.54,
"text": "Long, parallel wounds,"
},
{
"scene": "14",
"t0": 21.54,
"t1": 22.65,
"text": "\u2026"
},
{
"scene": "14",
"t0": 22.65,
"t1": 23.88,
"text": "from the year they were young enough to catch."
},
{
"scene": "14",
"t0": 23.88,
"t1": 25.12,
"text": "\u2026"
},
{
"scene": "14",
"t0": 25.12,
"t1": 26.8,
"text": "The biggest females take"
},
{
"scene": "14",
"t0": 26.8,
"t1": 28.08,
"text": "the biggest, richest prey."
},
{
"scene": "14",
"t0": 28.08,
"t1": 29.36,
"text": "\u2026"
},
{
"scene": "14",
"t0": 29.36,
"t1": 30.93,
"text": "A leopard seal can live for"
},
{
"scene": "14",
"t0": 30.93,
"t1": 31.98,
"text": "more than twenty-six years."
},
{
"scene": "14",
"t0": 31.98,
"t1": 33.03,
"text": "\u2026"
},
{
"scene": "14",
"t0": 33.03,
"t1": 34.58,
"text": "That is a long time to learn the"
},
{
"scene": "14",
"t0": 34.58,
"t1": 35.66,
"text": "ice edges, the colonies,"
},
{
"scene": "14",
"t0": 35.66,
"t1": 36.73,
"text": "\u2026"
},
{
"scene": "14",
"t0": 36.73,
"t1": 38.36,
"text": "and the places where food comes to"
},
{
"scene": "14",
"t0": 38.36,
"t1": 39.48,
"text": "the water."
},
{
"scene": "14",
"t0": 39.48,
"t1": 40.56,
"text": "And to learn what a human is."
},
{
"scene": "14",
"t0": 40.56,
"t1": 41.64,
"text": "\u2026"
},
{
"scene": "15",
"t0": 0.0,
"t1": 1.55,
"text": "So what really happens"
},
{
"scene": "15",
"t0": 1.55,
"t1": 3.19,
"text": "when a leopard seal decides what"
},
{
"scene": "15",
"t0": 3.19,
"t1": 4.25,
"text": "you are?"
},
{
"scene": "15",
"t0": 4.25,
"t1": 5.94,
"text": "Most of the time, it decides"
},
{
"scene": "15",
"t0": 5.94,
"t1": 7.32,
"text": "you are not food."
},
{
"scene": "15",
"t0": 7.32,
"t1": 8.71,
"text": "It watches you, and it"
},
{
"scene": "15",
"t0": 8.71,
"t1": 9.86,
"text": "leaves."
},
{
"scene": "15",
"t0": 9.86,
"t1": 11.41,
"text": "Sometimes, it decides you"
},
{
"scene": "15",
"t0": 11.41,
"t1": 13.08,
"text": "are something to investigate."
},
{
"scene": "15",
"t0": 13.08,
"t1": 14.67,
"text": "It follows. It tests"
},
{
"scene": "15",
"t0": 14.67,
"t1": 16.22,
"text": "you. It might even bring you"
},
{
"scene": "15",
"t0": 16.22,
"t1": 17.32,
"text": "a penguin."
},
{
"scene": "15",
"t0": 17.32,
"t1": 18.94,
"text": "And very, very rarely,"
},
{
"scene": "15",
"t0": 18.94,
"t1": 20.0,
"text": "it decides you are prey."
},
{
"scene": "15",
"t0": 20.0,
"t1": 21.05,
"text": "\u2026"
},
{
"scene": "15",
"t0": 21.05,
"t1": 22.08,
"text": "Photographers, scientists"
},
{
"scene": "15",
"t0": 22.08,
"t1": 23.1,
"text": "\u2026"
},
{
"scene": "15",
"t0": 23.1,
"t1": 24.6,
"text": "and divers who have spent"
},
{
"scene": "15",
"t0": 24.6,
"t1": 26.14,
"text": "years with them all say"
},
{
"scene": "15",
"t0": 26.14,
"t1": 27.34,
"text": "the same thing."
},
{
"scene": "15",
"t0": 27.34,
"t1": 28.97,
"text": "You cannot always tell which"
},
{
"scene": "15",
"t0": 28.97,
"t1": 30.24,
"text": "seal is which."
},
{
"scene": "15",
"t0": 30.24,
"t1": 31.86,
"text": "The curious one and the"
},
{
"scene": "15",
"t0": 31.86,
"t1": 32.89,
"text": "dangerous one can look exactly"
},
{
"scene": "15",
"t0": 32.89,
"t1": 33.92,
"text": "\u2026"
},
{
"scene": "15",
"t0": 33.92,
"t1": 35.51,
"text": "alike. The problem is"
},
{
"scene": "15",
"t0": 35.51,
"t1": 37.25,
"text": "that from the outside, those"
},
{
"scene": "15",
"t0": 37.25,
"t1": 38.82,
"text": "three look exactly the same at"
},
{
"scene": "15",
"t0": 38.82,
"t1": 40.76,
"text": "first. The same face."
},
{
"scene": "15",
"t0": 40.76,
"t1": 42.08,
"text": "The same smile."
},
{
"scene": "16",
"t0": 0.0,
"t1": 1.55,
"text": "So here is how you stay on the"
},
{
"scene": "16",
"t0": 1.55,
"t1": 3.43,
"text": "right side of that decision."
},
{
"scene": "16",
"t0": 3.43,
"t1": 4.46,
"text": "If a leopard seal is in the water,"
},
{
"scene": "16",
"t0": 4.46,
"t1": 5.49,
"text": "\u2026"
},
{
"scene": "16",
"t0": 5.49,
"t1": 6.95,
"text": "stay out of it."
},
{
"scene": "16",
"t0": 6.95,
"t1": 8.62,
"text": "On land, keep at least"
},
{
"scene": "16",
"t0": 8.62,
"t1": 10.05,
"text": "twenty metres away."
},
{
"scene": "16",
"t0": 10.05,
"t1": 11.09,
"text": "That is the rule in New Zealand."
},
{
"scene": "16",
"t0": 11.09,
"t1": 12.12,
"text": "\u2026"
},
{
"scene": "16",
"t0": 12.12,
"t1": 13.91,
"text": "Never stand between a seal"
},
{
"scene": "16",
"t0": 13.91,
"t1": 15.09,
"text": "and the sea."
},
{
"scene": "16",
"t0": 15.09,
"t1": 16.69,
"text": "That is its way out, and"
},
{
"scene": "16",
"t0": 16.69,
"t1": 18.28,
"text": "you are in the way."
},
{
"scene": "16",
"t0": 18.28,
"t1": 19.89,
"text": "Never feed one, and never"
},
{
"scene": "16",
"t0": 19.89,
"t1": 21.47,
"text": "let a dog near one."
},
{
"scene": "16",
"t0": 21.47,
"t1": 23.25,
"text": "A seal that learns to come close"
},
{
"scene": "16",
"t0": 23.25,
"t1": 24.77,
"text": "to people is a seal that"
},
{
"scene": "16",
"t0": 24.77,
"t1": 25.86,
"text": "will one day get too close."
},
{
"scene": "16",
"t0": 25.86,
"t1": 26.95,
"text": "\u2026"
},
{
"scene": "16",
"t0": 26.95,
"t1": 27.98,
"text": "Be careful at the ice edge."
},
{
"scene": "16",
"t0": 27.98,
"t1": 29.01,
"text": "\u2026"
},
{
"scene": "16",
"t0": 29.01,
"t1": 30.19,
"text": "That is its hunting ground."
},
{
"scene": "16",
"t0": 30.19,
"t1": 31.37,
"text": "\u2026"
},
{
"scene": "16",
"t0": 31.37,
"t1": 32.93,
"text": "And if one comes toward you in the"
},
{
"scene": "16",
"t0": 32.93,
"t1": 34.57,
"text": "water, do not panic"
},
{
"scene": "16",
"t0": 34.57,
"t1": 35.9,
"text": "and do not splash."
},
{
"scene": "16",
"t0": 35.9,
"t1": 37.48,
"text": "Get out, calmly"
},
{
"scene": "16",
"t0": 37.48,
"t1": 38.74,
"text": "and quickly."
},
{
"scene": "16",
"t0": 38.74,
"t1": 40.18,
"text": "It is not a monster."
},
{
"scene": "16",
"t0": 40.18,
"t1": 41.72,
"text": "But it is the top predator"
},
{
"scene": "16",
"t0": 41.72,
"t1": 43.28,
"text": "of its world, and you are"
},
{
"scene": "16",
"t0": 43.28,
"t1": 44.64,
"text": "a visitor in it."
},
{
"scene": "17",
"t0": 0.0,
"t1": 1.7,
"text": "So you stop swimming toward"
},
{
"scene": "17",
"t0": 1.7,
"t1": 3.38,
"text": "it. You turn,"
},
{
"scene": "17",
"t0": 3.38,
"t1": 4.98,
"text": "slowly, and kick for"
},
{
"scene": "17",
"t0": 4.98,
"t1": 6.57,
"text": "the hole in the ice."
},
{
"scene": "17",
"t0": 6.57,
"t1": 8.21,
"text": "One metre. Two."
},
{
"scene": "17",
"t0": 8.21,
"t1": 9.91,
"text": "Your hands find the edge,"
},
{
"scene": "17",
"t0": 9.91,
"t1": 11.41,
"text": "and you pull yourself out onto"
},
{
"scene": "17",
"t0": 11.41,
"t1": 12.42,
"text": "the ice."
},
{
"scene": "17",
"t0": 12.42,
"t1": 14.03,
"text": "Behind you, the water is"
},
{
"scene": "17",
"t0": 14.03,
"t1": 15.65,
"text": "still. Then a"
},
{
"scene": "17",
"t0": 15.65,
"t1": 17.52,
"text": "long head rises,"
},
{
"scene": "17",
"t0": 17.52,
"t1": 18.85,
"text": "just at the edge."
},
{
"scene": "17",
"t0": 18.85,
"t1": 20.18,
"text": "It looks at you."
},
{
"scene": "17",
"t0": 20.18,
"t1": 22.06,
"text": "That wide mouth, curved"
},
{
"scene": "17",
"t0": 22.06,
"t1": 23.56,
"text": "up at the corners."
},
{
"scene": "17",
"t0": 23.56,
"t1": 25.24,
"text": "It is not smiling."
},
{
"scene": "17",
"t0": 25.24,
"t1": 26.68,
"text": "It is deciding."
},
{
"scene": "17",
"t0": 26.68,
"t1": 28.44,
"text": "And today, it decides"
},
{
"scene": "17",
"t0": 28.44,
"t1": 29.62,
"text": "to let you go."
}
]