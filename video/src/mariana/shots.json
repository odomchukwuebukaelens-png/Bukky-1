[
{
"scene": "01",
"t0": 0.0,
"t1": 1.51,
"text": "Somewhere above the Mariana"
},
{
"scene": "01",
"t0": 1.51,
"t1": 3.22,
"text": "Trench, you step off a boat"
},
{
"scene": "01",
"t0": 3.22,
"t1": 4.82,
"text": "and start to sink."
},
{
"scene": "01",
"t0": 4.82,
"t1": 6.48,
"text": "Below your feet there are almost"
},
{
"scene": "01",
"t0": 6.48,
"t1": 8.3,
"text": "eleven kilometres of water."
},
{
"scene": "01",
"t0": 8.3,
"t1": 10.13,
"text": "You could drop Mount Everest in here"
},
{
"scene": "01",
"t0": 10.13,
"t1": 11.65,
"text": "and its peak would still be two"
},
{
"scene": "01",
"t0": 11.65,
"t1": 12.7,
"text": "kilometres under the waves."
},
{
"scene": "01",
"t0": 12.7,
"t1": 13.75,
"text": "\u2026"
},
{
"scene": "01",
"t0": 13.75,
"t1": 15.27,
"text": "On the way down, the light will"
},
{
"scene": "01",
"t0": 15.27,
"t1": 16.84,
"text": "go. The cold will"
},
{
"scene": "01",
"t0": 16.84,
"t1": 17.88,
"text": "come. And the pressure will grow"
},
{
"scene": "01",
"t0": 17.88,
"t1": 18.93,
"text": "\u2026"
},
{
"scene": "01",
"t0": 18.93,
"t1": 20.59,
"text": "until it is more than a thousand"
},
{
"scene": "01",
"t0": 20.59,
"t1": 21.68,
"text": "times what you feel right now."
},
{
"scene": "01",
"t0": 21.68,
"t1": 22.77,
"text": "\u2026"
},
{
"scene": "01",
"t0": 22.77,
"t1": 24.45,
"text": "But you will not be alone."
},
{
"scene": "01",
"t0": 24.45,
"t1": 26.24,
"text": "Every few hundred metres,"
},
{
"scene": "01",
"t0": 26.24,
"t1": 28.02,
"text": "something new is waiting."
},
{
"scene": "01",
"t0": 28.02,
"t1": 29.54,
"text": "Something built to hunt in that"
},
{
"scene": "01",
"t0": 29.54,
"t1": 30.61,
"text": "exact slice of the dark."
},
{
"scene": "01",
"t0": 30.61,
"t1": 31.67,
"text": "\u2026"
},
{
"scene": "01",
"t0": 31.67,
"t1": 33.25,
"text": "So what is waiting between the"
},
{
"scene": "01",
"t0": 33.25,
"t1": 35.2,
"text": "surface and the bottom of the deepest"
},
{
"scene": "01",
"t0": 35.2,
"t1": 36.65,
"text": "place on Earth?"
},
{
"scene": "01",
"t0": 36.65,
"t1": 38.34,
"text": "On the way down, you will meet the"
},
{
"scene": "01",
"t0": 38.34,
"t1": 39.57,
"text": "shark that bit nuclear"
},
{
"scene": "01",
"t0": 39.57,
"t1": 40.77,
"text": "submarines."
},
{
"scene": "01",
"t0": 40.77,
"t1": 42.63,
"text": "You will find the last fish before"
},
{
"scene": "01",
"t0": 42.63,
"t1": 43.85,
"text": "life gives up."
},
{
"scene": "01",
"t0": 43.85,
"t1": 45.41,
"text": "And you will see what was waiting at"
},
{
"scene": "01",
"t0": 45.41,
"t1": 46.78,
"text": "the very bottom."
},
{
"scene": "01",
"t0": 46.78,
"t1": 47.94,
"text": "Let's sink."
},
{
"scene": "02",
"t0": 0.0,
"t1": 1.57,
"text": "The first two hundred metres are"
},
{
"scene": "02",
"t0": 1.57,
"t1": 2.91,
"text": "the sunlit zone."
},
{
"scene": "02",
"t0": 2.91,
"t1": 3.92,
"text": "This is the ocean everyone knows."
},
{
"scene": "02",
"t0": 3.92,
"t1": 4.92,
"text": "\u2026"
},
{
"scene": "02",
"t0": 4.92,
"t1": 6.0,
"text": "Warm, bright and blue."
},
{
"scene": "02",
"t0": 6.0,
"t1": 7.08,
"text": "\u2026"
},
{
"scene": "02",
"t0": 7.08,
"t1": 8.33,
"text": "It looks empty."
},
{
"scene": "02",
"t0": 8.33,
"t1": 10.0,
"text": "Out here, far from any"
},
{
"scene": "02",
"t0": 10.0,
"t1": 11.54,
"text": "coast, there is nowhere to"
},
{
"scene": "02",
"t0": 11.54,
"t1": 13.19,
"text": "hide. No reefs."
},
{
"scene": "02",
"t0": 13.19,
"t1": 14.2,
"text": "No rocks."
},
{
"scene": "02",
"t0": 14.2,
"t1": 15.31,
"text": "No seabed."
},
{
"scene": "02",
"t0": 15.31,
"t1": 16.64,
"text": "Only open water in every direction."
},
{
"scene": "02",
"t0": 16.64,
"t1": 17.97,
"text": "\u2026"
},
{
"scene": "02",
"t0": 17.97,
"t1": 19.56,
"text": "And that is exactly why the"
},
{
"scene": "02",
"t0": 19.56,
"t1": 20.66,
"text": "hunters here are so bold."
},
{
"scene": "02",
"t0": 20.66,
"t1": 21.76,
"text": "\u2026"
},
{
"scene": "02",
"t0": 21.76,
"t1": 23.51,
"text": "Out in the open ocean, food"
},
{
"scene": "02",
"t0": 23.51,
"t1": 24.53,
"text": "is rare."
},
{
"scene": "02",
"t0": 24.53,
"t1": 26.04,
"text": "A predator that waits too long to"
},
{
"scene": "02",
"t0": 26.04,
"t1": 27.13,
"text": "check something out goes hungry."
},
{
"scene": "02",
"t0": 27.13,
"t1": 28.22,
"text": "\u2026"
},
{
"scene": "02",
"t0": 28.22,
"t1": 29.95,
"text": "So the hunters of the open sea"
},
{
"scene": "02",
"t0": 29.95,
"t1": 31.81,
"text": "have learned to come straight to anything"
},
{
"scene": "02",
"t0": 31.81,
"t1": 32.86,
"text": "new. Anything like you."
},
{
"scene": "02",
"t0": 32.86,
"t1": 33.91,
"text": "\u2026"
},
{
"scene": "03",
"t0": 0.0,
"t1": 1.85,
"text": "The first to come is often"
},
{
"scene": "03",
"t0": 1.85,
"t1": 3.09,
"text": "the oceanic whitetip shark."
},
{
"scene": "03",
"t0": 3.09,
"t1": 4.33,
"text": "\u2026"
},
{
"scene": "03",
"t0": 4.33,
"t1": 6.01,
"text": "Long fins, tipped with"
},
{
"scene": "03",
"t0": 6.01,
"t1": 7.74,
"text": "white. A slow,"
},
{
"scene": "03",
"t0": 7.74,
"t1": 8.98,
"text": "confident swim."
},
{
"scene": "03",
"t0": 8.98,
"t1": 10.26,
"text": "It does not rush."
},
{
"scene": "03",
"t0": 10.26,
"t1": 12.25,
"text": "It circles, a little closer"
},
{
"scene": "03",
"t0": 12.25,
"t1": 13.76,
"text": "each time, and bumps"
},
{
"scene": "03",
"t0": 13.76,
"t1": 15.75,
"text": "what it is curious about."
},
{
"scene": "03",
"t0": 15.75,
"t1": 17.71,
"text": "In July 1945,"
},
{
"scene": "03",
"t0": 17.71,
"t1": 19.31,
"text": "in the sea west of here,"
},
{
"scene": "03",
"t0": 19.31,
"t1": 20.6,
"text": "it found a lot of people at once."
},
{
"scene": "03",
"t0": 20.6,
"t1": 21.9,
"text": "\u2026"
},
{
"scene": "03",
"t0": 21.9,
"t1": 23.07,
"text": "The cruiser USS Indianapolis"
},
{
"scene": "03",
"t0": 23.07,
"t1": 24.24,
"text": "\u2026"
},
{
"scene": "03",
"t0": 24.24,
"t1": 25.95,
"text": "had just delivered parts of the first"
},
{
"scene": "03",
"t0": 25.95,
"t1": 27.48,
"text": "atomic bomb to the island of"
},
{
"scene": "03",
"t0": 27.48,
"t1": 29.13,
"text": "Tinian, in the Mariana"
},
{
"scene": "03",
"t0": 29.13,
"t1": 30.18,
"text": "Islands."
},
{
"scene": "03",
"t0": 30.18,
"t1": 31.89,
"text": "On the way back, a Japanese"
},
{
"scene": "03",
"t0": 31.89,
"t1": 33.43,
"text": "submarine hit it with two"
},
{
"scene": "03",
"t0": 33.43,
"t1": 34.66,
"text": "torpedoes."
},
{
"scene": "03",
"t0": 34.66,
"t1": 36.41,
"text": "It sank in about twelve"
},
{
"scene": "03",
"t0": 36.41,
"t1": 37.7,
"text": "minutes."
},
{
"scene": "03",
"t0": 37.7,
"t1": 39.37,
"text": "Around nine hundred men went"
},
{
"scene": "03",
"t0": 39.37,
"t1": 40.57,
"text": "into the water."
},
{
"scene": "03",
"t0": 40.57,
"t1": 42.36,
"text": "Nobody knew they were there."
},
{
"scene": "03",
"t0": 42.36,
"t1": 43.95,
"text": "For four days they floated"
},
{
"scene": "03",
"t0": 43.95,
"t1": 45.59,
"text": "in the open ocean, with"
},
{
"scene": "03",
"t0": 45.59,
"t1": 47.1,
"text": "no food and almost no"
},
{
"scene": "03",
"t0": 47.1,
"t1": 48.78,
"text": "water. And the sharks"
},
{
"scene": "03",
"t0": 48.78,
"t1": 50.58,
"text": "came. Survivors described"
},
{
"scene": "03",
"t0": 50.58,
"t1": 52.08,
"text": "them circling below,"
},
{
"scene": "03",
"t0": 52.08,
"t1": 53.66,
"text": "and taking the men at the edges of"
},
{
"scene": "03",
"t0": 53.66,
"t1": 55.05,
"text": "the groups."
},
{
"scene": "03",
"t0": 55.05,
"t1": 57.0,
"text": "When rescue finally came,"
},
{
"scene": "03",
"t0": 57.0,
"t1": 58.73,
"text": "by accident, three hundred"
},
{
"scene": "03",
"t0": 58.73,
"t1": 59.92,
"text": "and sixteen were still alive."
},
{
"scene": "03",
"t0": 59.92,
"t1": 61.11,
"text": "\u2026"
},
{
"scene": "03",
"t0": 61.11,
"t1": 62.67,
"text": "Most of the men did not die from"
},
{
"scene": "03",
"t0": 62.67,
"t1": 64.26,
"text": "sharks. They died from"
},
{
"scene": "03",
"t0": 64.26,
"t1": 66.06,
"text": "injuries, thirst,"
},
{
"scene": "03",
"t0": 66.06,
"t1": 67.06,
"text": "salt water and the sun."
},
{
"scene": "03",
"t0": 67.06,
"t1": 68.07,
"text": "\u2026"
},
{
"scene": "03",
"t0": 68.07,
"t1": 69.65,
"text": "But for the survivors, the"
},
{
"scene": "03",
"t0": 69.65,
"t1": 70.77,
"text": "sharks were the part they never forgot."
},
{
"scene": "03",
"t0": 70.77,
"t1": 71.89,
"text": "\u2026"
},
{
"scene": "04",
"t0": 0.0,
"t1": 1.93,
"text": "Below two hundred metres,"
},
{
"scene": "04",
"t0": 1.93,
"t1": 3.93,
"text": "you enter the twilight zone."
},
{
"scene": "04",
"t0": 3.93,
"t1": 5.56,
"text": "There is still light here,"
},
{
"scene": "04",
"t0": 5.56,
"t1": 7.01,
"text": "but only a little."
},
{
"scene": "04",
"t0": 7.01,
"t1": 8.52,
"text": "Blue, dim,"
},
{
"scene": "04",
"t0": 8.52,
"t1": 9.71,
"text": "and fading with every metre."
},
{
"scene": "04",
"t0": 9.71,
"t1": 10.9,
"text": "\u2026"
},
{
"scene": "04",
"t0": 10.9,
"t1": 12.59,
"text": "Here, the fast hunters"
},
{
"scene": "04",
"t0": 12.59,
"t1": 14.27,
"text": "have to see in the gloom."
},
{
"scene": "04",
"t0": 14.27,
"t1": 15.31,
"text": "The swordfish has a trick for that."
},
{
"scene": "04",
"t0": 15.31,
"t1": 16.36,
"text": "\u2026"
},
{
"scene": "04",
"t0": 16.36,
"t1": 17.93,
"text": "Behind its eyes is a special"
},
{
"scene": "04",
"t0": 17.93,
"t1": 19.58,
"text": "organ, a kind of heater"
},
{
"scene": "04",
"t0": 19.58,
"t1": 20.83,
"text": "made from muscle."
},
{
"scene": "04",
"t0": 20.83,
"t1": 22.58,
"text": "It warms its eyes and its brain"
},
{
"scene": "04",
"t0": 22.58,
"t1": 24.08,
"text": "to ten or fifteen degrees"
},
{
"scene": "04",
"t0": 24.08,
"t1": 25.18,
"text": "above the cold water around it."
},
{
"scene": "04",
"t0": 25.18,
"t1": 26.28,
"text": "\u2026"
},
{
"scene": "04",
"t0": 26.28,
"t1": 27.37,
"text": "Warm eyes are fast eyes."
},
{
"scene": "04",
"t0": 27.37,
"t1": 28.45,
"text": "\u2026"
},
{
"scene": "04",
"t0": 28.45,
"t1": 30.16,
"text": "In the cold, dark water,"
},
{
"scene": "04",
"t0": 30.16,
"t1": 31.73,
"text": "a swordfish can still follow"
},
{
"scene": "04",
"t0": 31.73,
"t1": 33.38,
"text": "quick, darting prey that"
},
{
"scene": "04",
"t0": 33.38,
"t1": 34.55,
"text": "a cold-eyed fish would lose."
},
{
"scene": "04",
"t0": 34.55,
"t1": 35.71,
"text": "\u2026"
},
{
"scene": "04",
"t0": 35.71,
"t1": 36.84,
"text": "And there is a lot of prey to follow."
},
{
"scene": "04",
"t0": 36.84,
"t1": 37.98,
"text": "\u2026"
},
{
"scene": "04",
"t0": 37.98,
"t1": 39.5,
"text": "Every night, billions of"
},
{
"scene": "04",
"t0": 39.5,
"t1": 41.15,
"text": "small fish, shrimp and"
},
{
"scene": "04",
"t0": 41.15,
"t1": 43.14,
"text": "squid swim up from the twilight"
},
{
"scene": "04",
"t0": 43.14,
"t1": 44.15,
"text": "zone to feed near the surface."
},
{
"scene": "04",
"t0": 44.15,
"t1": 45.16,
"text": "\u2026"
},
{
"scene": "04",
"t0": 45.16,
"t1": 46.77,
"text": "And every morning, they sink"
},
{
"scene": "04",
"t0": 46.77,
"t1": 47.94,
"text": "back down."
},
{
"scene": "04",
"t0": 47.94,
"t1": 49.62,
"text": "It is the largest migration on"
},
{
"scene": "04",
"t0": 49.62,
"t1": 51.42,
"text": "Earth. It happens every"
},
{
"scene": "04",
"t0": 51.42,
"t1": 52.95,
"text": "single day, and almost"
},
{
"scene": "04",
"t0": 52.95,
"t1": 54.57,
"text": "nobody sees it."
},
{
"scene": "05",
"t0": 0.0,
"t1": 1.77,
"text": "Some of those migrating hunters"
},
{
"scene": "05",
"t0": 1.77,
"t1": 3.31,
"text": "are very small, and"
},
{
"scene": "05",
"t0": 3.31,
"t1": 4.74,
"text": "very strange."
},
{
"scene": "05",
"t0": 4.74,
"t1": 6.71,
"text": "This is the cookiecutter shark."
},
{
"scene": "05",
"t0": 6.71,
"t1": 7.73,
"text": "It is about the length of your forearm."
},
{
"scene": "05",
"t0": 7.73,
"t1": 8.76,
"text": "\u2026"
},
{
"scene": "05",
"t0": 8.76,
"t1": 9.81,
"text": "It spends its days deep down,"
},
{
"scene": "05",
"t0": 9.81,
"t1": 10.86,
"text": "\u2026"
},
{
"scene": "05",
"t0": 10.86,
"t1": 12.54,
"text": "and comes up at night."
},
{
"scene": "05",
"t0": 12.54,
"t1": 14.2,
"text": "Its belly glows."
},
{
"scene": "05",
"t0": 14.2,
"t1": 15.75,
"text": "All of it, except for a"
},
{
"scene": "05",
"t0": 15.75,
"t1": 16.79,
"text": "dark band around its throat."
},
{
"scene": "05",
"t0": 16.79,
"t1": 17.83,
"text": "\u2026"
},
{
"scene": "05",
"t0": 17.83,
"t1": 19.72,
"text": "From below, against the faint"
},
{
"scene": "05",
"t0": 19.72,
"t1": 21.41,
"text": "light above, that dark"
},
{
"scene": "05",
"t0": 21.41,
"t1": 22.9,
"text": "band may look like a small"
},
{
"scene": "05",
"t0": 22.9,
"t1": 24.65,
"text": "fish. When a bigger hunter"
},
{
"scene": "05",
"t0": 24.65,
"t1": 26.15,
"text": "comes in to take it, the"
},
{
"scene": "05",
"t0": 26.15,
"t1": 27.27,
"text": "cookiecutter turns the tables."
},
{
"scene": "05",
"t0": 27.27,
"t1": 28.38,
"text": "\u2026"
},
{
"scene": "05",
"t0": 28.38,
"t1": 30.18,
"text": "It latches on with its lips,"
},
{
"scene": "05",
"t0": 30.18,
"t1": 31.93,
"text": "sinks a ring of saw-like teeth"
},
{
"scene": "05",
"t0": 31.93,
"t1": 33.28,
"text": "into the skin, and"
},
{
"scene": "05",
"t0": 33.28,
"t1": 34.93,
"text": "spins. Then it swims"
},
{
"scene": "05",
"t0": 34.93,
"t1": 36.44,
"text": "away with a perfectly round"
},
{
"scene": "05",
"t0": 36.44,
"t1": 37.96,
"text": "plug of flesh."
},
{
"scene": "05",
"t0": 37.96,
"t1": 39.59,
"text": "Tuna, dolphins,"
},
{
"scene": "05",
"t0": 39.59,
"t1": 41.31,
"text": "seals, even great white"
},
{
"scene": "05",
"t0": 41.31,
"t1": 42.51,
"text": "sharks carry those round scars."
},
{
"scene": "05",
"t0": 42.51,
"t1": 43.7,
"text": "\u2026"
},
{
"scene": "05",
"t0": 43.7,
"t1": 45.29,
"text": "And in the 1970s, so did"
},
{
"scene": "05",
"t0": 45.29,
"t1": 47.13,
"text": "the United States Navy."
},
{
"scene": "05",
"t0": 47.13,
"t1": 48.8,
"text": "Submarines in the Pacific came"
},
{
"scene": "05",
"t0": 48.8,
"t1": 50.45,
"text": "home with round bites in the rubber"
},
{
"scene": "05",
"t0": 50.45,
"t1": 51.47,
"text": "covers of their sonar domes."
},
{
"scene": "05",
"t0": 51.47,
"t1": 52.49,
"text": "\u2026"
},
{
"scene": "05",
"t0": 52.49,
"t1": 54.4,
"text": "For a while, nobody could explain"
},
{
"scene": "05",
"t0": 54.4,
"t1": 56.05,
"text": "it. The answer was"
},
{
"scene": "05",
"t0": 56.05,
"t1": 57.58,
"text": "this little shark."
},
{
"scene": "05",
"t0": 57.58,
"t1": 59.06,
"text": "The Navy had to fit tougher"
},
{
"scene": "05",
"t0": 59.06,
"t1": 60.59,
"text": "covers. The shark that"
},
{
"scene": "05",
"t0": 60.59,
"t1": 62.1,
"text": "bit nuclear submarines was"
},
{
"scene": "05",
"t0": 62.1,
"t1": 63.71,
"text": "no longer than your arm."
},
{
"scene": "06",
"t0": 0.0,
"t1": 1.51,
"text": "Deeper still, somewhere"
},
{
"scene": "06",
"t0": 1.51,
"t1": 3.17,
"text": "between five hundred and a thousand"
},
{
"scene": "06",
"t0": 3.17,
"t1": 4.95,
"text": "metres, lives something people"
},
{
"scene": "06",
"t0": 4.95,
"t1": 6.08,
"text": "searched for for more than a century."
},
{
"scene": "06",
"t0": 6.08,
"t1": 7.2,
"text": "\u2026"
},
{
"scene": "06",
"t0": 7.2,
"t1": 8.61,
"text": "The giant squid."
},
{
"scene": "06",
"t0": 8.61,
"t1": 10.27,
"text": "It can be longer than a bus,"
},
{
"scene": "06",
"t0": 10.27,
"t1": 11.8,
"text": "most of that length in two long"
},
{
"scene": "06",
"t0": 11.8,
"t1": 12.95,
"text": "feeding arms."
},
{
"scene": "06",
"t0": 12.95,
"t1": 14.59,
"text": "And it has the biggest eyes of any"
},
{
"scene": "06",
"t0": 14.59,
"t1": 16.22,
"text": "animal alive, each one"
},
{
"scene": "06",
"t0": 16.22,
"t1": 18.15,
"text": "about the size of a dinner plate."
},
{
"scene": "06",
"t0": 18.15,
"t1": 19.86,
"text": "For most of history, nobody"
},
{
"scene": "06",
"t0": 19.86,
"t1": 21.49,
"text": "had ever seen one alive."
},
{
"scene": "06",
"t0": 21.49,
"t1": 22.96,
"text": "Only dead ones washed up on"
},
{
"scene": "06",
"t0": 22.96,
"t1": 24.12,
"text": "beaches."
},
{
"scene": "06",
"t0": 24.12,
"t1": 24.83,
"text": "Then, in"
},
{
"scene": "06",
"t0": 24.83,
"t1": 26.33,
"text": "2004, a"
},
{
"scene": "06",
"t0": 26.33,
"t1": 28.02,
"text": "Japanese team led by Tsunemi"
},
{
"scene": "06",
"t0": 28.02,
"t1": 29.77,
"text": "Kubodera lowered a camera"
},
{
"scene": "06",
"t0": 29.77,
"t1": 31.42,
"text": "on a line, nine hundred"
},
{
"scene": "06",
"t0": 31.42,
"t1": 33.1,
"text": "metres down off the Ogasawara"
},
{
"scene": "06",
"t0": 33.1,
"t1": 34.7,
"text": "Islands, on the same chain"
},
{
"scene": "06",
"t0": 34.7,
"t1": 35.78,
"text": "of islands as the Marianas."
},
{
"scene": "06",
"t0": 35.78,
"t1": 36.85,
"text": "\u2026"
},
{
"scene": "06",
"t0": 36.85,
"t1": 38.41,
"text": "A giant squid came to"
},
{
"scene": "06",
"t0": 38.41,
"t1": 39.55,
"text": "the bait."
},
{
"scene": "06",
"t0": 39.55,
"t1": 40.74,
"text": "The camera photographed it attacking,"
},
{
"scene": "06",
"t0": 40.74,
"t1": 41.93,
"text": "\u2026"
},
{
"scene": "06",
"t0": 41.93,
"t1": 42.96,
"text": "wrapping its arms around the line,"
},
{
"scene": "06",
"t0": 42.96,
"t1": 43.99,
"text": "\u2026"
},
{
"scene": "06",
"t0": 43.99,
"t1": 45.24,
"text": "and pulling."
},
{
"scene": "06",
"t0": 45.24,
"t1": 46.83,
"text": "It fought for hours before it"
},
{
"scene": "06",
"t0": 46.83,
"t1": 48.4,
"text": "tore free and left one"
},
{
"scene": "06",
"t0": 48.4,
"t1": 50.08,
"text": "of its arms behind."
},
{
"scene": "06",
"t0": 50.08,
"t1": 51.91,
"text": "The first photos of a living giant"
},
{
"scene": "06",
"t0": 51.91,
"t1": 53.49,
"text": "squid in the wild came"
},
{
"scene": "06",
"t0": 53.49,
"t1": 54.53,
"text": "from the edge of this very ocean."
},
{
"scene": "06",
"t0": 54.53,
"t1": 55.56,
"text": "\u2026"
},
{
"scene": "07",
"t0": 0.0,
"t1": 1.7,
"text": "But even a giant has something"
},
{
"scene": "07",
"t0": 1.7,
"t1": 3.19,
"text": "to be afraid of."
},
{
"scene": "07",
"t0": 3.19,
"t1": 4.75,
"text": "Down here, in water"
},
{
"scene": "07",
"t0": 4.75,
"t1": 6.32,
"text": "with almost no light,"
},
{
"scene": "07",
"t0": 6.32,
"t1": 8.12,
"text": "the sperm whale hunts."
},
{
"scene": "07",
"t0": 8.12,
"t1": 9.71,
"text": "It holds its breath, and"
},
{
"scene": "07",
"t0": 9.71,
"t1": 10.73,
"text": "dives more than a kilometre down,"
},
{
"scene": "07",
"t0": 10.73,
"t1": 11.75,
"text": "\u2026"
},
{
"scene": "07",
"t0": 11.75,
"t1": 13.42,
"text": "for close to an hour."
},
{
"scene": "07",
"t0": 13.42,
"t1": 14.95,
"text": "It does not need light."
},
{
"scene": "07",
"t0": 14.95,
"t1": 16.54,
"text": "Its huge, square head is"
},
{
"scene": "07",
"t0": 16.54,
"t1": 18.15,
"text": "mostly a sound machine."
},
{
"scene": "07",
"t0": 18.15,
"t1": 19.65,
"text": "It sends out clicks,"
},
{
"scene": "07",
"t0": 19.65,
"t1": 21.26,
"text": "some of the loudest sounds made by"
},
{
"scene": "07",
"t0": 21.26,
"t1": 22.78,
"text": "any animal, and listens"
},
{
"scene": "07",
"t0": 22.78,
"t1": 24.55,
"text": "for the echoes coming back from squid"
},
{
"scene": "07",
"t0": 24.55,
"t1": 25.74,
"text": "in the dark."
},
{
"scene": "07",
"t0": 25.74,
"t1": 27.32,
"text": "Sperm whales eat squid by"
},
{
"scene": "07",
"t0": 27.32,
"t1": 28.43,
"text": "the thousands."
},
{
"scene": "07",
"t0": 28.43,
"t1": 30.14,
"text": "Inside their stomachs, scientists"
},
{
"scene": "07",
"t0": 30.14,
"t1": 31.34,
"text": "have found the beaks of giant squid."
},
{
"scene": "07",
"t0": 31.34,
"t1": 32.53,
"text": "\u2026"
},
{
"scene": "07",
"t0": 32.53,
"t1": 34.35,
"text": "And on their skin, they sometimes"
},
{
"scene": "07",
"t0": 34.35,
"t1": 35.96,
"text": "carry round scars from squid"
},
{
"scene": "07",
"t0": 35.96,
"t1": 37.48,
"text": "suckers. Marks of"
},
{
"scene": "07",
"t0": 37.48,
"t1": 39.31,
"text": "fights nobody has ever seen."
},
{
"scene": "08",
"t0": 0.0,
"t1": 1.55,
"text": "At one thousand metres,"
},
{
"scene": "08",
"t0": 1.55,
"t1": 3.13,
"text": "the sunlight is gone."
},
{
"scene": "08",
"t0": 3.13,
"t1": 4.16,
"text": "All of it."
},
{
"scene": "08",
"t0": 4.16,
"t1": 5.72,
"text": "From here to the bottom, it is"
},
{
"scene": "08",
"t0": 5.72,
"t1": 7.08,
"text": "the midnight zone."
},
{
"scene": "08",
"t0": 7.08,
"t1": 8.09,
"text": "Total darkness, forever."
},
{
"scene": "08",
"t0": 8.09,
"t1": 9.11,
"text": "\u2026"
},
{
"scene": "08",
"t0": 9.11,
"t1": 11.01,
"text": "The only light is the light that animals"
},
{
"scene": "08",
"t0": 11.01,
"t1": 12.26,
"text": "make themselves."
},
{
"scene": "08",
"t0": 12.26,
"t1": 13.82,
"text": "And down here, light is"
},
{
"scene": "08",
"t0": 13.82,
"t1": 14.95,
"text": "a weapon."
},
{
"scene": "08",
"t0": 14.95,
"t1": 16.55,
"text": "The anglerfish carries"
},
{
"scene": "08",
"t0": 16.55,
"t1": 18.35,
"text": "a glowing lure on a rod"
},
{
"scene": "08",
"t0": 18.35,
"t1": 19.91,
"text": "growing from its head."
},
{
"scene": "08",
"t0": 19.91,
"t1": 21.47,
"text": "Small animals swim toward"
},
{
"scene": "08",
"t0": 21.47,
"t1": 23.05,
"text": "the light, thinking it is"
},
{
"scene": "08",
"t0": 23.05,
"t1": 24.55,
"text": "food. Then the mouth"
},
{
"scene": "08",
"t0": 24.55,
"t1": 25.62,
"text": "opens."
},
{
"scene": "08",
"t0": 25.62,
"t1": 27.25,
"text": "The viperfish has teeth"
},
{
"scene": "08",
"t0": 27.25,
"t1": 28.85,
"text": "so long that they do not"
},
{
"scene": "08",
"t0": 28.85,
"t1": 30.08,
"text": "fit inside its mouth when it closes."
},
{
"scene": "08",
"t0": 30.08,
"t1": 31.3,
"text": "\u2026"
},
{
"scene": "08",
"t0": 31.3,
"t1": 33.06,
"text": "The fangtooth, a fish"
},
{
"scene": "08",
"t0": 33.06,
"t1": 34.71,
"text": "no bigger than your hand, has"
},
{
"scene": "08",
"t0": 34.71,
"t1": 36.25,
"text": "some of the largest teeth for its"
},
{
"scene": "08",
"t0": 36.25,
"t1": 37.45,
"text": "body of any fish in the sea."
},
{
"scene": "08",
"t0": 37.45,
"t1": 38.65,
"text": "\u2026"
},
{
"scene": "08",
"t0": 38.65,
"t1": 40.24,
"text": "Food is rare down here,"
},
{
"scene": "08",
"t0": 40.24,
"t1": 41.93,
"text": "so these hunters cannot afford"
},
{
"scene": "08",
"t0": 41.93,
"t1": 42.95,
"text": "to miss. Big mouths."
},
{
"scene": "08",
"t0": 42.95,
"t1": 43.97,
"text": "\u2026"
},
{
"scene": "08",
"t0": 43.97,
"t1": 45.13,
"text": "Long teeth."
},
{
"scene": "08",
"t0": 45.13,
"t1": 46.53,
"text": "Stretchy stomachs."
},
{
"scene": "08",
"t0": 46.53,
"t1": 47.55,
"text": "Whatever they catch, they keep."
},
{
"scene": "08",
"t0": 47.55,
"t1": 48.56,
"text": "\u2026"
},
{
"scene": "09",
"t0": 0.0,
"t1": 1.65,
"text": "Most animals in the deep make"
},
{
"scene": "09",
"t0": 1.65,
"t1": 3.23,
"text": "blue light, and almost all"
},
{
"scene": "09",
"t0": 3.23,
"t1": 5.09,
"text": "of them can only see blue."
},
{
"scene": "09",
"t0": 5.09,
"t1": 6.6,
"text": "The stoplight loosejaw,"
},
{
"scene": "09",
"t0": 6.6,
"t1": 8.37,
"text": "a kind of dragonfish, breaks"
},
{
"scene": "09",
"t0": 8.37,
"t1": 9.47,
"text": "that rule."
},
{
"scene": "09",
"t0": 9.47,
"t1": 11.44,
"text": "Under its eye it has a second light,"
},
{
"scene": "09",
"t0": 11.44,
"t1": 12.88,
"text": "and that one is red."
},
{
"scene": "09",
"t0": 12.88,
"t1": 14.52,
"text": "Almost nothing in the deep can see"
},
{
"scene": "09",
"t0": 14.52,
"t1": 16.02,
"text": "red. To the shrimp and"
},
{
"scene": "09",
"t0": 16.02,
"t1": 17.63,
"text": "fish around it, that beam"
},
{
"scene": "09",
"t0": 17.63,
"t1": 19.5,
"text": "is completely invisible."
},
{
"scene": "09",
"t0": 19.5,
"t1": 21.46,
"text": "But the loosejaw can see it."
},
{
"scene": "09",
"t0": 21.46,
"t1": 23.05,
"text": "Its eyes use a pigment made"
},
{
"scene": "09",
"t0": 23.05,
"t1": 24.73,
"text": "from chlorophyll, likely"
},
{
"scene": "09",
"t0": 24.73,
"t1": 26.36,
"text": "taken from the tiny animals it"
},
{
"scene": "09",
"t0": 26.36,
"t1": 27.92,
"text": "eats. So it swims"
},
{
"scene": "09",
"t0": 27.92,
"t1": 29.75,
"text": "through the dark with its own secret"
},
{
"scene": "09",
"t0": 29.75,
"t1": 31.45,
"text": "searchlight, seeing its"
},
{
"scene": "09",
"t0": 31.45,
"t1": 33.23,
"text": "prey while its prey sees"
},
{
"scene": "09",
"t0": 33.23,
"t1": 33.91,
"text": "nothing."
},
{
"scene": "10",
"t0": 0.0,
"t1": 1.65,
"text": "But one mammal comes down even"
},
{
"scene": "10",
"t0": 1.65,
"t1": 2.75,
"text": "further. In"
},
{
"scene": "10",
"t0": 2.75,
"t1": 4.52,
"text": "2014, scientists"
},
{
"scene": "10",
"t0": 4.52,
"t1": 6.14,
"text": "published what tags on Cuvier's"
},
{
"scene": "10",
"t0": 6.14,
"t1": 7.73,
"text": "beaked whales had recorded off"
},
{
"scene": "10",
"t0": 7.73,
"t1": 8.74,
"text": "California."
},
{
"scene": "10",
"t0": 8.74,
"t1": 10.34,
"text": "One whale dived to almost"
},
{
"scene": "10",
"t0": 10.34,
"t1": 11.87,
"text": "three thousand metres."
},
{
"scene": "10",
"t0": 11.87,
"t1": 13.6,
"text": "Another stayed under for more than two"
},
{
"scene": "10",
"t0": 13.6,
"t1": 14.73,
"text": "hours on a single breath."
},
{
"scene": "10",
"t0": 14.73,
"t1": 15.86,
"text": "\u2026"
},
{
"scene": "10",
"t0": 15.86,
"t1": 17.33,
"text": "No mammal has been recorded"
},
{
"scene": "10",
"t0": 17.33,
"t1": 18.9,
"text": "deeper. These whales"
},
{
"scene": "10",
"t0": 18.9,
"t1": 20.51,
"text": "come down here to hunt squid and"
},
{
"scene": "10",
"t0": 20.51,
"t1": 22.31,
"text": "fish in the dark, then climb"
},
{
"scene": "10",
"t0": 22.31,
"t1": 24.22,
"text": "all the way back up to breathe."
},
{
"scene": "10",
"t0": 24.22,
"t1": 26.09,
"text": "At three thousand metres, though,"
},
{
"scene": "10",
"t0": 26.09,
"t1": 27.84,
"text": "even they turn around."
},
{
"scene": "10",
"t0": 27.84,
"t1": 29.15,
"text": "You keep sinking."
},
{
"scene": "11",
"t0": 0.0,
"t1": 1.78,
"text": "Past four thousand metres"
},
{
"scene": "11",
"t0": 1.78,
"t1": 3.07,
"text": "is the abyss."
},
{
"scene": "11",
"t0": 3.07,
"t1": 4.55,
"text": "The water is just above"
},
{
"scene": "11",
"t0": 4.55,
"t1": 6.28,
"text": "freezing. The pressure is"
},
{
"scene": "11",
"t0": 6.28,
"t1": 7.81,
"text": "four hundred times what it is at"
},
{
"scene": "11",
"t0": 7.81,
"t1": 8.98,
"text": "the surface."
},
{
"scene": "11",
"t0": 8.98,
"t1": 10.79,
"text": "And food is so rare"
},
{
"scene": "11",
"t0": 10.79,
"t1": 12.31,
"text": "that most animals here"
},
{
"scene": "11",
"t0": 12.31,
"t1": 13.35,
"text": "live on what falls from above."
},
{
"scene": "11",
"t0": 13.35,
"t1": 14.38,
"text": "\u2026"
},
{
"scene": "11",
"t0": 14.38,
"t1": 16.02,
"text": "A steady snow of dead"
},
{
"scene": "11",
"t0": 16.02,
"t1": 17.74,
"text": "plankton, called marine"
},
{
"scene": "11",
"t0": 17.74,
"t1": 18.75,
"text": "snow."
},
{
"scene": "11",
"t0": 18.75,
"t1": 20.32,
"text": "So the hunters of the abyss are"
},
{
"scene": "11",
"t0": 20.32,
"t1": 21.34,
"text": "patient."
},
{
"scene": "11",
"t0": 21.34,
"t1": 22.77,
"text": "Long, slow fish called"
},
{
"scene": "11",
"t0": 22.77,
"t1": 24.38,
"text": "rattails cruise just above"
},
{
"scene": "11",
"t0": 24.38,
"t1": 26.17,
"text": "the mud, waiting for the smell"
},
{
"scene": "11",
"t0": 26.17,
"t1": 27.2,
"text": "of anything dead or dying."
},
{
"scene": "11",
"t0": 27.2,
"t1": 28.22,
"text": "\u2026"
},
{
"scene": "11",
"t0": 28.22,
"t1": 30.1,
"text": "When a whale dies and sinks,"
},
{
"scene": "11",
"t0": 30.1,
"t1": 31.82,
"text": "it is a feast that can last for"
},
{
"scene": "11",
"t0": 31.82,
"t1": 33.23,
"text": "years. Sleeper"
},
{
"scene": "11",
"t0": 33.23,
"t1": 34.93,
"text": "sharks, hagfish and"
},
{
"scene": "11",
"t0": 34.93,
"t1": 36.55,
"text": "crabs arrive from far"
},
{
"scene": "11",
"t0": 36.55,
"t1": 38.26,
"text": "away, following the smell"
},
{
"scene": "11",
"t0": 38.26,
"t1": 39.91,
"text": "down through the dark."
},
{
"scene": "11",
"t0": 39.91,
"t1": 41.52,
"text": "Then, just past six"
},
{
"scene": "11",
"t0": 41.52,
"t1": 43.35,
"text": "thousand metres, the seabed"
},
{
"scene": "11",
"t0": 43.35,
"t1": 45.05,
"text": "drops away under you."
},
{
"scene": "11",
"t0": 45.05,
"t1": 46.5,
"text": "This is the trench."
},
{
"scene": "12",
"t0": 0.0,
"t1": 1.64,
"text": "Below six thousand metres"
},
{
"scene": "12",
"t0": 1.64,
"t1": 3.31,
"text": "is the hadal zone, named"
},
{
"scene": "12",
"t0": 3.31,
"t1": 4.89,
"text": "after Hades, the Greek"
},
{
"scene": "12",
"t0": 4.89,
"t1": 6.44,
"text": "world of the dead."
},
{
"scene": "12",
"t0": 6.44,
"t1": 8.02,
"text": "It is not dead."
},
{
"scene": "12",
"t0": 8.02,
"t1": 9.79,
"text": "Lower a piece of bait to the bottom"
},
{
"scene": "12",
"t0": 9.79,
"t1": 11.42,
"text": "here, and in minutes it is"
},
{
"scene": "12",
"t0": 11.42,
"t1": 13.25,
"text": "covered in amphipods."
},
{
"scene": "12",
"t0": 13.25,
"t1": 14.64,
"text": "Pale, shrimp-like"
},
{
"scene": "12",
"t0": 14.64,
"t1": 16.3,
"text": "scavengers, swarming"
},
{
"scene": "12",
"t0": 16.3,
"t1": 17.84,
"text": "in their thousands."
},
{
"scene": "12",
"t0": 17.84,
"t1": 19.26,
"text": "Most are small."
},
{
"scene": "12",
"t0": 19.26,
"t1": 20.8,
"text": "Some deep-sea amphipods grow"
},
{
"scene": "12",
"t0": 20.8,
"t1": 22.33,
"text": "longer than your hand."
},
{
"scene": "12",
"t0": 22.33,
"t1": 24.29,
"text": "They find food by smell."
},
{
"scene": "12",
"t0": 24.29,
"t1": 25.37,
"text": "In a place where nothing falls often,"
},
{
"scene": "12",
"t0": 25.37,
"t1": 26.45,
"text": "\u2026"
},
{
"scene": "12",
"t0": 26.45,
"t1": 27.48,
"text": "they cannot afford to be slow."
},
{
"scene": "12",
"t0": 27.48,
"t1": 28.5,
"text": "\u2026"
},
{
"scene": "12",
"t0": 28.5,
"t1": 30.47,
"text": "And where there is a swarm of food,"
},
{
"scene": "12",
"t0": 30.47,
"t1": 31.71,
"text": "there is a hunter."
},
{
"scene": "13",
"t0": 0.0,
"t1": 1.36,
"text": "At around eight thousand"
},
{
"scene": "13",
"t0": 1.36,
"t1": 2.98,
"text": "metres, you meet the last"
},
{
"scene": "13",
"t0": 2.98,
"t1": 4.5,
"text": "fish. It is not a"
},
{
"scene": "13",
"t0": 4.5,
"t1": 6.44,
"text": "monster. It is the Mariana"
},
{
"scene": "13",
"t0": 6.44,
"t1": 7.5,
"text": "snailfish."
},
{
"scene": "13",
"t0": 7.5,
"t1": 9.4,
"text": "Small, pink,"
},
{
"scene": "13",
"t0": 9.4,
"t1": 10.46,
"text": "soft, and almost see-through."
},
{
"scene": "13",
"t0": 10.46,
"t1": 11.53,
"text": "\u2026"
},
{
"scene": "13",
"t0": 11.53,
"t1": 13.13,
"text": "It looks like a tadpole that has been"
},
{
"scene": "13",
"t0": 13.13,
"t1": 14.26,
"text": "left in water too long."
},
{
"scene": "13",
"t0": 14.26,
"t1": 15.38,
"text": "\u2026"
},
{
"scene": "13",
"t0": 15.38,
"t1": 16.9,
"text": "But down here, it is the"
},
{
"scene": "13",
"t0": 16.9,
"t1": 18.29,
"text": "top predator."
},
{
"scene": "13",
"t0": 18.29,
"t1": 19.75,
"text": "It hovers over the amphipod"
},
{
"scene": "13",
"t0": 19.75,
"t1": 21.28,
"text": "swarms and sucks them"
},
{
"scene": "13",
"t0": 21.28,
"t1": 22.34,
"text": "in. In"
},
{
"scene": "13",
"t0": 22.34,
"t1": 23.95,
"text": "2017, a"
},
{
"scene": "13",
"t0": 23.95,
"t1": 24.98,
"text": "snailfish in the Mariana Trench"
},
{
"scene": "13",
"t0": 24.98,
"t1": 26.02,
"text": "\u2026"
},
{
"scene": "13",
"t0": 26.02,
"t1": 27.59,
"text": "was filmed at eight thousand one"
},
{
"scene": "13",
"t0": 27.59,
"t1": 29.58,
"text": "hundred and seventy-eight metres,"
},
{
"scene": "13",
"t0": 29.58,
"t1": 31.15,
"text": "a record at the time."
},
{
"scene": "13",
"t0": 31.15,
"t1": 32.89,
"text": "In 2023, another"
},
{
"scene": "13",
"t0": 32.89,
"t1": 34.64,
"text": "snailfish was filmed at eight thousand"
},
{
"scene": "13",
"t0": 34.64,
"t1": 36.61,
"text": "three hundred and thirty-six metres,"
},
{
"scene": "13",
"t0": 36.61,
"t1": 37.66,
"text": "in a trench just to the north."
},
{
"scene": "13",
"t0": 37.66,
"t1": 38.72,
"text": "\u2026"
},
{
"scene": "13",
"t0": 38.72,
"t1": 40.39,
"text": "It is the deepest fish ever"
},
{
"scene": "13",
"t0": 40.39,
"t1": 41.4,
"text": "filmed."
},
{
"scene": "13",
"t0": 41.4,
"t1": 42.94,
"text": "And it may be about as deep as a"
},
{
"scene": "13",
"t0": 42.94,
"t1": 44.53,
"text": "fish can go."
},
{
"scene": "13",
"t0": 44.53,
"t1": 45.58,
"text": "Fish protect their bodies from pressure"
},
{
"scene": "13",
"t0": 45.58,
"t1": 46.63,
"text": "\u2026"
},
{
"scene": "13",
"t0": 46.63,
"t1": 47.8,
"text": "with a molecule called TMAO."
},
{
"scene": "13",
"t0": 47.8,
"t1": 48.97,
"text": "\u2026"
},
{
"scene": "13",
"t0": 48.97,
"t1": 50.48,
"text": "The deeper they live,"
},
{
"scene": "13",
"t0": 50.48,
"t1": 52.3,
"text": "the more they need."
},
{
"scene": "13",
"t0": 52.3,
"t1": 54.14,
"text": "Scientists have calculated that,"
},
{
"scene": "13",
"t0": 54.14,
"t1": 55.87,
"text": "at around eight thousand two hundred"
},
{
"scene": "13",
"t0": 55.87,
"t1": 56.96,
"text": "to eight thousand four hundred metres,"
},
{
"scene": "13",
"t0": 56.96,
"t1": 58.05,
"text": "\u2026"
},
{
"scene": "13",
"t0": 58.05,
"t1": 59.86,
"text": "a fish would need so much of it"
},
{
"scene": "13",
"t0": 59.86,
"t1": 61.5,
"text": "that water would start flooding into"
},
{
"scene": "13",
"t0": 61.5,
"t1": 62.77,
"text": "its body."
},
{
"scene": "13",
"t0": 62.77,
"t1": 64.45,
"text": "So, around eight and a half"
},
{
"scene": "13",
"t0": 64.45,
"t1": 66.15,
"text": "kilometres down, the fish"
},
{
"scene": "13",
"t0": 66.15,
"t1": 66.72,
"text": "stop."
},
{
"scene": "14",
"t0": 0.0,
"t1": 1.78,
"text": "But the trench keeps going."
},
{
"scene": "14",
"t0": 1.78,
"t1": 3.32,
"text": "Two and a half more kilometres of"
},
{
"scene": "14",
"t0": 3.32,
"t1": 4.96,
"text": "water. Down here,"
},
{
"scene": "14",
"t0": 4.96,
"t1": 6.79,
"text": "the pressure is like the weight of a small"
},
{
"scene": "14",
"t0": 6.79,
"t1": 7.9,
"text": "car pressing on every fingertip."
},
{
"scene": "14",
"t0": 7.9,
"t1": 9.02,
"text": "\u2026"
},
{
"scene": "14",
"t0": 9.02,
"t1": 10.26,
"text": "There are no fish."
},
{
"scene": "14",
"t0": 10.26,
"t1": 11.94,
"text": "But there is still life."
},
{
"scene": "14",
"t0": 11.94,
"t1": 13.57,
"text": "Amphipods have been collected from"
},
{
"scene": "14",
"t0": 13.57,
"t1": 14.66,
"text": "the very bottom of the deepest point."
},
{
"scene": "14",
"t0": 14.66,
"t1": 15.76,
"text": "\u2026"
},
{
"scene": "14",
"t0": 15.76,
"t1": 17.53,
"text": "Sea cucumbers, worms,"
},
{
"scene": "14",
"t0": 17.53,
"t1": 19.05,
"text": "and single-celled giants the"
},
{
"scene": "14",
"t0": 19.05,
"t1": 20.58,
"text": "size of a fist live in the"
},
{
"scene": "14",
"t0": 20.58,
"t1": 22.29,
"text": "mud. They do not hunt"
},
{
"scene": "14",
"t0": 22.29,
"t1": 23.32,
"text": "in any way you would recognise."
},
{
"scene": "14",
"t0": 23.32,
"t1": 24.35,
"text": "\u2026"
},
{
"scene": "14",
"t0": 24.35,
"t1": 25.48,
"text": "But they eat, and they survive,"
},
{
"scene": "14",
"t0": 25.48,
"t1": 26.62,
"text": "\u2026"
},
{
"scene": "14",
"t0": 26.62,
"t1": 28.34,
"text": "in a place where almost nothing"
},
{
"scene": "14",
"t0": 28.34,
"t1": 29.1,
"text": "should."
},
{
"scene": "15",
"t0": 0.0,
"t1": 1.85,
"text": "The first people to see this place"
},
{
"scene": "15",
"t0": 1.85,
"t1": 2.43,
"text": "came down in"
},
{
"scene": "15",
"t0": 2.43,
"t1": 3.88,
"text": "1960."
},
{
"scene": "15",
"t0": 3.88,
"t1": 5.47,
"text": "Jacques Piccard and Don Walsh"
},
{
"scene": "15",
"t0": 5.47,
"t1": 7.07,
"text": "rode the bathyscaphe Trieste"
},
{
"scene": "15",
"t0": 7.07,
"t1": 8.96,
"text": "to the bottom of the Challenger Deep,"
},
{
"scene": "15",
"t0": 8.96,
"t1": 10.02,
"text": "the deepest point of the trench."
},
{
"scene": "15",
"t0": 10.02,
"t1": 11.07,
"text": "\u2026"
},
{
"scene": "15",
"t0": 11.07,
"t1": 12.67,
"text": "It took them almost five hours"
},
{
"scene": "15",
"t0": 12.67,
"t1": 13.74,
"text": "to sink."
},
{
"scene": "15",
"t0": 13.74,
"t1": 15.27,
"text": "When they landed, Piccard"
},
{
"scene": "15",
"t0": 15.27,
"t1": 17.16,
"text": "reported seeing a flat fish,"
},
{
"scene": "15",
"t0": 17.16,
"t1": 18.32,
"text": "like a sole, on the bottom."
},
{
"scene": "15",
"t0": 18.32,
"t1": 19.49,
"text": "\u2026"
},
{
"scene": "15",
"t0": 19.49,
"t1": 21.07,
"text": "It became one of the most famous"
},
{
"scene": "15",
"t0": 21.07,
"t1": 23.05,
"text": "sightings in the history of the deep."
},
{
"scene": "15",
"t0": 23.05,
"t1": 24.64,
"text": "But fish are not thought to be able to"
},
{
"scene": "15",
"t0": 24.64,
"t1": 26.32,
"text": "live that deep, and the window was"
},
{
"scene": "15",
"t0": 26.32,
"t1": 27.92,
"text": "clouded with mud stirred up"
},
{
"scene": "15",
"t0": 27.92,
"t1": 29.15,
"text": "by the landing."
},
{
"scene": "15",
"t0": 29.15,
"t1": 30.7,
"text": "Walsh later said they might have been"
},
{
"scene": "15",
"t0": 30.7,
"t1": 32.7,
"text": "mistaken. Whatever they saw,"
},
{
"scene": "15",
"t0": 32.7,
"t1": 33.8,
"text": "it was almost certainly not a fish."
},
{
"scene": "15",
"t0": 33.8,
"t1": 34.9,
"text": "\u2026"
},
{
"scene": "16",
"t0": 0.0,
"t1": 1.63,
"text": "So what is waiting at the very"
},
{
"scene": "16",
"t0": 1.63,
"t1": 3.2,
"text": "bottom of the deepest place on"
},
{
"scene": "16",
"t0": 3.2,
"t1": 5.01,
"text": "Earth? Mud."
},
{
"scene": "16",
"t0": 5.01,
"t1": 6.67,
"text": "Cold, soft, grey"
},
{
"scene": "16",
"t0": 6.67,
"t1": 8.25,
"text": "mud. Water just above"
},
{
"scene": "16",
"t0": 8.25,
"t1": 10.12,
"text": "freezing. And complete darkness"
},
{
"scene": "16",
"t0": 10.12,
"t1": 11.32,
"text": "that has lasted for millions of years."
},
{
"scene": "16",
"t0": 11.32,
"t1": 12.52,
"text": "\u2026"
},
{
"scene": "16",
"t0": 12.52,
"t1": 14.12,
"text": "And in 1998, a"
},
{
"scene": "16",
"t0": 14.12,
"t1": 15.71,
"text": "Japanese robot sub filmed"
},
{
"scene": "16",
"t0": 15.71,
"t1": 17.63,
"text": "something else lying on the seabed,"
},
{
"scene": "16",
"t0": 17.63,
"t1": 18.64,
"text": "at ten thousand eight hundred and ninety-eight"
},
{
"scene": "16",
"t0": 18.64,
"t1": 19.65,
"text": "\u2026"
},
{
"scene": "16",
"t0": 19.65,
"t1": 20.84,
"text": "metres."
},
{
"scene": "16",
"t0": 20.84,
"t1": 22.7,
"text": "A plastic shopping bag."
},
{
"scene": "16",
"t0": 22.7,
"t1": 24.53,
"text": "It is the deepest piece of plastic"
},
{
"scene": "16",
"t0": 24.53,
"t1": 25.83,
"text": "ever recorded."
},
{
"scene": "16",
"t0": 25.83,
"t1": 27.33,
"text": "Scientists found it while going"
},
{
"scene": "16",
"t0": 27.33,
"t1": 28.97,
"text": "through thirty years of deep-sea"
},
{
"scene": "16",
"t0": 28.97,
"t1": 30.75,
"text": "video. It was there before"
},
{
"scene": "16",
"t0": 30.75,
"t1": 31.95,
"text": "most of the people watching this were born."
},
{
"scene": "16",
"t0": 31.95,
"t1": 33.15,
"text": "\u2026"
},
{
"scene": "16",
"t0": 33.15,
"t1": 35.11,
"text": "We have sent more people into space"
},
{
"scene": "16",
"t0": 35.11,
"t1": 37.01,
"text": "than to the bottom of this trench."
},
{
"scene": "16",
"t0": 37.01,
"t1": 38.07,
"text": "But our rubbish got there first."
},
{
"scene": "16",
"t0": 38.07,
"t1": 39.13,
"text": "\u2026"
},
{
"scene": "17",
"t0": 0.0,
"t1": 1.56,
"text": "So here is everything waiting on"
},
{
"scene": "17",
"t0": 1.56,
"t1": 2.77,
"text": "the way down."
},
{
"scene": "17",
"t0": 2.77,
"t1": 4.45,
"text": "At the surface, the sharks"
},
{
"scene": "17",
"t0": 4.45,
"t1": 5.47,
"text": "that come straight to anything new."
},
{
"scene": "17",
"t0": 5.47,
"t1": 6.5,
"text": "\u2026"
},
{
"scene": "17",
"t0": 6.5,
"t1": 8.3,
"text": "In the twilight, the swordfish"
},
{
"scene": "17",
"t0": 8.3,
"t1": 10.05,
"text": "with warm eyes, and the little"
},
{
"scene": "17",
"t0": 10.05,
"t1": 11.21,
"text": "shark that bit submarines."
},
{
"scene": "17",
"t0": 11.21,
"t1": 12.38,
"text": "\u2026"
},
{
"scene": "17",
"t0": 12.38,
"t1": 13.88,
"text": "In the dark, the giant"
},
{
"scene": "17",
"t0": 13.88,
"t1": 15.43,
"text": "squid, and the whale that"
},
{
"scene": "17",
"t0": 15.43,
"t1": 17.11,
"text": "hunts it with sound."
},
{
"scene": "17",
"t0": 17.11,
"t1": 18.65,
"text": "In the midnight zone,"
},
{
"scene": "17",
"t0": 18.65,
"t1": 20.15,
"text": "lures, invisible"
},
{
"scene": "17",
"t0": 20.15,
"t1": 21.6,
"text": "light and teeth too long to"
},
{
"scene": "17",
"t0": 21.6,
"t1": 22.69,
"text": "close."
},
{
"scene": "17",
"t0": 22.69,
"t1": 24.36,
"text": "In the abyss, the patient"
},
{
"scene": "17",
"t0": 24.36,
"t1": 25.66,
"text": "hunters that wait for food to fall."
},
{
"scene": "17",
"t0": 25.66,
"t1": 26.97,
"text": "\u2026"
},
{
"scene": "17",
"t0": 26.97,
"t1": 28.02,
"text": "And at the bottom of the hunting world,"
},
{
"scene": "17",
"t0": 28.02,
"t1": 29.08,
"text": "\u2026"
},
{
"scene": "17",
"t0": 29.08,
"t1": 30.72,
"text": "eight kilometres down,"
},
{
"scene": "17",
"t0": 30.72,
"t1": 32.46,
"text": "a small pink fish that rules"
},
{
"scene": "17",
"t0": 32.46,
"t1": 34.1,
"text": "a kingdom of shrimp."
},
{
"scene": "17",
"t0": 34.1,
"t1": 35.23,
"text": "Below it, no more fish."
},
{
"scene": "17",
"t0": 35.23,
"t1": 36.37,
"text": "\u2026"
},
{
"scene": "17",
"t0": 36.37,
"t1": 37.38,
"text": "Only mud, darkness,"
},
{
"scene": "17",
"t0": 37.38,
"t1": 38.39,
"text": "\u2026"
},
{
"scene": "17",
"t0": 38.39,
"t1": 40.26,
"text": "and one plastic bag."
},
{
"scene": "17",
"t0": 40.26,
"t1": 42.05,
"text": "The deeper you go, the smaller"
},
{
"scene": "17",
"t0": 42.05,
"t1": 43.33,
"text": "the hunters get."
},
{
"scene": "17",
"t0": 43.33,
"t1": 45.32,
"text": "But they never stop hunting."
}
]