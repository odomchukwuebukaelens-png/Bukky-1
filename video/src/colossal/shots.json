[
{
"scene": "01",
"t0": 0.0,
"t1": 1.15,
"text": "On the ninth of March,"
},
{
"scene": "01",
"t0": 1.15,
"t1": 3.01,
"text": "2025, a robot"
},
{
"scene": "01",
"t0": 3.01,
"t1": 4.61,
"text": "was exploring the dark sea"
},
{
"scene": "01",
"t0": 4.61,
"t1": 6.28,
"text": "off the South Sandwich Islands,"
},
{
"scene": "01",
"t0": 6.28,
"t1": 7.75,
"text": "near Antarctica."
},
{
"scene": "01",
"t0": 7.75,
"t1": 9.56,
"text": "About six hundred metres down,"
},
{
"scene": "01",
"t0": 9.56,
"t1": 11.3,
"text": "its lights picked out something small"
},
{
"scene": "01",
"t0": 11.3,
"t1": 12.56,
"text": "and glassy."
},
{
"scene": "01",
"t0": 12.56,
"t1": 14.23,
"text": "A young squid, about thirty"
},
{
"scene": "01",
"t0": 14.23,
"t1": 15.88,
"text": "centimetres long, almost"
},
{
"scene": "01",
"t0": 15.88,
"t1": 17.61,
"text": "completely see-through."
},
{
"scene": "01",
"t0": 17.61,
"t1": 19.25,
"text": "The scientists watching on the ship did"
},
{
"scene": "01",
"t0": 19.25,
"t1": 20.32,
"text": "not know it yet."
},
{
"scene": "01",
"t0": 20.32,
"t1": 22.0,
"text": "The pictures were being streamed live"
},
{
"scene": "01",
"t0": 22.0,
"t1": 23.8,
"text": "on the internet, and almost nobody"
},
{
"scene": "01",
"t0": 23.8,
"t1": 25.76,
"text": "watching knew what they were seeing either."
},
{
"scene": "01",
"t0": 25.76,
"t1": 27.57,
"text": "But they had just made history."
},
{
"scene": "01",
"t0": 27.57,
"t1": 29.32,
"text": "It was a colossal squid."
},
{
"scene": "01",
"t0": 29.32,
"t1": 30.35,
"text": "The heaviest invertebrate on Earth."
},
{
"scene": "01",
"t0": 30.35,
"t1": 31.38,
"text": "\u2026"
},
{
"scene": "01",
"t0": 31.38,
"t1": 32.98,
"text": "An animal that can grow to around"
},
{
"scene": "01",
"t0": 32.98,
"t1": 34.03,
"text": "five hundred kilograms."
},
{
"scene": "01",
"t0": 34.03,
"t1": 35.08,
"text": "\u2026"
},
{
"scene": "01",
"t0": 35.08,
"t1": 36.62,
"text": "And it was the first time anyone"
},
{
"scene": "01",
"t0": 36.62,
"t1": 38.22,
"text": "had ever seen one alive,"
},
{
"scene": "01",
"t0": 38.22,
"t1": 39.54,
"text": "in its home."
},
{
"scene": "01",
"t0": 39.54,
"t1": 41.12,
"text": "It took a hundred years to get"
},
{
"scene": "01",
"t0": 41.12,
"t1": 42.86,
"text": "here. So what kind of animal"
},
{
"scene": "01",
"t0": 42.86,
"t1": 44.8,
"text": "hides from us for a century?"
},
{
"scene": "01",
"t0": 44.8,
"t1": 46.31,
"text": "In this video, you will see"
},
{
"scene": "01",
"t0": 46.31,
"t1": 48.31,
"text": "the biggest eye of any animal,"
},
{
"scene": "01",
"t0": 48.31,
"t1": 49.4,
"text": "the hooks that swivel on its arms,"
},
{
"scene": "01",
"t0": 49.4,
"t1": 50.49,
"text": "\u2026"
},
{
"scene": "01",
"t0": 50.49,
"t1": 52.15,
"text": "and why its brain has a hole through"
},
{
"scene": "01",
"t0": 52.15,
"t1": 52.85,
"text": "the middle."
},
{
"scene": "02",
"t0": 0.0,
"t1": 1.8,
"text": "The colossal squid was first named"
},
{
"scene": "02",
"t0": 1.8,
"t1": 3.45,
"text": "in 1925."
},
{
"scene": "02",
"t0": 3.45,
"t1": 4.88,
"text": "Not from a living animal."
},
{
"scene": "02",
"t0": 4.88,
"t1": 6.41,
"text": "From two pieces of arm,"
},
{
"scene": "02",
"t0": 6.41,
"t1": 8.12,
"text": "found inside the stomach of a sperm"
},
{
"scene": "02",
"t0": 8.12,
"t1": 9.79,
"text": "whale. For decades after"
},
{
"scene": "02",
"t0": 9.79,
"t1": 11.29,
"text": "that, almost everything"
},
{
"scene": "02",
"t0": 11.29,
"t1": 13.05,
"text": "we knew about it came from inside"
},
{
"scene": "02",
"t0": 13.05,
"t1": 14.64,
"text": "whales. Hard,"
},
{
"scene": "02",
"t0": 14.64,
"t1": 16.18,
"text": "parrot-like beaks, the"
},
{
"scene": "02",
"t0": 16.18,
"t1": 17.65,
"text": "one part of a squid that does not"
},
{
"scene": "02",
"t0": 17.65,
"t1": 19.25,
"text": "digest, piled up in"
},
{
"scene": "02",
"t0": 19.25,
"t1": 20.56,
"text": "sperm whale stomachs by the thousand."
},
{
"scene": "02",
"t0": 20.56,
"t1": 21.87,
"text": "\u2026"
},
{
"scene": "02",
"t0": 21.87,
"t1": 23.52,
"text": "From those beaks, scientists"
},
{
"scene": "02",
"t0": 23.52,
"t1": 25.27,
"text": "could tell that something very big"
},
{
"scene": "02",
"t0": 25.27,
"t1": 27.12,
"text": "was living in the Southern Ocean."
},
{
"scene": "02",
"t0": 27.12,
"t1": 28.71,
"text": "And that sperm whales were eating"
},
{
"scene": "02",
"t0": 28.71,
"t1": 30.02,
"text": "a lot of it."
},
{
"scene": "02",
"t0": 30.02,
"t1": 31.55,
"text": "Colossal squid beaks are"
},
{
"scene": "02",
"t0": 31.55,
"t1": 33.43,
"text": "the biggest beaks of any squid"
},
{
"scene": "02",
"t0": 33.43,
"t1": 34.73,
"text": "ever found."
},
{
"scene": "02",
"t0": 34.73,
"t1": 36.32,
"text": "But nobody had seen one"
},
{
"scene": "02",
"t0": 36.32,
"t1": 37.07,
"text": "whole."
},
{
"scene": "03",
"t0": 0.0,
"t1": 1.45,
"text": "Then, in February"
},
{
"scene": "03",
"t0": 1.45,
"t1": 3.02,
"text": "2007, a New"
},
{
"scene": "03",
"t0": 3.02,
"t1": 4.55,
"text": "Zealand fishing boat called the"
},
{
"scene": "03",
"t0": 4.55,
"t1": 6.06,
"text": "San Aspiring was hauling"
},
{
"scene": "03",
"t0": 6.06,
"t1": 7.67,
"text": "longlines in the Ross Sea,"
},
{
"scene": "03",
"t0": 7.67,
"t1": 9.18,
"text": "off Antarctica."
},
{
"scene": "03",
"t0": 9.18,
"t1": 10.24,
"text": "The crew were catching toothfish,"
},
{
"scene": "03",
"t0": 10.24,
"t1": 11.3,
"text": "\u2026"
},
{
"scene": "03",
"t0": 11.3,
"t1": 12.94,
"text": "big deep-sea fish."
},
{
"scene": "03",
"t0": 12.94,
"t1": 14.51,
"text": "And one of them was being eaten as"
},
{
"scene": "03",
"t0": 14.51,
"t1": 16.13,
"text": "it came up. By a colossal"
},
{
"scene": "03",
"t0": 16.13,
"t1": 17.17,
"text": "squid that would not let go."
},
{
"scene": "03",
"t0": 17.17,
"t1": 18.21,
"text": "\u2026"
},
{
"scene": "03",
"t0": 18.21,
"t1": 19.8,
"text": "The squid was too big to lift"
},
{
"scene": "03",
"t0": 19.8,
"t1": 21.11,
"text": "with nets alone."
},
{
"scene": "03",
"t0": 21.11,
"t1": 22.72,
"text": "The crew wrapped it, hauled"
},
{
"scene": "03",
"t0": 22.72,
"t1": 23.91,
"text": "it aboard, and froze it."
},
{
"scene": "03",
"t0": 23.91,
"t1": 25.1,
"text": "\u2026"
},
{
"scene": "03",
"t0": 25.1,
"t1": 27.02,
"text": "Back in New Zealand, at the museum"
},
{
"scene": "03",
"t0": 27.02,
"t1": 28.68,
"text": "Te Papa, scientists"
},
{
"scene": "03",
"t0": 28.68,
"t1": 29.7,
"text": "thawed it and weighed it."
},
{
"scene": "03",
"t0": 29.7,
"t1": 30.72,
"text": "\u2026"
},
{
"scene": "03",
"t0": 30.72,
"t1": 31.84,
"text": "It stayed frozen for more than a year."
},
{
"scene": "03",
"t0": 31.84,
"t1": 32.95,
"text": "\u2026"
},
{
"scene": "03",
"t0": 32.95,
"t1": 34.58,
"text": "When it was finally thawed,"
},
{
"scene": "03",
"t0": 34.58,
"t1": 36.17,
"text": "in 2008, the"
},
{
"scene": "03",
"t0": 36.17,
"t1": 37.79,
"text": "museum streamed the whole thing"
},
{
"scene": "03",
"t0": 37.79,
"t1": 39.39,
"text": "online, and people around"
},
{
"scene": "03",
"t0": 39.39,
"t1": 41.19,
"text": "the world watched a colossal squid"
},
{
"scene": "03",
"t0": 41.19,
"t1": 43.05,
"text": "slowly soften in a tank."
},
{
"scene": "03",
"t0": 43.05,
"t1": 44.54,
"text": "Four hundred and ninety-five"
},
{
"scene": "03",
"t0": 44.54,
"t1": 45.6,
"text": "kilograms."
},
{
"scene": "03",
"t0": 45.6,
"t1": 46.67,
"text": "About as heavy as a grand piano."
},
{
"scene": "03",
"t0": 46.67,
"t1": 47.74,
"text": "\u2026"
},
{
"scene": "03",
"t0": 47.74,
"t1": 49.21,
"text": "The largest invertebrate ever"
},
{
"scene": "03",
"t0": 49.21,
"t1": 50.0,
"text": "recorded."
},
{
"scene": "04",
"t0": 0.0,
"t1": 1.14,
"text": "You may have heard of the giant squid."
},
{
"scene": "04",
"t0": 1.14,
"t1": 2.27,
"text": "\u2026"
},
{
"scene": "04",
"t0": 2.27,
"t1": 3.41,
"text": "The colossal squid is a different animal."
},
{
"scene": "04",
"t0": 3.41,
"t1": 4.54,
"text": "\u2026"
},
{
"scene": "04",
"t0": 4.54,
"t1": 6.27,
"text": "The giant squid is longer."
},
{
"scene": "04",
"t0": 6.27,
"t1": 7.8,
"text": "With its two feeding tentacles"
},
{
"scene": "04",
"t0": 7.8,
"t1": 9.42,
"text": "stretched out, it can reach"
},
{
"scene": "04",
"t0": 9.42,
"t1": 11.02,
"text": "around twelve metres."
},
{
"scene": "04",
"t0": 11.02,
"t1": 12.55,
"text": "But much of that length is thin"
},
{
"scene": "04",
"t0": 12.55,
"t1": 13.8,
"text": "tentacle."
},
{
"scene": "04",
"t0": 13.8,
"t1": 15.6,
"text": "The colossal squid is shorter,"
},
{
"scene": "04",
"t0": 15.6,
"t1": 17.06,
"text": "but far bulkier."
},
{
"scene": "04",
"t0": 17.06,
"t1": 18.88,
"text": "Its body, the mantle,"
},
{
"scene": "04",
"t0": 18.88,
"t1": 20.34,
"text": "is thick and heavy."
},
{
"scene": "04",
"t0": 20.34,
"t1": 22.15,
"text": "It weighs much more than any giant"
},
{
"scene": "04",
"t0": 22.15,
"t1": 23.73,
"text": "squid ever measured."
},
{
"scene": "04",
"t0": 23.73,
"t1": 25.49,
"text": "The giant squid lives in oceans"
},
{
"scene": "04",
"t0": 25.49,
"t1": 26.91,
"text": "all over the world."
},
{
"scene": "04",
"t0": 26.91,
"t1": 28.53,
"text": "The colossal squid lives only"
},
{
"scene": "04",
"t0": 28.53,
"t1": 30.11,
"text": "around Antarctica, in some"
},
{
"scene": "04",
"t0": 30.11,
"t1": 31.21,
"text": "of the coldest water on the planet."
},
{
"scene": "04",
"t0": 31.21,
"t1": 32.31,
"text": "\u2026"
},
{
"scene": "04",
"t0": 32.31,
"t1": 33.95,
"text": "And it has a few weapons the giant"
},
{
"scene": "04",
"t0": 33.95,
"t1": 35.3,
"text": "squid does not."
},
{
"scene": "04",
"t0": 35.3,
"t1": 37.05,
"text": "The giant squid's suckers are ringed"
},
{
"scene": "04",
"t0": 37.05,
"t1": 38.35,
"text": "with small teeth."
},
{
"scene": "04",
"t0": 38.35,
"t1": 39.85,
"text": "The colossal squid has those"
},
{
"scene": "04",
"t0": 39.85,
"t1": 41.44,
"text": "too. But it also has"
},
{
"scene": "04",
"t0": 41.44,
"t1": 42.32,
"text": "hooks."
},
{
"scene": "05",
"t0": 0.0,
"t1": 1.79,
"text": "Let us go through it, piece"
},
{
"scene": "05",
"t0": 1.79,
"t1": 2.94,
"text": "by piece."
},
{
"scene": "05",
"t0": 2.94,
"t1": 4.44,
"text": "At the back is the mantle,"
},
{
"scene": "05",
"t0": 4.44,
"t1": 5.99,
"text": "a big muscular tube."
},
{
"scene": "05",
"t0": 5.99,
"t1": 7.59,
"text": "In the 2007 animal,"
},
{
"scene": "05",
"t0": 7.59,
"t1": 9.16,
"text": "the mantle alone was about two and"
},
{
"scene": "05",
"t0": 9.16,
"t1": 10.57,
"text": "a half metres long."
},
{
"scene": "05",
"t0": 10.57,
"t1": 11.69,
"text": "Inside it are the squid's organs."
},
{
"scene": "05",
"t0": 11.69,
"t1": 12.81,
"text": "\u2026"
},
{
"scene": "05",
"t0": 12.81,
"t1": 14.43,
"text": "When it squeezes the mantle,"
},
{
"scene": "05",
"t0": 14.43,
"t1": 16.02,
"text": "water shoots out of a funnel,"
},
{
"scene": "05",
"t0": 16.02,
"t1": 17.05,
"text": "and the squid jets backwards."
},
{
"scene": "05",
"t0": 17.05,
"t1": 18.07,
"text": "\u2026"
},
{
"scene": "05",
"t0": 18.07,
"t1": 19.19,
"text": "On the mantle are two broad fins,"
},
{
"scene": "05",
"t0": 19.19,
"t1": 20.31,
"text": "\u2026"
},
{
"scene": "05",
"t0": 20.31,
"t1": 21.48,
"text": "for slow, gentle swimming."
},
{
"scene": "05",
"t0": 21.48,
"t1": 22.64,
"text": "\u2026"
},
{
"scene": "05",
"t0": 22.64,
"t1": 23.7,
"text": "At the front are eight arms,"
},
{
"scene": "05",
"t0": 23.7,
"t1": 24.76,
"text": "\u2026"
},
{
"scene": "05",
"t0": 24.76,
"t1": 26.54,
"text": "and two longer tentacles,"
},
{
"scene": "05",
"t0": 26.54,
"t1": 28.18,
"text": "for grabbing prey."
},
{
"scene": "05",
"t0": 28.18,
"t1": 29.8,
"text": "In the middle of all those arms is the"
},
{
"scene": "05",
"t0": 29.8,
"t1": 30.84,
"text": "mouth. And beside the head,"
},
{
"scene": "05",
"t0": 30.84,
"t1": 31.87,
"text": "\u2026"
},
{
"scene": "05",
"t0": 31.87,
"t1": 33.32,
"text": "two eyes."
},
{
"scene": "05",
"t0": 33.32,
"t1": 34.88,
"text": "Each part of this animal is built"
},
{
"scene": "05",
"t0": 34.88,
"t1": 36.13,
"text": "for one thing."
},
{
"scene": "05",
"t0": 36.13,
"t1": 37.25,
"text": "Hunting in near-freezing darkness,"
},
{
"scene": "05",
"t0": 37.25,
"t1": 38.36,
"text": "\u2026"
},
{
"scene": "05",
"t0": 38.36,
"t1": 40.28,
"text": "deep below the Southern Ocean."
},
{
"scene": "06",
"t0": 0.0,
"t1": 1.69,
"text": "Start with the eye."
},
{
"scene": "06",
"t0": 1.69,
"t1": 3.2,
"text": "The colossal squid caught in"
},
{
"scene": "06",
"t0": 3.2,
"t1": 4.7,
"text": "2007 had"
},
{
"scene": "06",
"t0": 4.7,
"t1": 6.66,
"text": "eyes about twenty-seven centimetres"
},
{
"scene": "06",
"t0": 6.66,
"t1": 8.36,
"text": "across. Bigger than a dinner"
},
{
"scene": "06",
"t0": 8.36,
"t1": 9.45,
"text": "plate. In"
},
{
"scene": "06",
"t0": 9.45,
"t1": 11.15,
"text": "2014, another"
},
{
"scene": "06",
"t0": 11.15,
"t1": 12.77,
"text": "colossal squid was examined in"
},
{
"scene": "06",
"t0": 12.77,
"t1": 13.82,
"text": "New Zealand."
},
{
"scene": "06",
"t0": 13.82,
"t1": 15.44,
"text": "Its eyes were measured at around"
},
{
"scene": "06",
"t0": 15.44,
"t1": 16.6,
"text": "thirty-five centimetres."
},
{
"scene": "06",
"t0": 16.6,
"t1": 17.76,
"text": "\u2026"
},
{
"scene": "06",
"t0": 17.76,
"t1": 19.43,
"text": "These are the biggest eyes"
},
{
"scene": "06",
"t0": 19.43,
"t1": 20.49,
"text": "known in the animal kingdom."
},
{
"scene": "06",
"t0": 20.49,
"t1": 21.56,
"text": "\u2026"
},
{
"scene": "06",
"t0": 21.56,
"t1": 23.28,
"text": "Why would an animal need eyes"
},
{
"scene": "06",
"t0": 23.28,
"t1": 25.28,
"text": "that big, where there is almost"
},
{
"scene": "06",
"t0": 25.28,
"t1": 26.71,
"text": "no light?"
},
{
"scene": "06",
"t0": 26.71,
"t1": 28.25,
"text": "One idea is that giant"
},
{
"scene": "06",
"t0": 28.25,
"t1": 30.09,
"text": "eyes are not for spotting small"
},
{
"scene": "06",
"t0": 30.09,
"t1": 31.77,
"text": "prey. They are for spotting"
},
{
"scene": "06",
"t0": 31.77,
"t1": 33.32,
"text": "something huge, from"
},
{
"scene": "06",
"t0": 33.32,
"t1": 34.4,
"text": "far away."
},
{
"scene": "06",
"t0": 34.4,
"t1": 35.91,
"text": "When a sperm whale dives through"
},
{
"scene": "06",
"t0": 35.91,
"t1": 37.47,
"text": "the dark, it disturbs"
},
{
"scene": "06",
"t0": 37.47,
"t1": 38.55,
"text": "tiny glowing creatures in the water,"
},
{
"scene": "06",
"t0": 38.55,
"t1": 39.63,
"text": "\u2026"
},
{
"scene": "06",
"t0": 39.63,
"t1": 40.78,
"text": "and leaves a faint trail of light."
},
{
"scene": "06",
"t0": 40.78,
"t1": 41.94,
"text": "\u2026"
},
{
"scene": "06",
"t0": 41.94,
"t1": 43.63,
"text": "A squid with giant eyes may"
},
{
"scene": "06",
"t0": 43.63,
"t1": 45.22,
"text": "see that trail coming, and"
},
{
"scene": "06",
"t0": 45.22,
"t1": 46.36,
"text": "have a little more time to escape."
},
{
"scene": "06",
"t0": 46.36,
"t1": 47.49,
"text": "\u2026"
},
{
"scene": "06",
"t0": 47.49,
"t1": 49.13,
"text": "In 2012, a team"
},
{
"scene": "06",
"t0": 49.13,
"t1": 50.91,
"text": "of scientists calculated what"
},
{
"scene": "06",
"t0": 50.91,
"t1": 52.58,
"text": "eyes this big could do."
},
{
"scene": "06",
"t0": 52.58,
"t1": 54.25,
"text": "In the deep sea, they could pick"
},
{
"scene": "06",
"t0": 54.25,
"t1": 55.9,
"text": "out the glow around a large animal"
},
{
"scene": "06",
"t0": 55.9,
"t1": 57.44,
"text": "like a sperm whale from more than"
},
{
"scene": "06",
"t0": 57.44,
"t1": 59.0,
"text": "a hundred metres away."
},
{
"scene": "06",
"t0": 59.0,
"t1": 60.58,
"text": "Smaller eyes would see it much"
},
{
"scene": "06",
"t0": 60.58,
"t1": 62.28,
"text": "later. Too late."
},
{
"scene": "07",
"t0": 0.0,
"t1": 1.05,
"text": "Next, the arms."
},
{
"scene": "07",
"t0": 1.05,
"t1": 2.1,
"text": "\u2026"
},
{
"scene": "07",
"t0": 2.1,
"t1": 3.74,
"text": "Most squid have suckers,"
},
{
"scene": "07",
"t0": 3.74,
"t1": 5.66,
"text": "rimmed with tiny teeth."
},
{
"scene": "07",
"t0": 5.66,
"t1": 7.16,
"text": "The colossal squid has something"
},
{
"scene": "07",
"t0": 7.16,
"t1": 9.04,
"text": "extra. Its eight arms"
},
{
"scene": "07",
"t0": 9.04,
"t1": 10.12,
"text": "carry suckers and sharp hooks."
},
{
"scene": "07",
"t0": 10.12,
"t1": 11.2,
"text": "\u2026"
},
{
"scene": "07",
"t0": 11.2,
"t1": 12.22,
"text": "And at the ends of its two long tentacles"
},
{
"scene": "07",
"t0": 12.22,
"t1": 13.25,
"text": "\u2026"
},
{
"scene": "07",
"t0": 13.25,
"t1": 15.19,
"text": "are hooks that can swivel."
},
{
"scene": "07",
"t0": 15.19,
"t1": 16.94,
"text": "When the tentacles grab a fish,"
},
{
"scene": "07",
"t0": 16.94,
"t1": 17.96,
"text": "the hooks turn and dig in."
},
{
"scene": "07",
"t0": 17.96,
"t1": 18.98,
"text": "\u2026"
},
{
"scene": "07",
"t0": 18.98,
"t1": 20.73,
"text": "The harder the prey struggles,"
},
{
"scene": "07",
"t0": 20.73,
"t1": 22.46,
"text": "the deeper they go."
},
{
"scene": "07",
"t0": 22.46,
"t1": 24.3,
"text": "Some sperm whales carry round"
},
{
"scene": "07",
"t0": 24.3,
"t1": 25.88,
"text": "scars and long scratches"
},
{
"scene": "07",
"t0": 25.88,
"t1": 27.61,
"text": "on their skin, from squid"
},
{
"scene": "07",
"t0": 27.61,
"t1": 29.35,
"text": "fighting back in the dark."
},
{
"scene": "07",
"t0": 29.35,
"t1": 31.03,
"text": "The colossal squid's hooks are"
},
{
"scene": "07",
"t0": 31.03,
"t1": 32.79,
"text": "part of how we know it does not go"
},
{
"scene": "07",
"t0": 32.79,
"t1": 33.67,
"text": "quietly."
},
{
"scene": "08",
"t0": 0.0,
"t1": 1.57,
"text": "Inside the ring of arms"
},
{
"scene": "08",
"t0": 1.57,
"t1": 2.8,
"text": "is the beak."
},
{
"scene": "08",
"t0": 2.8,
"t1": 4.69,
"text": "It looks like a parrot's beak."
},
{
"scene": "08",
"t0": 4.69,
"t1": 6.35,
"text": "It is hard and sharp,"
},
{
"scene": "08",
"t0": 6.35,
"t1": 8.1,
"text": "and it is the only truly hard"
},
{
"scene": "08",
"t0": 8.1,
"t1": 9.91,
"text": "part of the squid's body."
},
{
"scene": "08",
"t0": 9.91,
"t1": 11.54,
"text": "The beak cuts prey into small"
},
{
"scene": "08",
"t0": 11.54,
"t1": 13.17,
"text": "pieces. Then a tongue"
},
{
"scene": "08",
"t0": 13.17,
"t1": 14.83,
"text": "covered in tiny teeth,"
},
{
"scene": "08",
"t0": 14.83,
"t1": 16.37,
"text": "called a radula, pulls"
},
{
"scene": "08",
"t0": 16.37,
"t1": 17.68,
"text": "those pieces in."
},
{
"scene": "08",
"t0": 17.68,
"t1": 19.29,
"text": "And there is a very good reason the"
},
{
"scene": "08",
"t0": 19.29,
"t1": 20.9,
"text": "pieces have to be small."
},
{
"scene": "09",
"t0": 0.0,
"t1": 1.5,
"text": "The colossal squid's brain"
},
{
"scene": "09",
"t0": 1.5,
"t1": 3.45,
"text": "is shaped like a doughnut."
},
{
"scene": "09",
"t0": 3.45,
"t1": 5.01,
"text": "And running straight through the hole in"
},
{
"scene": "09",
"t0": 5.01,
"t1": 6.15,
"text": "the middle is its oesophagus,"
},
{
"scene": "09",
"t0": 6.15,
"t1": 7.3,
"text": "\u2026"
},
{
"scene": "09",
"t0": 7.3,
"t1": 8.85,
"text": "the tube that carries food to"
},
{
"scene": "09",
"t0": 8.85,
"t1": 10.05,
"text": "the stomach."
},
{
"scene": "09",
"t0": 10.05,
"t1": 11.65,
"text": "Every bite it swallows passes"
},
{
"scene": "09",
"t0": 11.65,
"t1": 13.47,
"text": "through the middle of its brain."
},
{
"scene": "09",
"t0": 13.47,
"t1": 15.07,
"text": "This is true for squid and their"
},
{
"scene": "09",
"t0": 15.07,
"t1": 16.53,
"text": "relatives in general."
},
{
"scene": "09",
"t0": 16.53,
"t1": 18.07,
"text": "And it means that if a squid swallowed"
},
{
"scene": "09",
"t0": 18.07,
"t1": 19.92,
"text": "a piece of food that was too big,"
},
{
"scene": "09",
"t0": 19.92,
"t1": 20.98,
"text": "it could press on its own brain."
},
{
"scene": "09",
"t0": 20.98,
"t1": 22.05,
"text": "\u2026"
},
{
"scene": "09",
"t0": 22.05,
"t1": 23.58,
"text": "Octopuses and cuttlefish"
},
{
"scene": "09",
"t0": 23.58,
"t1": 24.6,
"text": "share the same strange design."
},
{
"scene": "09",
"t0": 24.6,
"t1": 25.62,
"text": "\u2026"
},
{
"scene": "09",
"t0": 25.62,
"t1": 27.15,
"text": "It is one of the oddest facts in"
},
{
"scene": "09",
"t0": 27.15,
"t1": 28.59,
"text": "the animal world."
},
{
"scene": "09",
"t0": 28.59,
"t1": 30.51,
"text": "So the beak and the radula do careful"
},
{
"scene": "09",
"t0": 30.51,
"t1": 32.05,
"text": "work. Small pieces"
},
{
"scene": "09",
"t0": 32.05,
"t1": 33.67,
"text": "only. Even for an animal"
},
{
"scene": "09",
"t0": 33.67,
"t1": 35.24,
"text": "that weighs half a tonne."
},
{
"scene": "10",
"t0": 0.0,
"t1": 1.55,
"text": "Inside the mantle,"
},
{
"scene": "10",
"t0": 1.55,
"t1": 3.44,
"text": "there is more strangeness."
},
{
"scene": "10",
"t0": 3.44,
"t1": 5.14,
"text": "Like other squid, the colossal"
},
{
"scene": "10",
"t0": 5.14,
"t1": 6.97,
"text": "squid has three hearts."
},
{
"scene": "10",
"t0": 6.97,
"t1": 8.04,
"text": "Two of them pump blood through the gills,"
},
{
"scene": "10",
"t0": 8.04,
"t1": 9.12,
"text": "\u2026"
},
{
"scene": "10",
"t0": 9.12,
"t1": 10.5,
"text": "to pick up oxygen."
},
{
"scene": "10",
"t0": 10.5,
"t1": 12.13,
"text": "The third pumps it around"
},
{
"scene": "10",
"t0": 12.13,
"t1": 13.91,
"text": "the rest of the body."
},
{
"scene": "10",
"t0": 13.91,
"t1": 15.58,
"text": "And its blood is blue."
},
{
"scene": "10",
"t0": 15.58,
"t1": 17.21,
"text": "Our blood uses iron to carry"
},
{
"scene": "10",
"t0": 17.21,
"t1": 18.22,
"text": "oxygen, which makes it red."
},
{
"scene": "10",
"t0": 18.22,
"t1": 19.23,
"text": "\u2026"
},
{
"scene": "10",
"t0": 19.23,
"t1": 20.81,
"text": "Squid blood uses copper,"
},
{
"scene": "10",
"t0": 20.81,
"t1": 22.16,
"text": "which turns it blue."
},
{
"scene": "10",
"t0": 22.16,
"t1": 23.86,
"text": "In very cold water, with"
},
{
"scene": "10",
"t0": 23.86,
"t1": 25.41,
"text": "little oxygen, it is a"
},
{
"scene": "10",
"t0": 25.41,
"t1": 26.88,
"text": "system that works."
},
{
"scene": "11",
"t0": 0.0,
"t1": 1.91,
"text": "For a long time, people imagined"
},
{
"scene": "11",
"t0": 1.91,
"t1": 3.7,
"text": "the colossal squid as a fast,"
},
{
"scene": "11",
"t0": 3.7,
"t1": 4.73,
"text": "aggressive monster of the deep."
},
{
"scene": "11",
"t0": 4.73,
"t1": 5.77,
"text": "\u2026"
},
{
"scene": "11",
"t0": 5.77,
"t1": 7.24,
"text": "In 2010, two"
},
{
"scene": "11",
"t0": 7.24,
"t1": 9.14,
"text": "scientists looked at how much energy"
},
{
"scene": "11",
"t0": 9.14,
"t1": 10.72,
"text": "an animal like this would need in"
},
{
"scene": "11",
"t0": 10.72,
"t1": 12.53,
"text": "water close to freezing."
},
{
"scene": "11",
"t0": 12.53,
"t1": 13.54,
"text": "Their answer surprised everyone."
},
{
"scene": "11",
"t0": 13.54,
"t1": 14.56,
"text": "\u2026"
},
{
"scene": "11",
"t0": 14.56,
"t1": 16.38,
"text": "The colossal squid probably lives"
},
{
"scene": "11",
"t0": 16.38,
"t1": 17.85,
"text": "very slowly."
},
{
"scene": "11",
"t0": 17.85,
"t1": 19.66,
"text": "By their estimate, a single"
},
{
"scene": "11",
"t0": 19.66,
"t1": 21.31,
"text": "five-kilogram toothfish"
},
{
"scene": "11",
"t0": 21.31,
"t1": 23.06,
"text": "could keep a five-hundred-kilogram"
},
{
"scene": "11",
"t0": 23.06,
"t1": 24.6,
"text": "colossal squid going"
},
{
"scene": "11",
"t0": 24.6,
"t1": 25.66,
"text": "for around two hundred days."
},
{
"scene": "11",
"t0": 25.66,
"t1": 26.71,
"text": "\u2026"
},
{
"scene": "11",
"t0": 26.71,
"t1": 28.6,
"text": "So instead of chasing prey,"
},
{
"scene": "11",
"t0": 28.6,
"t1": 30.15,
"text": "it may hang almost still in the"
},
{
"scene": "11",
"t0": 30.15,
"t1": 31.88,
"text": "dark, waiting."
},
{
"scene": "11",
"t0": 31.88,
"t1": 32.96,
"text": "Watching with those huge eyes."
},
{
"scene": "11",
"t0": 32.96,
"t1": 34.05,
"text": "\u2026"
},
{
"scene": "11",
"t0": 34.05,
"t1": 35.93,
"text": "And when a fish comes close enough,"
},
{
"scene": "11",
"t0": 35.93,
"t1": 36.98,
"text": "the hooked tentacles strike."
},
{
"scene": "11",
"t0": 36.98,
"t1": 38.04,
"text": "\u2026"
},
{
"scene": "11",
"t0": 38.04,
"t1": 39.78,
"text": "Not a hunter that chases."
},
{
"scene": "11",
"t0": 39.78,
"t1": 41.47,
"text": "A hunter that waits."
},
{
"scene": "11",
"t0": 41.47,
"t1": 42.99,
"text": "In water this cold,"
},
{
"scene": "11",
"t0": 42.99,
"t1": 44.52,
"text": "close to freezing, a"
},
{
"scene": "11",
"t0": 44.52,
"t1": 46.4,
"text": "slow life makes sense."
},
{
"scene": "11",
"t0": 46.4,
"t1": 48.36,
"text": "Every movement costs energy,"
},
{
"scene": "11",
"t0": 48.36,
"t1": 50.17,
"text": "and food is hard to find."
},
{
"scene": "11",
"t0": 50.17,
"t1": 51.27,
"text": "The best plan is to waste nothing."
},
{
"scene": "11",
"t0": 51.27,
"t1": 52.38,
"text": "\u2026"
},
{
"scene": "12",
"t0": 0.0,
"t1": 1.55,
"text": "The colossal squid belongs"
},
{
"scene": "12",
"t0": 1.55,
"t1": 3.05,
"text": "to a family called glass"
},
{
"scene": "12",
"t0": 3.05,
"t1": 4.16,
"text": "squids."
},
{
"scene": "12",
"t0": 4.16,
"t1": 5.92,
"text": "When they are young, many glass"
},
{
"scene": "12",
"t0": 5.92,
"t1": 7.45,
"text": "squids are almost completely"
},
{
"scene": "12",
"t0": 7.45,
"t1": 8.58,
"text": "transparent."
},
{
"scene": "12",
"t0": 8.58,
"t1": 10.21,
"text": "You can see right through them,"
},
{
"scene": "12",
"t0": 10.21,
"t1": 11.25,
"text": "to the few organs inside."
},
{
"scene": "12",
"t0": 11.25,
"t1": 12.29,
"text": "\u2026"
},
{
"scene": "12",
"t0": 12.29,
"t1": 13.9,
"text": "In the open ocean, being"
},
{
"scene": "12",
"t0": 13.9,
"t1": 15.66,
"text": "see-through is one of the best ways"
},
{
"scene": "12",
"t0": 15.66,
"t1": 17.05,
"text": "to hide."
},
{
"scene": "12",
"t0": 17.05,
"t1": 18.77,
"text": "Many glass squids also"
},
{
"scene": "12",
"t0": 18.77,
"t1": 20.58,
"text": "carry a special fluid inside"
},
{
"scene": "12",
"t0": 20.58,
"t1": 22.21,
"text": "their bodies, rich in"
},
{
"scene": "12",
"t0": 22.21,
"t1": 23.21,
"text": "ammonia."
},
{
"scene": "12",
"t0": 23.21,
"t1": 24.99,
"text": "It is lighter than sea water,"
},
{
"scene": "12",
"t0": 24.99,
"t1": 26.56,
"text": "so it helps them float without"
},
{
"scene": "12",
"t0": 26.56,
"t1": 28.29,
"text": "effort. Like a built-in"
},
{
"scene": "12",
"t0": 28.29,
"t1": 29.59,
"text": "life jacket."
},
{
"scene": "12",
"t0": 29.59,
"t1": 31.42,
"text": "As they grow, glass squids"
},
{
"scene": "12",
"t0": 31.42,
"t1": 32.58,
"text": "move deeper."
},
{
"scene": "12",
"t0": 32.58,
"t1": 34.01,
"text": "And their bodies change."
},
{
"scene": "12",
"t0": 34.01,
"t1": 35.58,
"text": "The colossal squid grows from a"
},
{
"scene": "12",
"t0": 35.58,
"t1": 37.32,
"text": "small, clear, delicate"
},
{
"scene": "12",
"t0": 37.32,
"t1": 39.15,
"text": "animal into a red,"
},
{
"scene": "12",
"t0": 39.15,
"t1": 40.97,
"text": "heavy, five-hundred-kilogram"
},
{
"scene": "12",
"t0": 40.97,
"t1": 42.47,
"text": "giant. That is why"
},
{
"scene": "12",
"t0": 42.47,
"t1": 43.42,
"text": "the one filmed in"
},
{
"scene": "12",
"t0": 43.42,
"t1": 45.09,
"text": "2025 looked"
},
{
"scene": "12",
"t0": 45.09,
"t1": 46.19,
"text": "so unlike the adults people knew."
},
{
"scene": "12",
"t0": 46.19,
"t1": 47.28,
"text": "\u2026"
},
{
"scene": "13",
"t0": 0.0,
"t1": 1.57,
"text": "A full-grown colossal"
},
{
"scene": "13",
"t0": 1.57,
"t1": 2.73,
"text": "squid has very few enemies."
},
{
"scene": "13",
"t0": 2.73,
"t1": 3.89,
"text": "\u2026"
},
{
"scene": "13",
"t0": 3.89,
"t1": 4.94,
"text": "But one hunts it on purpose."
},
{
"scene": "13",
"t0": 4.94,
"t1": 5.99,
"text": "\u2026"
},
{
"scene": "13",
"t0": 5.99,
"t1": 7.39,
"text": "The sperm whale."
},
{
"scene": "13",
"t0": 7.39,
"t1": 9.05,
"text": "Sperm whales dive deep into"
},
{
"scene": "13",
"t0": 9.05,
"t1": 10.65,
"text": "the Southern Ocean, finding"
},
{
"scene": "13",
"t0": 10.65,
"t1": 12.48,
"text": "prey with sound, clicks"
},
{
"scene": "13",
"t0": 12.48,
"t1": 14.14,
"text": "so loud they bounce off anything"
},
{
"scene": "13",
"t0": 14.14,
"t1": 15.26,
"text": "in the dark."
},
{
"scene": "13",
"t0": 15.26,
"t1": 17.05,
"text": "They can dive more than a kilometre"
},
{
"scene": "13",
"t0": 17.05,
"t1": 18.55,
"text": "down and stay there for over"
},
{
"scene": "13",
"t0": 18.55,
"t1": 20.45,
"text": "an hour, searching."
},
{
"scene": "13",
"t0": 20.45,
"t1": 22.09,
"text": "When scientists counted the squid"
},
{
"scene": "13",
"t0": 22.09,
"t1": 23.86,
"text": "beaks inside sperm whales"
},
{
"scene": "13",
"t0": 23.86,
"t1": 24.96,
"text": "caught in parts of the Southern Ocean,"
},
{
"scene": "13",
"t0": 24.96,
"t1": 26.06,
"text": "\u2026"
},
{
"scene": "13",
"t0": 26.06,
"t1": 27.64,
"text": "colossal squid beaks were only"
},
{
"scene": "13",
"t0": 27.64,
"t1": 29.53,
"text": "a small share of the total."
},
{
"scene": "13",
"t0": 29.53,
"t1": 31.07,
"text": "But because each one came from"
},
{
"scene": "13",
"t0": 31.07,
"t1": 32.91,
"text": "such a heavy animal, colossal"
},
{
"scene": "13",
"t0": 32.91,
"t1": 34.64,
"text": "squid may have made up a large part"
},
{
"scene": "13",
"t0": 34.64,
"t1": 36.4,
"text": "of what those whales ate."
},
{
"scene": "13",
"t0": 36.4,
"t1": 38.0,
"text": "Every colossal squid beak we"
},
{
"scene": "13",
"t0": 38.0,
"t1": 39.58,
"text": "have ever found tells the"
},
{
"scene": "13",
"t0": 39.58,
"t1": 40.69,
"text": "story of a fight we have never seen."
},
{
"scene": "13",
"t0": 40.69,
"t1": 41.8,
"text": "\u2026"
},
{
"scene": "14",
"t0": 0.0,
"t1": 1.77,
"text": "So what did the 2025"
},
{
"scene": "14",
"t0": 1.77,
"t1": 3.18,
"text": "footage show?"
},
{
"scene": "14",
"t0": 3.18,
"t1": 4.72,
"text": "A young colossal squid,"
},
{
"scene": "14",
"t0": 4.72,
"t1": 6.64,
"text": "around thirty centimetres long,"
},
{
"scene": "14",
"t0": 6.64,
"t1": 8.09,
"text": "drifting in the dark."
},
{
"scene": "14",
"t0": 8.09,
"t1": 9.64,
"text": "Its eight arms folded around"
},
{
"scene": "14",
"t0": 9.64,
"t1": 10.66,
"text": "its head. Glass-clear,"
},
{
"scene": "14",
"t0": 10.66,
"t1": 11.67,
"text": "\u2026"
},
{
"scene": "14",
"t0": 11.67,
"t1": 12.68,
"text": "with tiny specks of colour."
},
{
"scene": "14",
"t0": 12.68,
"t1": 13.7,
"text": "\u2026"
},
{
"scene": "14",
"t0": 13.7,
"t1": 15.27,
"text": "The scientists only confirmed what"
},
{
"scene": "14",
"t0": 15.27,
"t1": 17.08,
"text": "it was after experts studied"
},
{
"scene": "14",
"t0": 17.08,
"t1": 18.58,
"text": "the video. The hooks on"
},
{
"scene": "14",
"t0": 18.58,
"t1": 19.63,
"text": "its arms gave it away."
},
{
"scene": "14",
"t0": 19.63,
"t1": 20.69,
"text": "\u2026"
},
{
"scene": "14",
"t0": 20.69,
"t1": 22.4,
"text": "It had taken exactly a hundred"
},
{
"scene": "14",
"t0": 22.4,
"t1": 24.14,
"text": "years, from the first pieces"
},
{
"scene": "14",
"t0": 24.14,
"t1": 25.35,
"text": "in a whale's stomach in"
},
{
"scene": "14",
"t0": 25.35,
"t1": 26.93,
"text": "1925,"
},
{
"scene": "14",
"t0": 26.93,
"t1": 28.55,
"text": "to the first time we saw one"
},
{
"scene": "14",
"t0": 28.55,
"t1": 30.08,
"text": "alive. And it was not the"
},
{
"scene": "14",
"t0": 30.08,
"t1": 32.08,
"text": "expedition's only first."
},
{
"scene": "14",
"t0": 32.08,
"t1": 33.58,
"text": "A few weeks earlier, the same"
},
{
"scene": "14",
"t0": 33.58,
"t1": 35.34,
"text": "ship had filmed another Antarctic"
},
{
"scene": "14",
"t0": 35.34,
"t1": 36.86,
"text": "squid alive for the first"
},
{
"scene": "14",
"t0": 36.86,
"t1": 38.67,
"text": "time, the glacial glass"
},
{
"scene": "14",
"t0": 38.67,
"t1": 40.26,
"text": "squid. The deep Southern"
},
{
"scene": "14",
"t0": 40.26,
"t1": 42.0,
"text": "Ocean is still full of animals"
},
{
"scene": "14",
"t0": 42.0,
"t1": 43.34,
"text": "we have barely seen."
},
{
"scene": "15",
"t0": 0.0,
"t1": 1.56,
"text": "Nobody has ever seen an"
},
{
"scene": "15",
"t0": 1.56,
"t1": 3.3,
"text": "adult colossal squid alive"
},
{
"scene": "15",
"t0": 3.3,
"t1": 4.59,
"text": "in its home."
},
{
"scene": "15",
"t0": 4.59,
"t1": 6.45,
"text": "Somewhere below the Southern Ocean,"
},
{
"scene": "15",
"t0": 6.45,
"t1": 7.55,
"text": "the big ones are still out there."
},
{
"scene": "15",
"t0": 7.55,
"t1": 8.65,
"text": "\u2026"
},
{
"scene": "15",
"t0": 8.65,
"t1": 10.18,
"text": "Hanging in the cold."
},
{
"scene": "15",
"t0": 10.18,
"t1": 11.82,
"text": "Watching with the biggest eyes on"
},
{
"scene": "15",
"t0": 11.82,
"t1": 12.94,
"text": "Earth. Waiting."
},
{
"scene": "15",
"t0": 12.94,
"t1": 14.05,
"text": "\u2026"
},
{
"scene": "15",
"t0": 14.05,
"t1": 15.56,
"text": "Maybe one day a camera will"
},
{
"scene": "15",
"t0": 15.56,
"t1": 16.59,
"text": "find one."
},
{
"scene": "15",
"t0": 16.59,
"t1": 18.26,
"text": "Until then, all we have"
},
{
"scene": "15",
"t0": 18.26,
"t1": 20.14,
"text": "is one small, glassy"
},
{
"scene": "15",
"t0": 20.14,
"t1": 21.73,
"text": "young squid, drifting"
},
{
"scene": "15",
"t0": 21.73,
"t1": 23.34,
"text": "through a robot's lights for a few"
},
{
"scene": "15",
"t0": 23.34,
"t1": 25.1,
"text": "minutes. And a hundred years"
},
{
"scene": "15",
"t0": 25.1,
"t1": 26.2,
"text": "of wondering."
}
]