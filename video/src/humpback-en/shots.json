[
 {
  "scene": "01",
  "t0": 0.0,
  "t1": 0.84,
  "text": "February 2025."
 },
 {
  "scene": "01",
  "t0": 0.84,
  "t1": 1.78,
  "text": "…"
 },
 {
  "scene": "01",
  "t0": 1.78,
  "t1": 3.0,
  "text": "The Strait of"
 },
 {
  "scene": "01",
  "t0": 3.0,
  "t1": 4.45,
  "text": "Magellan, at the very bottom"
 },
 {
  "scene": "01",
  "t0": 4.45,
  "t1": 6.23,
  "text": "of South America."
 },
 {
  "scene": "01",
  "t0": 6.23,
  "t1": 7.46,
  "text": "A young man named Adrián"
 },
 {
  "scene": "01",
  "t0": 7.46,
  "t1": 8.9,
  "text": "is paddling a yellow"
 },
 {
  "scene": "01",
  "t0": 8.9,
  "t1": 10.46,
  "text": "kayak. His father"
 },
 {
  "scene": "01",
  "t0": 10.46,
  "t1": 11.66,
  "text": "is a few metres behind"
 },
 {
  "scene": "01",
  "t0": 11.66,
  "t1": 13.1,
  "text": "him, filming."
 },
 {
  "scene": "01",
  "t0": 13.1,
  "t1": 14.5,
  "text": "The water under Adrián turns"
 },
 {
  "scene": "01",
  "t0": 14.5,
  "t1": 15.88,
  "text": "dark."
 },
 {
  "scene": "01",
  "t0": 15.88,
  "t1": 17.42,
  "text": "And in one second, Adrián"
 },
 {
  "scene": "01",
  "t0": 17.42,
  "t1": 18.31,
  "text": "and his kayak"
 },
 {
  "scene": "01",
  "t0": 18.31,
  "t1": 19.52,
  "text": "are gone."
 },
 {
  "scene": "01",
  "t0": 19.52,
  "t1": 22.06,
  "text": "Inside the mouth of a humpback whale."
 },
 {
  "scene": "01",
  "t0": 22.06,
  "t1": 23.3,
  "text": "So what really happens when"
 },
 {
  "scene": "01",
  "t0": 23.3,
  "t1": 24.61,
  "text": "a humpback whale swallows"
 },
 {
  "scene": "01",
  "t0": 24.61,
  "t1": 25.97,
  "text": "you? Can it actually"
 },
 {
  "scene": "01",
  "t0": 25.97,
  "t1": 27.0,
  "text": "swallow you?"
 },
 {
  "scene": "01",
  "t0": 27.0,
  "t1": 28.02,
  "text": "How long could you last"
 },
 {
  "scene": "01",
  "t0": 28.02,
  "t1": 29.69,
  "text": "in there? And why does this"
 },
 {
  "scene": "01",
  "t0": 29.69,
  "t1": 30.97,
  "text": "same whale risk its life"
 },
 {
  "scene": "01",
  "t0": 30.97,
  "t1": 32.34,
  "text": "to save other animals from"
 },
 {
  "scene": "01",
  "t0": 32.34,
  "t1": 33.0,
  "text": "killers?"
 },
 {
  "scene": "02",
  "t0": 0.0,
  "t1": 2.19,
  "text": "For a moment there is nothing."
 },
 {
  "scene": "02",
  "t0": 2.19,
  "t1": 3.57,
  "text": "Just a swirl on the water where"
 },
 {
  "scene": "02",
  "t0": 3.57,
  "t1": 5.42,
  "text": "a person used to be."
 },
 {
  "scene": "02",
  "t0": 5.42,
  "t1": 6.53,
  "text": "Adrián said later"
 },
 {
  "scene": "02",
  "t0": 6.53,
  "t1": 7.44,
  "text": "he thought he was already"
 },
 {
  "scene": "02",
  "t0": 7.44,
  "t1": 8.54,
  "text": "dead."
 },
 {
  "scene": "02",
  "t0": 8.54,
  "t1": 10.27,
  "text": "He felt something slimy close over"
 },
 {
  "scene": "02",
  "t0": 10.27,
  "t1": 11.64,
  "text": "his face, and everything"
 },
 {
  "scene": "02",
  "t0": 11.64,
  "t1": 13.14,
  "text": "went black."
 },
 {
  "scene": "02",
  "t0": 13.14,
  "t1": 14.04,
  "text": "Then, just"
 },
 {
  "scene": "02",
  "t0": 14.04,
  "t1": 14.94,
  "text": "as fast,"
 },
 {
  "scene": "02",
  "t0": 14.94,
  "t1": 16.24,
  "text": "the whale opened its mouth"
 },
 {
  "scene": "02",
  "t0": 16.24,
  "t1": 17.71,
  "text": "and let him go."
 },
 {
  "scene": "02",
  "t0": 17.71,
  "t1": 19.21,
  "text": "He popped up in the cold water,"
 },
 {
  "scene": "02",
  "t0": 19.21,
  "t1": 20.45,
  "text": "gasping."
 },
 {
  "scene": "02",
  "t0": 20.45,
  "t1": 22.14,
  "text": "His father kept filming, and"
 },
 {
  "scene": "02",
  "t0": 22.14,
  "t1": 23.67,
  "text": "kept calling to him."
 },
 {
  "scene": "02",
  "t0": 23.67,
  "t1": 25.93,
  "text": "Stay calm. Grab the boat."
 },
 {
  "scene": "02",
  "t0": 25.93,
  "t1": 27.31,
  "text": "Adrián reached his father's"
 },
 {
  "scene": "02",
  "t0": 27.31,
  "t1": 28.97,
  "text": "kayak. Both of them made it back"
 },
 {
  "scene": "02",
  "t0": 28.97,
  "t1": 29.96,
  "text": "to shore without a"
 },
 {
  "scene": "02",
  "t0": 29.96,
  "t1": 31.86,
  "text": "scratch. The whole thing lasted"
 },
 {
  "scene": "02",
  "t0": 31.86,
  "t1": 33.18,
  "text": "a few seconds."
 },
 {
  "scene": "02",
  "t0": 33.18,
  "t1": 34.74,
  "text": "But to understand what happened in those"
 },
 {
  "scene": "02",
  "t0": 34.74,
  "t1": 36.31,
  "text": "seconds, you need to know"
 },
 {
  "scene": "02",
  "t0": 36.31,
  "t1": 37.17,
  "text": "what grabbed him."
 },
 {
  "scene": "03",
  "t0": 0.0,
  "t1": 2.37,
  "text": "This is the humpback whale."
 },
 {
  "scene": "03",
  "t0": 2.37,
  "t1": 3.66,
  "text": "An adult is fourteen to"
 },
 {
  "scene": "03",
  "t0": 3.66,
  "t1": 4.43,
  "text": "seventeen metres"
 },
 {
  "scene": "03",
  "t0": 4.43,
  "t1": 5.91,
  "text": "long. Longer than"
 },
 {
  "scene": "03",
  "t0": 5.91,
  "t1": 7.37,
  "text": "a city bus."
 },
 {
  "scene": "03",
  "t0": 7.37,
  "t1": 8.82,
  "text": "It can weigh up to forty tonnes."
 },
 {
  "scene": "03",
  "t0": 8.82,
  "t1": 10.37,
  "text": "That is more than six"
 },
 {
  "scene": "03",
  "t0": 10.37,
  "t1": 11.85,
  "text": "elephants."
 },
 {
  "scene": "03",
  "t0": 11.85,
  "t1": 12.8,
  "text": "Its flippers are the longest"
 },
 {
  "scene": "03",
  "t0": 12.8,
  "t1": 13.81,
  "text": "of any whale."
 },
 {
  "scene": "03",
  "t0": 13.81,
  "t1": 15.49,
  "text": "Each one is up to five"
 },
 {
  "scene": "03",
  "t0": 15.49,
  "t1": 17.17,
  "text": "metres. A third of its"
 },
 {
  "scene": "03",
  "t0": 17.17,
  "t1": 18.22,
  "text": "body."
 },
 {
  "scene": "03",
  "t0": 18.22,
  "t1": 19.57,
  "text": "Those bumps on its head are not"
 },
 {
  "scene": "03",
  "t0": 19.57,
  "t1": 20.77,
  "text": "barnacles."
 },
 {
  "scene": "03",
  "t0": 20.77,
  "t1": 22.82,
  "text": "Each one grows a single hair, like"
 },
 {
  "scene": "03",
  "t0": 22.82,
  "t1": 24.39,
  "text": "a whisker. And it has"
 },
 {
  "scene": "03",
  "t0": 24.39,
  "t1": 25.78,
  "text": "no teeth at all."
 },
 {
  "scene": "03",
  "t0": 25.78,
  "t1": 27.06,
  "text": "Not one."
 },
 {
  "scene": "03",
  "t0": 27.06,
  "t1": 28.54,
  "text": "So if it cannot bite,"
 },
 {
  "scene": "03",
  "t0": 28.54,
  "t1": 29.86,
  "text": "why does it need a mouth that"
 },
 {
  "scene": "03",
  "t0": 29.86,
  "t1": 30.22,
  "text": "big?"
 },
 {
  "scene": "04",
  "t0": 0.0,
  "t1": 1.47,
  "text": "Instead of teeth, it"
 },
 {
  "scene": "04",
  "t0": 1.47,
  "t1": 2.85,
  "text": "has baleen."
 },
 {
  "scene": "04",
  "t0": 2.85,
  "t1": 4.16,
  "text": "Hundreds of plates hang from"
 },
 {
  "scene": "04",
  "t0": 4.16,
  "t1": 5.59,
  "text": "its upper jaw, like"
 },
 {
  "scene": "04",
  "t0": 5.59,
  "t1": 7.82,
  "text": "the teeth of a giant comb."
 },
 {
  "scene": "04",
  "t0": 7.82,
  "t1": 9.71,
  "text": "It hunts small things."
 },
 {
  "scene": "04",
  "t0": 9.71,
  "t1": 11.07,
  "text": "Krill, tiny shrimp-like"
 },
 {
  "scene": "04",
  "t0": 11.07,
  "t1": 12.51,
  "text": "animals."
 },
 {
  "scene": "04",
  "t0": 12.51,
  "t1": 13.99,
  "text": "And small fish."
 },
 {
  "scene": "04",
  "t0": 13.99,
  "t1": 15.38,
  "text": "To catch them, it charges"
 },
 {
  "scene": "04",
  "t0": 15.38,
  "t1": 16.72,
  "text": "at a swarm and opens"
 },
 {
  "scene": "04",
  "t0": 16.72,
  "t1": 18.78,
  "text": "its mouth wide."
 },
 {
  "scene": "04",
  "t0": 18.78,
  "t1": 20.4,
  "text": "Its throat is folded into long"
 },
 {
  "scene": "04",
  "t0": 20.4,
  "t1": 21.6,
  "text": "pleats, like an accordion."
 },
 {
  "scene": "04",
  "t0": 21.6,
  "t1": 22.61,
  "text": "…"
 },
 {
  "scene": "04",
  "t0": 22.61,
  "t1": 24.39,
  "text": "When the water rushes in, the pleats"
 },
 {
  "scene": "04",
  "t0": 24.39,
  "t1": 25.88,
  "text": "stretch, and the"
 },
 {
  "scene": "04",
  "t0": 25.88,
  "t1": 27.29,
  "text": "throat balloons out like a"
 },
 {
  "scene": "04",
  "t0": 27.29,
  "t1": 28.29,
  "text": "bubble."
 },
 {
  "scene": "04",
  "t0": 28.29,
  "t1": 30.32,
  "text": "In a single gulp, it takes in tonnes"
 },
 {
  "scene": "04",
  "t0": 30.32,
  "t1": 31.78,
  "text": "of water."
 },
 {
  "scene": "04",
  "t0": 31.78,
  "t1": 33.73,
  "text": "Then it pushes the water out through"
 },
 {
  "scene": "04",
  "t0": 33.73,
  "t1": 35.5,
  "text": "the comb. And the food"
 },
 {
  "scene": "04",
  "t0": 35.5,
  "t1": 37.16,
  "text": "stays inside."
 },
 {
  "scene": "04",
  "t0": 37.16,
  "t1": 38.04,
  "text": "It does not look at"
 },
 {
  "scene": "04",
  "t0": 38.04,
  "t1": 39.13,
  "text": "each fish."
 },
 {
  "scene": "04",
  "t0": 39.13,
  "t1": 40.48,
  "text": "It just swallows the whole"
 },
 {
  "scene": "04",
  "t0": 40.48,
  "t1": 42.46,
  "text": "patch. And sometimes,"
 },
 {
  "scene": "04",
  "t0": 42.46,
  "t1": 43.71,
  "text": "there is something else in"
 },
 {
  "scene": "04",
  "t0": 43.71,
  "t1": 44.56,
  "text": "that patch."
 },
 {
  "scene": "05",
  "t0": 0.0,
  "t1": 1.5,
  "text": "This is called lunge"
 },
 {
  "scene": "05",
  "t0": 1.5,
  "t1": 2.65,
  "text": "feeding."
 },
 {
  "scene": "05",
  "t0": 2.65,
  "t1": 4.58,
  "text": "The whale picks a spot, rises"
 },
 {
  "scene": "05",
  "t0": 4.58,
  "t1": 6.13,
  "text": "fast from the deep and"
 },
 {
  "scene": "05",
  "t0": 6.13,
  "t1": 7.9,
  "text": "opens its mouth right at the surface."
 },
 {
  "scene": "05",
  "t0": 7.9,
  "t1": 8.96,
  "text": "…"
 },
 {
  "scene": "05",
  "t0": 8.96,
  "t1": 10.74,
  "text": "From above, you can see almost"
 },
 {
  "scene": "05",
  "t0": 10.74,
  "t1": 12.92,
  "text": "nothing. The water turns dark,"
 },
 {
  "scene": "05",
  "t0": 12.92,
  "t1": 14.39,
  "text": "and maybe starts to boil"
 },
 {
  "scene": "05",
  "t0": 14.39,
  "t1": 15.95,
  "text": "with fish."
 },
 {
  "scene": "05",
  "t0": 15.95,
  "t1": 17.12,
  "text": "Scientists who studied"
 },
 {
  "scene": "05",
  "t0": 17.12,
  "t1": 18.14,
  "text": "Adrián's video"
 },
 {
  "scene": "05",
  "t0": 18.14,
  "t1": 19.4,
  "text": "think that is exactly"
 },
 {
  "scene": "05",
  "t0": 19.4,
  "t1": 20.69,
  "text": "what happened."
 },
 {
  "scene": "05",
  "t0": 20.69,
  "t1": 22.21,
  "text": "The whale lunged at a school"
 },
 {
  "scene": "05",
  "t0": 22.21,
  "t1": 23.22,
  "text": "of fish."
 },
 {
  "scene": "05",
  "t0": 23.22,
  "t1": 24.76,
  "text": "And Adrián was sitting right on top"
 },
 {
  "scene": "05",
  "t0": 24.76,
  "t1": 25.91,
  "text": "of it."
 },
 {
  "scene": "05",
  "t0": 25.91,
  "t1": 28.11,
  "text": "The whale never meant to grab him."
 },
 {
  "scene": "05",
  "t0": 28.11,
  "t1": 28.93,
  "text": "It did not even know"
 },
 {
  "scene": "05",
  "t0": 28.93,
  "t1": 29.74,
  "text": "there was a person"
 },
 {
  "scene": "05",
  "t0": 29.74,
  "t1": 30.95,
  "text": "there until he was in its"
 },
 {
  "scene": "05",
  "t0": 30.95,
  "t1": 32.92,
  "text": "mouth. And the moment it felt"
 },
 {
  "scene": "05",
  "t0": 32.92,
  "t1": 34.48,
  "text": "a hard plastic kayak,"
 },
 {
  "scene": "05",
  "t0": 34.48,
  "t1": 36.61,
  "text": "it spat everything back out."
 },
 {
  "scene": "05",
  "t0": 36.61,
  "t1": 37.79,
  "text": "But there is one man who was"
 },
 {
  "scene": "05",
  "t0": 37.79,
  "t1": 39.21,
  "text": "not so lucky."
 },
 {
  "scene": "05",
  "t0": 39.21,
  "t1": 40.98,
  "text": "He did not get a few seconds."
 },
 {
  "scene": "05",
  "t0": 40.98,
  "t1": 42.18,
  "text": "He got much longer."
 },
 {
  "scene": "06",
  "t0": 0.0,
  "t1": 1.63,
  "text": "June 2021."
 },
 {
  "scene": "06",
  "t0": 1.63,
  "t1": 2.58,
  "text": "The coast of Cape"
 },
 {
  "scene": "06",
  "t0": 2.58,
  "t1": 3.67,
  "text": "Cod, in Massachusetts."
 },
 {
  "scene": "06",
  "t0": 3.67,
  "t1": 4.96,
  "text": "…"
 },
 {
  "scene": "06",
  "t0": 4.96,
  "t1": 6.05,
  "text": "Michael Packard is a lobster"
 },
 {
  "scene": "06",
  "t0": 6.05,
  "t1": 7.15,
  "text": "diver."
 },
 {
  "scene": "06",
  "t0": 7.15,
  "t1": 8.11,
  "text": "He has done this for decades."
 },
 {
  "scene": "06",
  "t0": 8.11,
  "t1": 9.12,
  "text": "…"
 },
 {
  "scene": "06",
  "t0": 9.12,
  "t1": 10.59,
  "text": "Right now he is about thirteen metres"
 },
 {
  "scene": "06",
  "t0": 10.59,
  "t1": 11.92,
  "text": "down, near the"
 },
 {
  "scene": "06",
  "t0": 11.92,
  "t1": 12.93,
  "text": "bottom."
 },
 {
  "scene": "06",
  "t0": 12.93,
  "t1": 14.56,
  "text": "Then something hits him."
 },
 {
  "scene": "06",
  "t0": 14.56,
  "t1": 15.65,
  "text": "He said it felt like being"
 },
 {
  "scene": "06",
  "t0": 15.65,
  "t1": 16.43,
  "text": "hit by a truck."
 },
 {
  "scene": "06",
  "t0": 16.43,
  "t1": 17.15,
  "text": "…"
 },
 {
  "scene": "06",
  "t0": 17.15,
  "t1": 19.29,
  "text": "Everything went black."
 },
 {
  "scene": "06",
  "t0": 19.29,
  "t1": 20.4,
  "text": "At first he thought it was a"
 },
 {
  "scene": "06",
  "t0": 20.4,
  "t1": 21.98,
  "text": "shark. Then he realised"
 },
 {
  "scene": "06",
  "t0": 21.98,
  "t1": 23.29,
  "text": "there were no teeth."
 },
 {
  "scene": "06",
  "t0": 23.29,
  "t1": 24.53,
  "text": "And he felt the whale's muscles"
 },
 {
  "scene": "06",
  "t0": 24.53,
  "t1": 26.5,
  "text": "squeezing around him."
 },
 {
  "scene": "06",
  "t0": 26.5,
  "t1": 28.1,
  "text": "He was inside a humpback whale's"
 },
 {
  "scene": "06",
  "t0": 28.1,
  "t1": 30.2,
  "text": "mouth. With his breathing regulator"
 },
 {
  "scene": "06",
  "t0": 30.2,
  "t1": 32.05,
  "text": "still in. He thought about his"
 },
 {
  "scene": "06",
  "t0": 32.05,
  "t1": 33.85,
  "text": "wife and his two sons."
 },
 {
  "scene": "06",
  "t0": 33.85,
  "t1": 34.8,
  "text": "He was sure he was"
 },
 {
  "scene": "06",
  "t0": 34.8,
  "t1": 35.55,
  "text": "about to die."
 },
 {
  "scene": "07",
  "t0": 0.0,
  "t1": 1.07,
  "text": "So what was it like in"
 },
 {
  "scene": "07",
  "t0": 1.07,
  "t1": 2.06,
  "text": "there?"
 },
 {
  "scene": "07",
  "t0": 2.06,
  "t1": 3.94,
  "text": "Dark. Tight."
 },
 {
  "scene": "07",
  "t0": 3.94,
  "t1": 6.05,
  "text": "Wet. And everything moving."
 },
 {
  "scene": "07",
  "t0": 6.05,
  "t1": 7.39,
  "text": "The whale was swimming and shaking"
 },
 {
  "scene": "07",
  "t0": 7.39,
  "t1": 8.62,
  "text": "its head."
 },
 {
  "scene": "07",
  "t0": 8.62,
  "t1": 9.89,
  "text": "He could still breathe from his"
 },
 {
  "scene": "07",
  "t0": 9.89,
  "t1": 11.65,
  "text": "tank. That was the only reason"
 },
 {
  "scene": "07",
  "t0": 11.65,
  "t1": 13.7,
  "text": "he had time to think."
 },
 {
  "scene": "07",
  "t0": 13.7,
  "t1": 14.88,
  "text": "Then the whale rose to the"
 },
 {
  "scene": "07",
  "t0": 14.88,
  "t1": 16.53,
  "text": "surface, opened its mouth"
 },
 {
  "scene": "07",
  "t0": 16.53,
  "t1": 18.42,
  "text": "and threw him into the air."
 },
 {
  "scene": "07",
  "t0": 18.42,
  "t1": 19.98,
  "text": "He fell into the water and stayed"
 },
 {
  "scene": "07",
  "t0": 19.98,
  "t1": 21.98,
  "text": "afloat. His crewmate pulled him"
 },
 {
  "scene": "07",
  "t0": 21.98,
  "t1": 23.2,
  "text": "into the boat."
 },
 {
  "scene": "07",
  "t0": 23.2,
  "t1": 24.76,
  "text": "He was in the whale's mouth for about thirty"
 },
 {
  "scene": "07",
  "t0": 24.76,
  "t1": 26.17,
  "text": "seconds."
 },
 {
  "scene": "07",
  "t0": 26.17,
  "t1": 27.6,
  "text": "Maybe forty."
 },
 {
  "scene": "07",
  "t0": 27.6,
  "t1": 29.4,
  "text": "He went to hospital with bruises all"
 },
 {
  "scene": "07",
  "t0": 29.4,
  "t1": 30.62,
  "text": "over his body."
 },
 {
  "scene": "07",
  "t0": 30.62,
  "t1": 32.46,
  "text": "Not a single broken bone."
 },
 {
  "scene": "07",
  "t0": 32.46,
  "t1": 33.27,
  "text": "He went home the"
 },
 {
  "scene": "07",
  "t0": 33.27,
  "t1": 34.3,
  "text": "same day."
 },
 {
  "scene": "07",
  "t0": 34.3,
  "t1": 35.27,
  "text": "So he was in the mouth of"
 },
 {
  "scene": "07",
  "t0": 35.27,
  "t1": 36.17,
  "text": "a whale."
 },
 {
  "scene": "07",
  "t0": 36.17,
  "t1": 37.72,
  "text": "But was he ever really in danger"
 },
 {
  "scene": "07",
  "t0": 37.72,
  "t1": 38.67,
  "text": "of being swallowed?"
 },
 {
  "scene": "08",
  "t0": 0.0,
  "t1": 1.57,
  "text": "Here is the answer to the first"
 },
 {
  "scene": "08",
  "t0": 1.57,
  "t1": 3.67,
  "text": "question. A humpback's mouth"
 },
 {
  "scene": "08",
  "t0": 3.67,
  "t1": 5.09,
  "text": "is so big that a car"
 },
 {
  "scene": "08",
  "t0": 5.09,
  "t1": 6.93,
  "text": "would fit inside it."
 },
 {
  "scene": "08",
  "t0": 6.93,
  "t1": 8.89,
  "text": "But its throat would not."
 },
 {
  "scene": "08",
  "t0": 8.89,
  "t1": 10.98,
  "text": "The opening to its stomach is about the size"
 },
 {
  "scene": "08",
  "t0": 10.98,
  "t1": 12.75,
  "text": "of your fist."
 },
 {
  "scene": "08",
  "t0": 12.75,
  "t1": 14.29,
  "text": "Even stretched to the limit,"
 },
 {
  "scene": "08",
  "t0": 14.29,
  "t1": 15.87,
  "text": "it only reaches thirty,"
 },
 {
  "scene": "08",
  "t0": 15.87,
  "t1": 17.11,
  "text": "at most thirty-eight centimetres."
 },
 {
  "scene": "08",
  "t0": 17.11,
  "t1": 18.85,
  "text": "That is narrower"
 },
 {
  "scene": "08",
  "t0": 18.85,
  "t1": 20.47,
  "text": "than your shoulders."
 },
 {
  "scene": "08",
  "t0": 20.47,
  "t1": 21.85,
  "text": "It can take you in."
 },
 {
  "scene": "08",
  "t0": 21.85,
  "t1": 23.59,
  "text": "But it cannot swallow you."
 },
 {
  "scene": "08",
  "t0": 23.59,
  "t1": 25.09,
  "text": "Its body simply will not let you"
 },
 {
  "scene": "08",
  "t0": 25.09,
  "t1": 26.77,
  "text": "through. Scientists have"
 },
 {
  "scene": "08",
  "t0": 26.77,
  "t1": 28.05,
  "text": "found seabirds in humpback"
 },
 {
  "scene": "08",
  "t0": 28.05,
  "t1": 29.75,
  "text": "whale droppings."
 },
 {
  "scene": "08",
  "t0": 29.75,
  "t1": 31.24,
  "text": "Something small can slip down"
 },
 {
  "scene": "08",
  "t0": 31.24,
  "t1": 34.05,
  "text": "by accident. A person cannot."
 },
 {
  "scene": "08",
  "t0": 34.05,
  "t1": 35.59,
  "text": "So in the strict sense, no"
 },
 {
  "scene": "08",
  "t0": 35.59,
  "t1": 36.89,
  "text": "humpback whale has ever"
 },
 {
  "scene": "08",
  "t0": 36.89,
  "t1": 38.35,
  "text": "swallowed a person."
 },
 {
  "scene": "08",
  "t0": 38.35,
  "t1": 39.88,
  "text": "But there is one story that is more"
 },
 {
  "scene": "08",
  "t0": 39.88,
  "t1": 41.46,
  "text": "than a hundred years old."
 },
 {
  "scene": "08",
  "t0": 41.46,
  "t1": 42.3,
  "text": "And it says a whale"
 },
 {
  "scene": "08",
  "t0": 42.3,
  "t1": 42.81,
  "text": "did."
 },
 {
  "scene": "09",
  "t0": 0.0,
  "t1": 1.62,
  "text": "In 1891,"
 },
 {
  "scene": "09",
  "t0": 1.62,
  "t1": 2.83,
  "text": "newspapers told the story"
 },
 {
  "scene": "09",
  "t0": 2.83,
  "t1": 4.31,
  "text": "of a sailor named James"
 },
 {
  "scene": "09",
  "t0": 4.31,
  "t1": 5.22,
  "text": "Bartley."
 },
 {
  "scene": "09",
  "t0": 5.22,
  "t1": 5.52,
  "text": "His"
 },
 {
  "scene": "09",
  "t0": 5.52,
  "t1": 6.89,
  "text": "ship, the Star of"
 },
 {
  "scene": "09",
  "t0": 6.89,
  "t1": 8.44,
  "text": "the East, was hunting a whale"
 },
 {
  "scene": "09",
  "t0": 8.44,
  "t1": 9.4,
  "text": "near the Falkland"
 },
 {
  "scene": "09",
  "t0": 9.4,
  "t1": 10.5,
  "text": "Islands."
 },
 {
  "scene": "09",
  "t0": 10.5,
  "t1": 12.41,
  "text": "The whale smashed a boat, and Bartley"
 },
 {
  "scene": "09",
  "t0": 12.41,
  "t1": 13.98,
  "text": "disappeared."
 },
 {
  "scene": "09",
  "t0": 13.98,
  "t1": 15.44,
  "text": "The next day, the crew"
 },
 {
  "scene": "09",
  "t0": 15.44,
  "t1": 16.94,
  "text": "killed the whale and cut it open."
 },
 {
  "scene": "09",
  "t0": 16.94,
  "t1": 18.17,
  "text": "And inside,"
 },
 {
  "scene": "09",
  "t0": 18.17,
  "t1": 20.55,
  "text": "they said, was Bartley."
 },
 {
  "scene": "09",
  "t0": 20.55,
  "t1": 22.53,
  "text": "Alive. His skin bleached white"
 },
 {
  "scene": "09",
  "t0": 22.53,
  "t1": 24.45,
  "text": "by stomach acid."
 },
 {
  "scene": "09",
  "t0": 24.45,
  "t1": 25.71,
  "text": "The story went around the world."
 },
 {
  "scene": "09",
  "t0": 25.71,
  "t1": 26.74,
  "text": "It is still"
 },
 {
  "scene": "09",
  "t0": 26.74,
  "t1": 28.08,
  "text": "told today."
 },
 {
  "scene": "09",
  "t0": 28.08,
  "t1": 29.79,
  "text": "But when a historian checked it a hundred"
 },
 {
  "scene": "09",
  "t0": 29.79,
  "t1": 31.13,
  "text": "years later, almost"
 },
 {
  "scene": "09",
  "t0": 31.13,
  "t1": 32.49,
  "text": "nothing fit."
 },
 {
  "scene": "09",
  "t0": 32.49,
  "t1": 33.97,
  "text": "The Star of the East was not"
 },
 {
  "scene": "09",
  "t0": 33.97,
  "t1": 35.43,
  "text": "even a whaling ship."
 },
 {
  "scene": "09",
  "t0": 35.43,
  "t1": 36.67,
  "text": "And there is no James Bartley"
 },
 {
  "scene": "09",
  "t0": 36.67,
  "t1": 38.63,
  "text": "on the crew lists."
 },
 {
  "scene": "09",
  "t0": 38.63,
  "t1": 39.99,
  "text": "Even at the time, the captain's"
 },
 {
  "scene": "09",
  "t0": 39.99,
  "t1": 41.77,
  "text": "wife wrote that there was not one word"
 },
 {
  "scene": "09",
  "t0": 41.77,
  "t1": 42.86,
  "text": "of truth in the story."
 },
 {
  "scene": "09",
  "t0": 42.86,
  "t1": 43.73,
  "text": "…"
 },
 {
  "scene": "09",
  "t0": 43.73,
  "t1": 45.1,
  "text": "And that whale was supposed to be"
 },
 {
  "scene": "09",
  "t0": 45.1,
  "t1": 47.14,
  "text": "a sperm whale. The one whale"
 },
 {
  "scene": "09",
  "t0": 47.14,
  "t1": 48.66,
  "text": "that really could swallow a person."
 },
 {
  "scene": "09",
  "t0": 48.66,
  "t1": 50.69,
  "text": "It is a myth."
 },
 {
  "scene": "09",
  "t0": 50.69,
  "t1": 51.87,
  "text": "The real humpback is very"
 },
 {
  "scene": "09",
  "t0": 51.87,
  "t1": 52.59,
  "text": "different."
 },
 {
  "scene": "10",
  "t0": 0.0,
  "t1": 1.72,
  "text": "Because humpbacks are not just big."
 },
 {
  "scene": "10",
  "t0": 1.72,
  "t1": 3.65,
  "text": "They are clever."
 },
 {
  "scene": "10",
  "t0": 3.65,
  "t1": 4.63,
  "text": "In Alaska, they"
 },
 {
  "scene": "10",
  "t0": 4.63,
  "t1": 5.61,
  "text": "hunt in groups,"
 },
 {
  "scene": "10",
  "t0": 5.61,
  "t1": 7.52,
  "text": "and they have a special trick."
 },
 {
  "scene": "10",
  "t0": 7.52,
  "t1": 9.17,
  "text": "One whale dives under a school of fish"
 },
 {
  "scene": "10",
  "t0": 9.17,
  "t1": 10.6,
  "text": "and swims in a circle,"
 },
 {
  "scene": "10",
  "t0": 10.6,
  "t1": 11.63,
  "text": "blowing a stream"
 },
 {
  "scene": "10",
  "t0": 11.63,
  "t1": 12.95,
  "text": "of bubbles."
 },
 {
  "scene": "10",
  "t0": 12.95,
  "t1": 14.48,
  "text": "The bubbles rise like a curtain,"
 },
 {
  "scene": "10",
  "t0": 14.48,
  "t1": 16.12,
  "text": "and the fish are afraid"
 },
 {
  "scene": "10",
  "t0": 16.12,
  "t1": 17.77,
  "text": "to swim through it."
 },
 {
  "scene": "10",
  "t0": 17.77,
  "t1": 19.42,
  "text": "The circle tightens."
 },
 {
  "scene": "10",
  "t0": 19.42,
  "t1": 20.9,
  "text": "The fish pack closer and"
 },
 {
  "scene": "10",
  "t0": 20.9,
  "t1": 22.67,
  "text": "closer. Then the whales"
 },
 {
  "scene": "10",
  "t0": 22.67,
  "t1": 24.58,
  "text": "rise up together through the middle,"
 },
 {
  "scene": "10",
  "t0": 24.58,
  "t1": 26.39,
  "text": "mouths wide open."
 },
 {
  "scene": "10",
  "t0": 26.39,
  "t1": 28.33,
  "text": "This is a bubble net."
 },
 {
  "scene": "10",
  "t0": 28.33,
  "t1": 29.72,
  "text": "If you were in a boat above it,"
 },
 {
  "scene": "10",
  "t0": 29.72,
  "t1": 30.91,
  "text": "you would see a ring of bubbles"
 },
 {
  "scene": "10",
  "t0": 30.91,
  "t1": 32.11,
  "text": "appear on the calm"
 },
 {
  "scene": "10",
  "t0": 32.11,
  "t1": 32.9,
  "text": "water."
 },
 {
  "scene": "10",
  "t0": 32.9,
  "t1": 34.18,
  "text": "A few seconds before the whales"
 },
 {
  "scene": "10",
  "t0": 34.18,
  "t1": 34.99,
  "text": "burst through"
 },
 {
  "scene": "10",
  "t0": 34.99,
  "t1": 35.75,
  "text": "it."
 },
 {
  "scene": "10",
  "t0": 35.75,
  "t1": 36.55,
  "text": "That ring is the"
 },
 {
  "scene": "10",
  "t0": 36.55,
  "t1": 37.39,
  "text": "warning."
 },
 {
  "scene": "10",
  "t0": 37.39,
  "t1": 38.74,
  "text": "But very few people know how"
 },
 {
  "scene": "10",
  "t0": 38.74,
  "t1": 39.45,
  "text": "to read it."
 },
 {
  "scene": "11",
  "t0": 0.0,
  "t1": 1.32,
  "text": "The males have one more"
 },
 {
  "scene": "11",
  "t0": 1.32,
  "t1": 2.44,
  "text": "skill. They"
 },
 {
  "scene": "11",
  "t0": 2.44,
  "t1": 3.45,
  "text": "sing."
 },
 {
  "scene": "11",
  "t0": 3.45,
  "t1": 4.98,
  "text": "They hang in the water, almost"
 },
 {
  "scene": "11",
  "t0": 4.98,
  "t1": 6.72,
  "text": "still, and make long, haunting"
 },
 {
  "scene": "11",
  "t0": 6.72,
  "t1": 8.21,
  "text": "sounds."
 },
 {
  "scene": "11",
  "t0": 8.21,
  "t1": 9.65,
  "text": "Moans, groans and high"
 },
 {
  "scene": "11",
  "t0": 9.65,
  "t1": 10.99,
  "text": "squeals."
 },
 {
  "scene": "11",
  "t0": 10.99,
  "t1": 12.19,
  "text": "One song can last up to twenty"
 },
 {
  "scene": "11",
  "t0": 12.19,
  "t1": 13.4,
  "text": "minutes."
 },
 {
  "scene": "11",
  "t0": 13.4,
  "t1": 14.22,
  "text": "Then they sing it again."
 },
 {
  "scene": "11",
  "t0": 14.22,
  "t1": 14.65,
  "text": "…"
 },
 {
  "scene": "11",
  "t0": 14.65,
  "t1": 16.27,
  "text": "For hours."
 },
 {
  "scene": "11",
  "t0": 16.27,
  "t1": 17.5,
  "text": "All the males in one area"
 },
 {
  "scene": "11",
  "t0": 17.5,
  "t1": 18.64,
  "text": "sing the same song."
 },
 {
  "scene": "11",
  "t0": 18.64,
  "t1": 20.2,
  "text": "But the song keeps"
 },
 {
  "scene": "11",
  "t0": 20.2,
  "t1": 21.41,
  "text": "changing."
 },
 {
  "scene": "11",
  "t0": 21.41,
  "t1": 22.62,
  "text": "In the South Pacific,"
 },
 {
  "scene": "11",
  "t0": 22.62,
  "t1": 23.71,
  "text": "scientists watched"
 },
 {
  "scene": "11",
  "t0": 23.71,
  "t1": 25.19,
  "text": "new songs pass from"
 },
 {
  "scene": "11",
  "t0": 25.19,
  "t1": 26.46,
  "text": "whale to whale, from"
 },
 {
  "scene": "11",
  "t0": 26.46,
  "t1": 27.73,
  "text": "Australia east"
 },
 {
  "scene": "11",
  "t0": 27.73,
  "t1": 29.14,
  "text": "all the way to French Polynesia,"
 },
 {
  "scene": "11",
  "t0": 29.14,
  "t1": 30.34,
  "text": "in about two"
 },
 {
  "scene": "11",
  "t0": 30.34,
  "t1": 31.83,
  "text": "years."
 },
 {
  "scene": "11",
  "t0": 31.83,
  "t1": 32.85,
  "text": "No one knows for sure"
 },
 {
  "scene": "11",
  "t0": 32.85,
  "t1": 34.25,
  "text": "why they sing."
 },
 {
  "scene": "11",
  "t0": 34.25,
  "t1": 35.09,
  "text": "Maybe to attract a"
 },
 {
  "scene": "11",
  "t0": 35.09,
  "t1": 35.88,
  "text": "female."
 },
 {
  "scene": "11",
  "t0": 35.88,
  "t1": 37.15,
  "text": "Or to warn off other males."
 },
 {
  "scene": "11",
  "t0": 37.15,
  "t1": 38.13,
  "text": "Either"
 },
 {
  "scene": "11",
  "t0": 38.13,
  "t1": 39.01,
  "text": "way, for"
 },
 {
  "scene": "11",
  "t0": 39.01,
  "t1": 40.67,
  "text": "weeks the ocean is full of their music."
 },
 {
  "scene": "11",
  "t0": 40.67,
  "t1": 42.09,
  "text": "And that makes what"
 },
 {
  "scene": "11",
  "t0": 42.09,
  "t1": 43.32,
  "text": "we did to them even"
 },
 {
  "scene": "11",
  "t0": 43.32,
  "t1": 44.25,
  "text": "harder to hear."
 },
 {
  "scene": "12",
  "t0": 0.0,
  "t1": 1.65,
  "text": "For about a century, humpbacks"
 },
 {
  "scene": "12",
  "t0": 1.65,
  "t1": 3.06,
  "text": "were hunted almost everywhere"
 },
 {
  "scene": "12",
  "t0": 3.06,
  "t1": 4.52,
  "text": "they swam."
 },
 {
  "scene": "12",
  "t0": 4.52,
  "t1": 5.53,
  "text": "They are slow."
 },
 {
  "scene": "12",
  "t0": 5.53,
  "t1": 6.5,
  "text": "They stay close to the"
 },
 {
  "scene": "12",
  "t0": 6.5,
  "t1": 7.15,
  "text": "coast."
 },
 {
  "scene": "12",
  "t0": 7.15,
  "t1": 8.94,
  "text": "And they float when they die."
 },
 {
  "scene": "12",
  "t0": 8.94,
  "t1": 10.85,
  "text": "That made them easy to take."
 },
 {
  "scene": "12",
  "t0": 10.85,
  "t1": 11.89,
  "text": "When commercial whaling"
 },
 {
  "scene": "12",
  "t0": 11.89,
  "t1": 13.03,
  "text": "finally stopped in 1985,"
 },
 {
  "scene": "12",
  "t0": 13.03,
  "t1": 14.04,
  "text": "…"
 },
 {
  "scene": "12",
  "t0": 14.04,
  "t1": 15.33,
  "text": "most populations had"
 },
 {
  "scene": "12",
  "t0": 15.33,
  "t1": 16.39,
  "text": "fallen by more than ninety-five"
 },
 {
  "scene": "12",
  "t0": 16.39,
  "t1": 17.13,
  "text": "percent."
 },
 {
  "scene": "12",
  "t0": 17.13,
  "t1": 18.11,
  "text": "…"
 },
 {
  "scene": "12",
  "t0": 18.11,
  "t1": 19.7,
  "text": "For every hundred whales,"
 },
 {
  "scene": "12",
  "t0": 19.7,
  "t1": 21.98,
  "text": "fewer than five were left."
 },
 {
  "scene": "12",
  "t0": 21.98,
  "t1": 23.58,
  "text": "Then people stopped."
 },
 {
  "scene": "12",
  "t0": 23.58,
  "t1": 24.63,
  "text": "And something remarkable"
 },
 {
  "scene": "12",
  "t0": 24.63,
  "t1": 25.74,
  "text": "happened."
 },
 {
  "scene": "12",
  "t0": 25.74,
  "t1": 27.56,
  "text": "The humpbacks came back."
 },
 {
  "scene": "12",
  "t0": 27.56,
  "t1": 29.24,
  "text": "In many oceans, there are tens of"
 },
 {
  "scene": "12",
  "t0": 29.24,
  "t1": 30.53,
  "text": "thousands again."
 },
 {
  "scene": "12",
  "t0": 30.53,
  "t1": 31.6,
  "text": "Which means more whales"
 },
 {
  "scene": "12",
  "t0": 31.6,
  "t1": 32.7,
  "text": "are feeding where people"
 },
 {
  "scene": "12",
  "t0": 32.7,
  "t1": 33.44,
  "text": "kayak,"
 },
 {
  "scene": "12",
  "t0": 33.44,
  "t1": 34.16,
  "text": "dive"
 },
 {
  "scene": "12",
  "t0": 34.16,
  "t1": 35.33,
  "text": "and swim."
 },
 {
  "scene": "12",
  "t0": 35.33,
  "t1": 36.19,
  "text": "That is why encounters"
 },
 {
  "scene": "12",
  "t0": 36.19,
  "t1": 37.06,
  "text": "like Adrián's"
 },
 {
  "scene": "12",
  "t0": 37.06,
  "t1": 38.39,
  "text": "are filmed more than"
 },
 {
  "scene": "12",
  "t0": 38.39,
  "t1": 38.94,
  "text": "ever."
 },
 {
  "scene": "13",
  "t0": 0.0,
  "t1": 1.33,
  "text": "And these whales travel"
 },
 {
  "scene": "13",
  "t0": 1.33,
  "t1": 2.6,
  "text": "further than almost any"
 },
 {
  "scene": "13",
  "t0": 2.6,
  "t1": 3.91,
  "text": "living thing."
 },
 {
  "scene": "13",
  "t0": 3.91,
  "t1": 5.77,
  "text": "Every year they swim from the cold"
 },
 {
  "scene": "13",
  "t0": 5.77,
  "t1": 7.34,
  "text": "feeding waters near the poles"
 },
 {
  "scene": "13",
  "t0": 7.34,
  "t1": 9.03,
  "text": "to the calm, warm waters"
 },
 {
  "scene": "13",
  "t0": 9.03,
  "t1": 10.82,
  "text": "near the tropics, where they"
 },
 {
  "scene": "13",
  "t0": 10.82,
  "t1": 12.46,
  "text": "give birth."
 },
 {
  "scene": "13",
  "t0": 12.46,
  "t1": 13.77,
  "text": "Some humpbacks swim more"
 },
 {
  "scene": "13",
  "t0": 13.77,
  "t1": 15.15,
  "text": "than eight thousand kilometres,"
 },
 {
  "scene": "13",
  "t0": 15.15,
  "t1": 16.9,
  "text": "one way."
 },
 {
  "scene": "13",
  "t0": 16.9,
  "t1": 17.76,
  "text": "One of the longest"
 },
 {
  "scene": "13",
  "t0": 17.76,
  "t1": 18.6,
  "text": "migrations of"
 },
 {
  "scene": "13",
  "t0": 18.6,
  "t1": 19.54,
  "text": "any mammal on Earth."
 },
 {
  "scene": "13",
  "t0": 19.54,
  "t1": 20.45,
  "text": "…"
 },
 {
  "scene": "13",
  "t0": 20.45,
  "t1": 22.45,
  "text": "In the warm water, there is almost"
 },
 {
  "scene": "13",
  "t0": 22.45,
  "t1": 24.1,
  "text": "nothing for them to eat."
 },
 {
  "scene": "13",
  "t0": 24.1,
  "t1": 25.52,
  "text": "So for months, the mothers"
 },
 {
  "scene": "13",
  "t0": 25.52,
  "t1": 27.35,
  "text": "live off their own fat."
 },
 {
  "scene": "13",
  "t0": 27.35,
  "t1": 28.46,
  "text": "And feed a growing calf."
 },
 {
  "scene": "13",
  "t0": 28.46,
  "t1": 30.02,
  "text": "Then they swim"
 },
 {
  "scene": "13",
  "t0": 30.02,
  "t1": 31.53,
  "text": "all the way back."
 },
 {
  "scene": "13",
  "t0": 31.53,
  "t1": 32.7,
  "text": "So the whale that grabbed"
 },
 {
  "scene": "13",
  "t0": 32.7,
  "t1": 33.43,
  "text": "Adrián was"
 },
 {
  "scene": "13",
  "t0": 33.43,
  "t1": 34.29,
  "text": "hungry."
 },
 {
  "scene": "13",
  "t0": 34.29,
  "t1": 35.78,
  "text": "It was feeding after a journey like"
 },
 {
  "scene": "13",
  "t0": 35.78,
  "t1": 36.88,
  "text": "that. But"
 },
 {
  "scene": "13",
  "t0": 36.88,
  "t1": 37.84,
  "text": "the strangest thing about"
 },
 {
  "scene": "13",
  "t0": 37.84,
  "t1": 39.35,
  "text": "humpbacks is not"
 },
 {
  "scene": "13",
  "t0": 39.35,
  "t1": 40.55,
  "text": "how they eat."
 },
 {
  "scene": "13",
  "t0": 40.55,
  "t1": 41.26,
  "text": "It is who they protect."
 },
 {
  "scene": "13",
  "t0": 41.26,
  "t1": 41.8,
  "text": "…"
 },
 {
  "scene": "14",
  "t0": 0.0,
  "t1": 1.82,
  "text": "In 2009, in Antarctica,"
 },
 {
  "scene": "14",
  "t0": 1.82,
  "t1": 3.24,
  "text": "a scientist"
 },
 {
  "scene": "14",
  "t0": 3.24,
  "t1": 4.92,
  "text": "named Robert Pitman watched"
 },
 {
  "scene": "14",
  "t0": 4.92,
  "t1": 6.34,
  "text": "a pack of killer whales hunt"
 },
 {
  "scene": "14",
  "t0": 6.34,
  "t1": 8.31,
  "text": "a seal. The seal was lying"
 },
 {
  "scene": "14",
  "t0": 8.31,
  "t1": 10.05,
  "text": "on a small piece of ice."
 },
 {
  "scene": "14",
  "t0": 10.05,
  "t1": 11.61,
  "text": "The orcas swam at it together,"
 },
 {
  "scene": "14",
  "t0": 11.61,
  "t1": 12.95,
  "text": "making waves to wash"
 },
 {
  "scene": "14",
  "t0": 12.95,
  "t1": 14.71,
  "text": "it into the water."
 },
 {
  "scene": "14",
  "t0": 14.71,
  "t1": 16.39,
  "text": "Then two humpback whales arrived."
 },
 {
  "scene": "14",
  "t0": 16.39,
  "t1": 18.53,
  "text": "The seal slid into the water,"
 },
 {
  "scene": "14",
  "t0": 18.53,
  "t1": 20.53,
  "text": "right toward them."
 },
 {
  "scene": "14",
  "t0": 20.53,
  "t1": 22.05,
  "text": "And one whale rolled onto its back"
 },
 {
  "scene": "14",
  "t0": 22.05,
  "t1": 23.84,
  "text": "and lifted the seal onto its"
 },
 {
  "scene": "14",
  "t0": 23.84,
  "t1": 25.45,
  "text": "chest, out of the water,"
 },
 {
  "scene": "14",
  "t0": 25.45,
  "t1": 26.77,
  "text": "between its huge"
 },
 {
  "scene": "14",
  "t0": 26.77,
  "t1": 28.15,
  "text": "flippers."
 },
 {
  "scene": "14",
  "t0": 28.15,
  "t1": 30.03,
  "text": "When the seal started to slide off,"
 },
 {
  "scene": "14",
  "t0": 30.03,
  "t1": 31.56,
  "text": "the whale nudged it back with a"
 },
 {
  "scene": "14",
  "t0": 31.56,
  "t1": 32.58,
  "text": "flipper."
 },
 {
  "scene": "14",
  "t0": 32.58,
  "t1": 34.17,
  "text": "Then the seal swam to another"
 },
 {
  "scene": "14",
  "t0": 34.17,
  "t1": 35.21,
  "text": "piece of ice, and"
 },
 {
  "scene": "14",
  "t0": 35.21,
  "t1": 36.51,
  "text": "escaped."
 },
 {
  "scene": "14",
  "t0": 36.51,
  "t1": 37.26,
  "text": "Pitman could not believe"
 },
 {
  "scene": "14",
  "t0": 37.26,
  "t1": 38.26,
  "text": "it."
 },
 {
  "scene": "14",
  "t0": 38.26,
  "t1": 39.79,
  "text": "So he started collecting other reports."
 },
 {
  "scene": "14",
  "t0": 39.79,
  "t1": 41.34,
  "text": "And what he found"
 },
 {
  "scene": "14",
  "t0": 41.34,
  "t1": 42.78,
  "text": "was even stranger."
 },
 {
  "scene": "15",
  "t0": 0.0,
  "t1": 1.32,
  "text": "He found one hundred and fifteen"
 },
 {
  "scene": "15",
  "t0": 1.32,
  "t1": 2.85,
  "text": "cases of humpbacks"
 },
 {
  "scene": "15",
  "t0": 2.85,
  "t1": 4.46,
  "text": "meeting killer whales."
 },
 {
  "scene": "15",
  "t0": 4.46,
  "t1": 5.95,
  "text": "In most of them, the humpbacks"
 },
 {
  "scene": "15",
  "t0": 5.95,
  "t1": 7.55,
  "text": "charged in to break up the attack."
 },
 {
  "scene": "15",
  "t0": 7.55,
  "t1": 9.12,
  "text": "And most of the time,"
 },
 {
  "scene": "15",
  "t0": 9.12,
  "t1": 10.86,
  "text": "the victim was not a humpback."
 },
 {
  "scene": "15",
  "t0": 10.86,
  "t1": 12.69,
  "text": "It was a seal."
 },
 {
  "scene": "15",
  "t0": 12.69,
  "t1": 13.82,
  "text": "A sea lion."
 },
 {
  "scene": "15",
  "t0": 13.82,
  "t1": 15.36,
  "text": "A grey whale calf."
 },
 {
  "scene": "15",
  "t0": 15.36,
  "t1": 16.96,
  "text": "Even a fish."
 },
 {
  "scene": "15",
  "t0": 16.96,
  "t1": 18.06,
  "text": "Humpbacks are one of the few"
 },
 {
  "scene": "15",
  "t0": 18.06,
  "t1": 19.69,
  "text": "animals that fight back against"
 },
 {
  "scene": "15",
  "t0": 19.69,
  "t1": 21.5,
  "text": "orcas. Their flippers are"
 },
 {
  "scene": "15",
  "t0": 21.5,
  "t1": 22.78,
  "text": "covered in sharp barnacles,"
 },
 {
  "scene": "15",
  "t0": 22.78,
  "t1": 24.22,
  "text": "and one blow"
 },
 {
  "scene": "15",
  "t0": 24.22,
  "t1": 25.41,
  "text": "can wound."
 },
 {
  "scene": "15",
  "t0": 25.41,
  "t1": 27.23,
  "text": "So why save a seal?"
 },
 {
  "scene": "15",
  "t0": 27.23,
  "t1": 28.38,
  "text": "Scientists think it may"
 },
 {
  "scene": "15",
  "t0": 28.38,
  "t1": 29.58,
  "text": "begin with protecting their"
 },
 {
  "scene": "15",
  "t0": 29.58,
  "t1": 30.92,
  "text": "own calves."
 },
 {
  "scene": "15",
  "t0": 30.92,
  "t1": 32.37,
  "text": "They hear an orca attack"
 },
 {
  "scene": "15",
  "t0": 32.37,
  "t1": 33.23,
  "text": "and go, without"
 },
 {
  "scene": "15",
  "t0": 33.23,
  "t1": 34.09,
  "text": "checking who the victim"
 },
 {
  "scene": "15",
  "t0": 34.09,
  "t1": 35.64,
  "text": "is."
 },
 {
  "scene": "15",
  "t0": 35.64,
  "t1": 37.01,
  "text": "Whatever the reason, one"
 },
 {
  "scene": "15",
  "t0": 37.01,
  "t1": 38.35,
  "text": "of the largest animals in the"
 },
 {
  "scene": "15",
  "t0": 38.35,
  "t1": 39.96,
  "text": "sea spends its strength"
 },
 {
  "scene": "15",
  "t0": 39.96,
  "t1": 41.33,
  "text": "saving animals it does not"
 },
 {
  "scene": "15",
  "t0": 41.33,
  "t1": 42.2,
  "text": "need."
 },
 {
  "scene": "15",
  "t0": 42.2,
  "t1": 43.44,
  "text": "It does not eat them."
 },
 {
  "scene": "15",
  "t0": 43.44,
  "t1": 44.23,
  "text": "And it does not mate"
 },
 {
  "scene": "15",
  "t0": 44.23,
  "t1": 45.18,
  "text": "with them."
 },
 {
  "scene": "15",
  "t0": 45.18,
  "t1": 46.58,
  "text": "And you cannot help wondering what"
 },
 {
  "scene": "15",
  "t0": 46.58,
  "t1": 47.91,
  "text": "it felt when it found a person"
 },
 {
  "scene": "15",
  "t0": 47.91,
  "t1": 48.84,
  "text": "in its mouth."
 },
 {
  "scene": "16",
  "t0": 0.0,
  "t1": 1.07,
  "text": "So how do you make sure"
 },
 {
  "scene": "16",
  "t0": 1.07,
  "t1": 2.0,
  "text": "this never happens"
 },
 {
  "scene": "16",
  "t0": 2.0,
  "t1": 3.96,
  "text": "to you? Watch for the signs"
 },
 {
  "scene": "16",
  "t0": 3.96,
  "t1": 5.07,
  "text": "of feeding."
 },
 {
  "scene": "16",
  "t0": 5.07,
  "t1": 6.57,
  "text": "Seabirds diving into one"
 },
 {
  "scene": "16",
  "t0": 6.57,
  "t1": 8.58,
  "text": "spot. Fish jumping out of the"
 },
 {
  "scene": "16",
  "t0": 8.58,
  "t1": 9.85,
  "text": "water. A ring of"
 },
 {
  "scene": "16",
  "t0": 9.85,
  "t1": 10.94,
  "text": "bubbles."
 },
 {
  "scene": "16",
  "t0": 10.94,
  "t1": 12.57,
  "text": "If you see them, paddle away from"
 },
 {
  "scene": "16",
  "t0": 12.57,
  "t1": 13.85,
  "text": "that spot."
 },
 {
  "scene": "16",
  "t0": 13.85,
  "t1": 15.45,
  "text": "Do not move closer to get a better"
 },
 {
  "scene": "16",
  "t0": 15.45,
  "t1": 16.53,
  "text": "look."
 },
 {
  "scene": "16",
  "t0": 16.53,
  "t1": 17.92,
  "text": "Keep your distance."
 },
 {
  "scene": "16",
  "t0": 17.92,
  "t1": 19.51,
  "text": "In many countries, the rule for"
 },
 {
  "scene": "16",
  "t0": 19.51,
  "t1": 21.42,
  "text": "boats is about a hundred metres from"
 },
 {
  "scene": "16",
  "t0": 21.42,
  "t1": 22.42,
  "text": "a whale."
 },
 {
  "scene": "16",
  "t0": 22.42,
  "t1": 23.92,
  "text": "If you dive where there are whales,"
 },
 {
  "scene": "16",
  "t0": 23.92,
  "t1": 25.37,
  "text": "take a surface buoy,"
 },
 {
  "scene": "16",
  "t0": 25.37,
  "t1": 26.83,
  "text": "so boats and whales can"
 },
 {
  "scene": "16",
  "t0": 26.83,
  "t1": 28.49,
  "text": "see where you are."
 },
 {
  "scene": "16",
  "t0": 28.49,
  "t1": 29.82,
  "text": "And if the worst happens and"
 },
 {
  "scene": "16",
  "t0": 29.82,
  "t1": 31.27,
  "text": "you end up in its mouth?"
 },
 {
  "scene": "16",
  "t0": 31.27,
  "t1": 32.63,
  "text": "Both survivors say the same"
 },
 {
  "scene": "16",
  "t0": 32.63,
  "t1": 34.13,
  "text": "thing: they had no time"
 },
 {
  "scene": "16",
  "t0": 34.13,
  "t1": 35.42,
  "text": "to do anything."
 },
 {
  "scene": "16",
  "t0": 35.42,
  "t1": 37.31,
  "text": "The whale let them go on its own."
 },
 {
  "scene": "16",
  "t0": 37.31,
  "t1": 38.46,
  "text": "The whale wants to be rid of"
 },
 {
  "scene": "16",
  "t0": 38.46,
  "t1": 39.92,
  "text": "you even more than you want to get"
 },
 {
  "scene": "16",
  "t0": 39.92,
  "t1": 40.45,
  "text": "out."
 },
 {
  "scene": "17",
  "t0": 0.0,
  "t1": 1.65,
  "text": "So what happens when a humpback"
 },
 {
  "scene": "17",
  "t0": 1.65,
  "t1": 3.38,
  "text": "whale swallows you?"
 },
 {
  "scene": "17",
  "t0": 3.38,
  "t1": 4.25,
  "text": "It won't."
 },
 {
  "scene": "17",
  "t0": 4.25,
  "t1": 5.45,
  "text": "It can't. For"
 },
 {
  "scene": "17",
  "t0": 5.45,
  "t1": 6.48,
  "text": "a few seconds,"
 },
 {
  "scene": "17",
  "t0": 6.48,
  "t1": 8.21,
  "text": "maybe half a minute, you"
 },
 {
  "scene": "17",
  "t0": 8.21,
  "t1": 10.07,
  "text": "will be in the mouth of one of the gentlest"
 },
 {
  "scene": "17",
  "t0": 10.07,
  "t1": 11.41,
  "text": "giants on Earth."
 },
 {
  "scene": "17",
  "t0": 11.41,
  "t1": 12.56,
  "text": "In the dark. Squeezed."
 },
 {
  "scene": "17",
  "t0": 12.56,
  "t1": 13.59,
  "text": "…"
 },
 {
  "scene": "17",
  "t0": 13.59,
  "t1": 15.7,
  "text": "Sure that you are about to die."
 },
 {
  "scene": "17",
  "t0": 15.7,
  "t1": 16.88,
  "text": "And then it will do what it was"
 },
 {
  "scene": "17",
  "t0": 16.88,
  "t1": 18.79,
  "text": "always going to do."
 },
 {
  "scene": "17",
  "t0": 18.79,
  "t1": 20.41,
  "text": "It opens its mouth and lets you"
 },
 {
  "scene": "17",
  "t0": 20.41,
  "t1": 22.1,
  "text": "go. The same animal"
 },
 {
  "scene": "17",
  "t0": 22.1,
  "t1": 23.69,
  "text": "that throws a person back into"
 },
 {
  "scene": "17",
  "t0": 23.69,
  "t1": 24.82,
  "text": "the sea will lift a seal"
 },
 {
  "scene": "17",
  "t0": 24.82,
  "t1": 26.16,
  "text": "out of it."
 },
 {
  "scene": "17",
  "t0": 26.16,
  "t1": 26.94,
  "text": "It was never hunting"
 },
 {
  "scene": "17",
  "t0": 26.94,
  "t1": 27.7,
  "text": "you."
 },
 {
  "scene": "17",
  "t0": 27.7,
  "t1": 28.54,
  "text": "It just did not see"
