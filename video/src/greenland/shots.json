[
{
"scene": "01",
"t0": 0.0,
"t1": 1.66,
"text": "In 1620,"
},
{
"scene": "01",
"t0": 1.66,
"t1": 3.26,
"text": "a ship called the Mayflower crossed"
},
{
"scene": "01",
"t0": 3.26,
"t1": 4.6,
"text": "the Atlantic."
},
{
"scene": "01",
"t0": 4.6,
"t1": 6.21,
"text": "Somewhere in the cold, dark"
},
{
"scene": "01",
"t0": 6.21,
"t1": 7.95,
"text": "water of the North Atlantic,"
},
{
"scene": "01",
"t0": 7.95,
"t1": 9.7,
"text": "there may be a shark that was already"
},
{
"scene": "01",
"t0": 9.7,
"t1": 11.02,
"text": "alive when it did."
},
{
"scene": "01",
"t0": 11.02,
"t1": 13.01,
"text": "It is still swimming today."
},
{
"scene": "01",
"t0": 13.01,
"t1": 14.08,
"text": "Slowly. In the dark."
},
{
"scene": "01",
"t0": 14.08,
"t1": 15.15,
"text": "\u2026"
},
{
"scene": "01",
"t0": 15.15,
"t1": 16.66,
"text": "It has outlived every person"
},
{
"scene": "01",
"t0": 16.66,
"t1": 17.79,
"text": "who was alive when it was born."
},
{
"scene": "01",
"t0": 17.79,
"t1": 18.91,
"text": "\u2026"
},
{
"scene": "01",
"t0": 18.91,
"t1": 20.85,
"text": "This is the Greenland shark."
},
{
"scene": "01",
"t0": 20.85,
"t1": 22.49,
"text": "And scientists think it may live"
},
{
"scene": "01",
"t0": 22.49,
"t1": 23.62,
"text": "for around four hundred years."
},
{
"scene": "01",
"t0": 23.62,
"t1": 24.75,
"text": "\u2026"
},
{
"scene": "01",
"t0": 24.75,
"t1": 26.36,
"text": "But how can anyone know the"
},
{
"scene": "01",
"t0": 26.36,
"t1": 27.74,
"text": "age of a shark?"
},
{
"scene": "01",
"t0": 27.74,
"t1": 29.34,
"text": "And how does an animal live that"
},
{
"scene": "01",
"t0": 29.34,
"t1": 31.01,
"text": "long in one of the harshest places"
},
{
"scene": "01",
"t0": 31.01,
"t1": 32.09,
"text": "on Earth?"
},
{
"scene": "01",
"t0": 32.09,
"t1": 33.71,
"text": "In this video, you will find"
},
{
"scene": "01",
"t0": 33.71,
"t1": 35.35,
"text": "out how a shark's age is"
},
{
"scene": "01",
"t0": 35.35,
"t1": 36.75,
"text": "hidden in its eye."
},
{
"scene": "01",
"t0": 36.75,
"t1": 38.66,
"text": "How something this slow catches"
},
{
"scene": "01",
"t0": 38.66,
"t1": 40.39,
"text": "seals. And what its body"
},
{
"scene": "01",
"t0": 40.39,
"t1": 42.08,
"text": "knows about growing old."
},
{
"scene": "02",
"t0": 0.0,
"t1": 1.51,
"text": "The Greenland shark lives"
},
{
"scene": "02",
"t0": 1.51,
"t1": 2.54,
"text": "in the coldest seas on the planet."
},
{
"scene": "02",
"t0": 2.54,
"t1": 3.56,
"text": "\u2026"
},
{
"scene": "02",
"t0": 3.56,
"t1": 5.49,
"text": "Around Greenland, Iceland,"
},
{
"scene": "02",
"t0": 5.49,
"t1": 7.23,
"text": "Norway and Canada, and down"
},
{
"scene": "02",
"t0": 7.23,
"t1": 9.2,
"text": "into the deep North Atlantic."
},
{
"scene": "02",
"t0": 9.2,
"t1": 11.12,
"text": "It belongs to a family called sleeper"
},
{
"scene": "02",
"t0": 11.12,
"t1": 12.65,
"text": "sharks. And it looks the"
},
{
"scene": "02",
"t0": 12.65,
"t1": 13.86,
"text": "part."
},
{
"scene": "02",
"t0": 13.86,
"t1": 15.86,
"text": "It is thick and heavy,"
},
{
"scene": "02",
"t0": 15.86,
"t1": 17.57,
"text": "grey-brown, with a blunt"
},
{
"scene": "02",
"t0": 17.57,
"t1": 19.54,
"text": "head and tiny eyes."
},
{
"scene": "02",
"t0": 19.54,
"t1": 21.28,
"text": "Big ones grow longer than five"
},
{
"scene": "02",
"t0": 21.28,
"t1": 22.85,
"text": "metres. Bigger than a"
},
{
"scene": "02",
"t0": 22.85,
"t1": 24.35,
"text": "car. It spends most"
},
{
"scene": "02",
"t0": 24.35,
"t1": 26.03,
"text": "of its life in water close"
},
{
"scene": "02",
"t0": 26.03,
"t1": 27.66,
"text": "to freezing, from near the"
},
{
"scene": "02",
"t0": 27.66,
"t1": 29.2,
"text": "surface under the ice"
},
{
"scene": "02",
"t0": 29.2,
"t1": 30.5,
"text": "to more than two kilometres down."
},
{
"scene": "02",
"t0": 30.5,
"t1": 31.8,
"text": "\u2026"
},
{
"scene": "02",
"t0": 31.8,
"t1": 32.96,
"text": "Few people have ever seen one alive."
},
{
"scene": "02",
"t0": 32.96,
"t1": 34.12,
"text": "\u2026"
},
{
"scene": "02",
"t0": 34.12,
"t1": 36.02,
"text": "Most of what we know comes from sharks"
},
{
"scene": "02",
"t0": 36.02,
"t1": 37.63,
"text": "caught by accident, by"
},
{
"scene": "02",
"t0": 37.63,
"t1": 39.28,
"text": "fishermen, and from cameras"
},
{
"scene": "02",
"t0": 39.28,
"t1": 40.82,
"text": "dropped into the deep."
},
{
"scene": "02",
"t0": 40.82,
"t1": 42.36,
"text": "And it grows unbelievably"
},
{
"scene": "02",
"t0": 42.36,
"t1": 43.87,
"text": "slowly. Around one"
},
{
"scene": "02",
"t0": 43.87,
"t1": 45.35,
"text": "centimetre a year."
},
{
"scene": "03",
"t0": 0.0,
"t1": 1.79,
"text": "Scientists have always struggled"
},
{
"scene": "03",
"t0": 1.79,
"t1": 3.4,
"text": "to age sharks."
},
{
"scene": "03",
"t0": 3.4,
"t1": 5.18,
"text": "For most sharks, they count growth"
},
{
"scene": "03",
"t0": 5.18,
"t1": 6.86,
"text": "rings in the vertebrae, the"
},
{
"scene": "03",
"t0": 6.86,
"t1": 8.35,
"text": "discs of the spine."
},
{
"scene": "03",
"t0": 8.35,
"t1": 9.38,
"text": "One ring, roughly one year."
},
{
"scene": "03",
"t0": 9.38,
"t1": 10.42,
"text": "\u2026"
},
{
"scene": "03",
"t0": 10.42,
"t1": 11.65,
"text": "Like a tree."
},
{
"scene": "03",
"t0": 11.65,
"t1": 13.26,
"text": "But the Greenland shark's vertebrae"
},
{
"scene": "03",
"t0": 13.26,
"t1": 14.26,
"text": "are soft."
},
{
"scene": "03",
"t0": 14.26,
"t1": 15.36,
"text": "They have no clear rings to count."
},
{
"scene": "03",
"t0": 15.36,
"t1": 16.47,
"text": "\u2026"
},
{
"scene": "03",
"t0": 16.47,
"t1": 18.14,
"text": "Its fins and skin give no"
},
{
"scene": "03",
"t0": 18.14,
"t1": 19.3,
"text": "clue either."
},
{
"scene": "03",
"t0": 19.3,
"t1": 21.03,
"text": "So for a long time, nobody"
},
{
"scene": "03",
"t0": 21.03,
"t1": 22.85,
"text": "could say how old a Greenland shark"
},
{
"scene": "03",
"t0": 22.85,
"t1": 24.45,
"text": "was. Only that it grew"
},
{
"scene": "03",
"t0": 24.45,
"t1": 26.05,
"text": "very slowly, and must be"
},
{
"scene": "03",
"t0": 26.05,
"t1": 27.33,
"text": "very old."
},
{
"scene": "03",
"t0": 27.33,
"t1": 29.17,
"text": "Then, a team of scientists"
},
{
"scene": "03",
"t0": 29.17,
"t1": 30.77,
"text": "led by a Danish biologist"
},
{
"scene": "03",
"t0": 30.77,
"t1": 32.35,
"text": "named Julius Nielsen"
},
{
"scene": "03",
"t0": 32.35,
"t1": 33.9,
"text": "found a clock that had been"
},
{
"scene": "03",
"t0": 33.9,
"t1": 35.53,
"text": "hiding in plain sight."
},
{
"scene": "04",
"t0": 0.0,
"t1": 1.18,
"text": "The clock was in the eye."
},
{
"scene": "04",
"t0": 1.18,
"t1": 2.36,
"text": "\u2026"
},
{
"scene": "04",
"t0": 2.36,
"t1": 3.97,
"text": "The lens of a shark's eye"
},
{
"scene": "04",
"t0": 3.97,
"t1": 5.5,
"text": "grows in layers, like"
},
{
"scene": "04",
"t0": 5.5,
"t1": 6.67,
"text": "an onion."
},
{
"scene": "04",
"t0": 6.67,
"t1": 7.68,
"text": "New layers are added on the outside"
},
{
"scene": "04",
"t0": 7.68,
"t1": 8.69,
"text": "\u2026"
},
{
"scene": "04",
"t0": 8.69,
"t1": 10.06,
"text": "all through life."
},
{
"scene": "04",
"t0": 10.06,
"t1": 11.89,
"text": "But the very centre of the lens,"
},
{
"scene": "04",
"t0": 11.89,
"t1": 13.41,
"text": "the nucleus, is made"
},
{
"scene": "04",
"t0": 13.41,
"t1": 15.21,
"text": "before the shark is born."
},
{
"scene": "04",
"t0": 15.21,
"t1": 16.76,
"text": "And it never changes again."
},
{
"scene": "04",
"t0": 16.76,
"t1": 18.28,
"text": "The proteins inside it stay"
},
{
"scene": "04",
"t0": 18.28,
"t1": 19.83,
"text": "exactly as they were, for"
},
{
"scene": "04",
"t0": 19.83,
"t1": 21.72,
"text": "the whole of the shark's life."
},
{
"scene": "04",
"t0": 21.72,
"t1": 23.28,
"text": "So if you could date the centre of the"
},
{
"scene": "04",
"t0": 23.28,
"t1": 25.05,
"text": "lens, you would know when the shark"
},
{
"scene": "04",
"t0": 25.05,
"t1": 26.61,
"text": "was born. And there is a way"
},
{
"scene": "04",
"t0": 26.61,
"t1": 27.62,
"text": "to date it. With carbon."
},
{
"scene": "04",
"t0": 27.62,
"t1": 28.63,
"text": "\u2026"
},
{
"scene": "05",
"t0": 0.0,
"t1": 1.3,
"text": "In the 1950s and early"
},
{
"scene": "05",
"t0": 1.3,
"t1": 2.61,
"text": "\u2026"
},
{
"scene": "05",
"t0": 2.61,
"t1": 4.32,
"text": "1960s, countries tested nuclear"
},
{
"scene": "05",
"t0": 4.32,
"t1": 6.05,
"text": "bombs in the open air."
},
{
"scene": "05",
"t0": 6.05,
"t1": 7.8,
"text": "Those tests did something strange"
},
{
"scene": "05",
"t0": 7.8,
"t1": 8.95,
"text": "to the planet."
},
{
"scene": "05",
"t0": 8.95,
"t1": 10.49,
"text": "They nearly doubled the amount of a"
},
{
"scene": "05",
"t0": 10.49,
"t1": 11.73,
"text": "kind of carbon, carbon-14,"
},
{
"scene": "05",
"t0": 11.73,
"t1": 12.97,
"text": "\u2026"
},
{
"scene": "05",
"t0": 12.97,
"t1": 14.2,
"text": "in the air."
},
{
"scene": "05",
"t0": 14.2,
"t1": 15.89,
"text": "That extra carbon washed into"
},
{
"scene": "05",
"t0": 15.89,
"t1": 16.97,
"text": "the oceans, into plankton,"
},
{
"scene": "05",
"t0": 16.97,
"t1": 18.05,
"text": "\u2026"
},
{
"scene": "05",
"t0": 18.05,
"t1": 19.59,
"text": "into fish, and into"
},
{
"scene": "05",
"t0": 19.59,
"t1": 21.24,
"text": "the animals that eat them."
},
{
"scene": "05",
"t0": 21.24,
"t1": 22.59,
"text": "Everything that grew after the early"
},
{
"scene": "05",
"t0": 22.59,
"t1": 23.95,
"text": "\u2026"
},
{
"scene": "05",
"t0": 23.95,
"t1": 25.67,
"text": "1960s carries a mark of it."
},
{
"scene": "05",
"t0": 25.67,
"t1": 27.22,
"text": "Scientists call it the"
},
{
"scene": "05",
"t0": 27.22,
"t1": 28.65,
"text": "bomb pulse."
},
{
"scene": "05",
"t0": 28.65,
"t1": 30.5,
"text": "When the team tested the eye lenses"
},
{
"scene": "05",
"t0": 30.5,
"t1": 31.82,
"text": "of twenty-eight Greenland"
},
{
"scene": "05",
"t0": 31.82,
"t1": 33.5,
"text": "sharks, only the smallest"
},
{
"scene": "05",
"t0": 33.5,
"t1": 35.22,
"text": "ones, about two metres long"
},
{
"scene": "05",
"t0": 35.22,
"t1": 36.84,
"text": "or less, carried the bomb"
},
{
"scene": "05",
"t0": 36.84,
"t1": 38.47,
"text": "mark. Every larger"
},
{
"scene": "05",
"t0": 38.47,
"t1": 39.88,
"text": "shark was born before the"
},
{
"scene": "05",
"t0": 39.88,
"t1": 41.15,
"text": "bombs."
},
{
"scene": "05",
"t0": 41.15,
"t1": 42.68,
"text": "That one clue gave the team a"
},
{
"scene": "05",
"t0": 42.68,
"t1": 43.82,
"text": "fixed point."
},
{
"scene": "05",
"t0": 43.82,
"t1": 45.54,
"text": "A two-metre shark was born around"
},
{
"scene": "05",
"t0": 45.54,
"t1": 47.29,
"text": "the early 1960s."
},
{
"scene": "05",
"t0": 47.29,
"t1": 48.81,
"text": "So anything much bigger had to"
},
{
"scene": "05",
"t0": 48.81,
"t1": 50.24,
"text": "be much older."
},
{
"scene": "05",
"t0": 50.24,
"t1": 52.06,
"text": "Using the carbon in the lenses,"
},
{
"scene": "05",
"t0": 52.06,
"t1": 53.07,
"text": "and how fast these sharks grow,"
},
{
"scene": "05",
"t0": 53.07,
"t1": 54.08,
"text": "\u2026"
},
{
"scene": "05",
"t0": 54.08,
"t1": 55.69,
"text": "they worked out how old the big ones"
},
{
"scene": "05",
"t0": 55.69,
"t1": 56.66,
"text": "must be."
},
{
"scene": "06",
"t0": 0.0,
"t1": 1.35,
"text": "The results came out in"
},
{
"scene": "06",
"t0": 1.35,
"t1": 2.56,
"text": "2016."
},
{
"scene": "06",
"t0": 2.56,
"t1": 4.16,
"text": "They shocked the world."
},
{
"scene": "06",
"t0": 4.16,
"t1": 5.84,
"text": "The biggest shark in the study,"
},
{
"scene": "06",
"t0": 5.84,
"t1": 7.6,
"text": "a female just over five metres"
},
{
"scene": "06",
"t0": 7.6,
"t1": 9.11,
"text": "long, was estimated to be"
},
{
"scene": "06",
"t0": 9.11,
"t1": 10.63,
"text": "about three hundred and ninety-two"
},
{
"scene": "06",
"t0": 10.63,
"t1": 11.64,
"text": "years old."
},
{
"scene": "06",
"t0": 11.64,
"t1": 13.4,
"text": "The estimate is not exact."
},
{
"scene": "06",
"t0": 13.4,
"t1": 15.15,
"text": "It could be as much as a hundred and twenty"
},
{
"scene": "06",
"t0": 15.15,
"t1": 17.03,
"text": "years less, or more."
},
{
"scene": "06",
"t0": 17.03,
"t1": 18.65,
"text": "But even at the low end, she was"
},
{
"scene": "06",
"t0": 18.65,
"t1": 19.8,
"text": "at least two hundred and seventy-two."
},
{
"scene": "06",
"t0": 19.8,
"t1": 20.94,
"text": "\u2026"
},
{
"scene": "06",
"t0": 20.94,
"t1": 22.55,
"text": "Think about what that means."
},
{
"scene": "06",
"t0": 22.55,
"t1": 24.15,
"text": "If she really was three hundred and"
},
{
"scene": "06",
"t0": 24.15,
"t1": 25.75,
"text": "ninety-two, she was born"
},
{
"scene": "06",
"t0": 25.75,
"t1": 26.38,
"text": "around the year"
},
{
"scene": "06",
"t0": 26.38,
"t1": 28.04,
"text": "1624."
},
{
"scene": "06",
"t0": 28.04,
"t1": 29.6,
"text": "She was already swimming when Isaac"
},
{
"scene": "06",
"t0": 29.6,
"t1": 30.8,
"text": "Newton was born."
},
{
"scene": "06",
"t0": 30.8,
"t1": 32.45,
"text": "She was alive through the whole history"
},
{
"scene": "06",
"t0": 32.45,
"t1": 33.49,
"text": "of the United States."
},
{
"scene": "06",
"t0": 33.49,
"t1": 34.53,
"text": "\u2026"
},
{
"scene": "06",
"t0": 34.53,
"t1": 36.13,
"text": "That made the Greenland shark the"
},
{
"scene": "06",
"t0": 36.13,
"t1": 37.96,
"text": "longest-living animal with a backbone"
},
{
"scene": "06",
"t0": 37.96,
"t1": 39.17,
"text": "ever found."
},
{
"scene": "06",
"t0": 39.17,
"t1": 40.27,
"text": "And there was something even stranger."
},
{
"scene": "06",
"t0": 40.27,
"t1": 41.37,
"text": "\u2026"
},
{
"scene": "06",
"t0": 41.37,
"t1": 42.91,
"text": "Females only seem to be ready"
},
{
"scene": "06",
"t0": 42.91,
"t1": 44.71,
"text": "to have young when they are about"
},
{
"scene": "06",
"t0": 44.71,
"t1": 46.24,
"text": "four metres long."
},
{
"scene": "06",
"t0": 46.24,
"t1": 47.83,
"text": "By the team's estimate,"
},
{
"scene": "06",
"t0": 47.83,
"t1": 49.61,
"text": "that takes around a hundred and fifty"
},
{
"scene": "06",
"t0": 49.61,
"t1": 50.64,
"text": "years."
},
{
"scene": "06",
"t0": 50.64,
"t1": 52.4,
"text": "A hundred and fifty years,"
},
{
"scene": "06",
"t0": 52.4,
"t1": 53.66,
"text": "just to grow up."
},
{
"scene": "07",
"t0": 0.0,
"t1": 1.72,
"text": "How does an animal live that"
},
{
"scene": "07",
"t0": 1.72,
"t1": 3.3,
"text": "long? Part of the answer"
},
{
"scene": "07",
"t0": 3.3,
"t1": 5.03,
"text": "is that it lives slowly."
},
{
"scene": "07",
"t0": 5.03,
"t1": 6.79,
"text": "In 2012, scientists"
},
{
"scene": "07",
"t0": 6.79,
"t1": 8.75,
"text": "put tags on Greenland sharks"
},
{
"scene": "07",
"t0": 8.75,
"t1": 10.28,
"text": "to measure how they swim."
},
{
"scene": "07",
"t0": 10.28,
"t1": 11.87,
"text": "On average, they cruised at"
},
{
"scene": "07",
"t0": 11.87,
"t1": 12.97,
"text": "about a third of a metre per second."
},
{
"scene": "07",
"t0": 12.97,
"t1": 14.08,
"text": "\u2026"
},
{
"scene": "07",
"t0": 14.08,
"t1": 15.21,
"text": "Slower than a gentle stroll."
},
{
"scene": "07",
"t0": 15.21,
"t1": 16.35,
"text": "\u2026"
},
{
"scene": "07",
"t0": 16.35,
"t1": 17.9,
"text": "Their tails swept from side to"
},
{
"scene": "07",
"t0": 17.9,
"t1": 19.74,
"text": "side only about once every seven"
},
{
"scene": "07",
"t0": 19.74,
"t1": 20.8,
"text": "seconds."
},
{
"scene": "07",
"t0": 20.8,
"t1": 22.7,
"text": "For their size, they were the slowest"
},
{
"scene": "07",
"t0": 22.7,
"t1": 24.37,
"text": "fish ever measured."
},
{
"scene": "07",
"t0": 24.37,
"t1": 26.14,
"text": "In water this cold, everything"
},
{
"scene": "07",
"t0": 26.14,
"t1": 28.0,
"text": "in its body runs slowly."
},
{
"scene": "07",
"t0": 28.0,
"t1": 29.01,
"text": "Its heart."
},
{
"scene": "07",
"t0": 29.01,
"t1": 30.32,
"text": "Its digestion."
},
{
"scene": "07",
"t0": 30.32,
"t1": 31.33,
"text": "Its growth."
},
{
"scene": "07",
"t0": 31.33,
"t1": 33.25,
"text": "And maybe even its ageing."
},
{
"scene": "08",
"t0": 0.0,
"t1": 1.98,
"text": "But here is the mystery."
},
{
"scene": "08",
"t0": 1.98,
"t1": 3.62,
"text": "Something this slow should go"
},
{
"scene": "08",
"t0": 3.62,
"t1": 4.69,
"text": "hungry."
},
{
"scene": "08",
"t0": 4.69,
"t1": 6.6,
"text": "And yet, inside Greenland"
},
{
"scene": "08",
"t0": 6.6,
"t1": 8.25,
"text": "sharks, scientists have"
},
{
"scene": "08",
"t0": 8.25,
"t1": 9.5,
"text": "found seals."
},
{
"scene": "08",
"t0": 9.5,
"t1": 10.95,
"text": "Fresh ones."
},
{
"scene": "08",
"t0": 10.95,
"t1": 12.69,
"text": "Some eaten whole."
},
{
"scene": "08",
"t0": 12.69,
"t1": 14.2,
"text": "Seals are fast."
},
{
"scene": "08",
"t0": 14.2,
"t1": 15.34,
"text": "Much faster than a Greenland shark."
},
{
"scene": "08",
"t0": 15.34,
"t1": 16.49,
"text": "\u2026"
},
{
"scene": "08",
"t0": 16.49,
"t1": 17.52,
"text": "So how does it catch them?"
},
{
"scene": "08",
"t0": 17.52,
"t1": 18.56,
"text": "\u2026"
},
{
"scene": "08",
"t0": 18.56,
"t1": 20.25,
"text": "One idea is that it does not chase"
},
{
"scene": "08",
"t0": 20.25,
"t1": 21.32,
"text": "them at all."
},
{
"scene": "08",
"t0": 21.32,
"t1": 22.87,
"text": "In the Arctic, seals"
},
{
"scene": "08",
"t0": 22.87,
"t1": 24.55,
"text": "often sleep in the water,"
},
{
"scene": "08",
"t0": 24.55,
"t1": 26.22,
"text": "to stay safe from polar bears"
},
{
"scene": "08",
"t0": 26.22,
"t1": 27.37,
"text": "on the ice."
},
{
"scene": "08",
"t0": 27.37,
"t1": 29.13,
"text": "A sleeping seal, drifting"
},
{
"scene": "08",
"t0": 29.13,
"t1": 30.77,
"text": "in the dark, may never see"
},
{
"scene": "08",
"t0": 30.77,
"t1": 32.38,
"text": "a slow shape rising from"
},
{
"scene": "08",
"t0": 32.38,
"t1": 34.31,
"text": "below. The Greenland shark"
},
{
"scene": "08",
"t0": 34.31,
"t1": 35.56,
"text": "also eats whatever it finds."
},
{
"scene": "08",
"t0": 35.56,
"t1": 36.81,
"text": "\u2026"
},
{
"scene": "08",
"t0": 36.81,
"t1": 38.71,
"text": "Its stomachs have held fish,"
},
{
"scene": "08",
"t0": 38.71,
"t1": 40.3,
"text": "squid, and the remains of"
},
{
"scene": "08",
"t0": 40.3,
"t1": 41.8,
"text": "moose, horses,"
},
{
"scene": "08",
"t0": 41.8,
"t1": 42.97,
"text": "reindeer, and even polar bears."
},
{
"scene": "08",
"t0": 42.97,
"t1": 44.15,
"text": "\u2026"
},
{
"scene": "08",
"t0": 44.15,
"t1": 45.87,
"text": "In one case, an entire"
},
{
"scene": "08",
"t0": 45.87,
"t1": 47.15,
"text": "reindeer."
},
{
"scene": "08",
"t0": 47.15,
"t1": 48.77,
"text": "Nobody has ever filmed a Greenland"
},
{
"scene": "08",
"t0": 48.77,
"t1": 50.47,
"text": "shark catching a seal."
},
{
"scene": "08",
"t0": 50.47,
"t1": 51.97,
"text": "How it does it is still a"
},
{
"scene": "08",
"t0": 51.97,
"t1": 52.64,
"text": "mystery."
},
{
"scene": "09",
"t0": 0.0,
"t1": 1.73,
"text": "Look closely at a Greenland"
},
{
"scene": "09",
"t0": 1.73,
"t1": 3.44,
"text": "shark, and you will often see"
},
{
"scene": "09",
"t0": 3.44,
"t1": 5.42,
"text": "something hanging from its eye."
},
{
"scene": "09",
"t0": 5.42,
"t1": 7.02,
"text": "It is a parasite, a"
},
{
"scene": "09",
"t0": 7.02,
"t1": 8.54,
"text": "small crustacean about"
},
{
"scene": "09",
"t0": 8.54,
"t1": 10.3,
"text": "three centimetres long."
},
{
"scene": "09",
"t0": 10.3,
"t1": 11.89,
"text": "It clamps onto the surface of"
},
{
"scene": "09",
"t0": 11.89,
"t1": 12.91,
"text": "the eye and stays there."
},
{
"scene": "09",
"t0": 12.91,
"t1": 13.92,
"text": "\u2026"
},
{
"scene": "09",
"t0": 13.92,
"t1": 15.12,
"text": "It scars the eye as it feeds."
},
{
"scene": "09",
"t0": 15.12,
"t1": 16.32,
"text": "\u2026"
},
{
"scene": "09",
"t0": 16.32,
"t1": 17.85,
"text": "For years, people assumed"
},
{
"scene": "09",
"t0": 17.85,
"t1": 19.48,
"text": "most Greenland sharks were half"
},
{
"scene": "09",
"t0": 19.48,
"t1": 20.86,
"text": "blind."
},
{
"scene": "09",
"t0": 20.86,
"t1": 21.59,
"text": "Then, in"
},
{
"scene": "09",
"t0": 21.59,
"t1": 23.58,
"text": "2025, scientists"
},
{
"scene": "09",
"t0": 23.58,
"t1": 25.14,
"text": "studied the eyes of Greenland"
},
{
"scene": "09",
"t0": 25.14,
"t1": 26.67,
"text": "sharks more than a hundred years"
},
{
"scene": "09",
"t0": 26.67,
"t1": 28.24,
"text": "old. The retinas"
},
{
"scene": "09",
"t0": 28.24,
"t1": 29.27,
"text": "were healthy."
},
{
"scene": "09",
"t0": 29.27,
"t1": 30.87,
"text": "No widespread damage,"
},
{
"scene": "09",
"t0": 30.87,
"t1": 31.96,
"text": "no signs of breaking down with age."
},
{
"scene": "09",
"t0": 31.96,
"t1": 33.05,
"text": "\u2026"
},
{
"scene": "09",
"t0": 33.05,
"t1": 34.65,
"text": "Built only for dim light,"
},
{
"scene": "09",
"t0": 34.65,
"t1": 36.47,
"text": "with no colour vision at all."
},
{
"scene": "09",
"t0": 36.47,
"t1": 38.11,
"text": "But still working."
},
{
"scene": "09",
"t0": 38.11,
"t1": 39.63,
"text": "After a century or more in the"
},
{
"scene": "09",
"t0": 39.63,
"t1": 41.28,
"text": "dark, these sharks can still"
},
{
"scene": "09",
"t0": 41.28,
"t1": 41.93,
"text": "see."
},
{
"scene": "10",
"t0": 0.0,
"t1": 1.06,
"text": "So what is its secret?"
},
{
"scene": "10",
"t0": 1.06,
"t1": 2.12,
"text": "\u2026"
},
{
"scene": "10",
"t0": 2.12,
"t1": 3.75,
"text": "In 2024,"
},
{
"scene": "10",
"t0": 3.75,
"t1": 5.55,
"text": "scientists read the Greenland shark's"
},
{
"scene": "10",
"t0": 5.55,
"t1": 6.71,
"text": "whole genome for the first time."
},
{
"scene": "10",
"t0": 6.71,
"t1": 7.88,
"text": "\u2026"
},
{
"scene": "10",
"t0": 7.88,
"t1": 9.16,
"text": "It is huge."
},
{
"scene": "10",
"t0": 9.16,
"t1": 10.98,
"text": "About six and a half billion letters"
},
{
"scene": "10",
"t0": 10.98,
"t1": 12.16,
"text": "of DNA."
},
{
"scene": "10",
"t0": 12.16,
"t1": 13.87,
"text": "Twice as long as ours."
},
{
"scene": "10",
"t0": 13.87,
"t1": 15.37,
"text": "More than seventy percent of it"
},
{
"scene": "10",
"t0": 15.37,
"t1": 16.54,
"text": "is made of so-called jumping genes,"
},
{
"scene": "10",
"t0": 16.54,
"t1": 17.7,
"text": "\u2026"
},
{
"scene": "10",
"t0": 17.7,
"t1": 19.28,
"text": "pieces of DNA that copy"
},
{
"scene": "10",
"t0": 19.28,
"t1": 20.32,
"text": "themselves and move around."
},
{
"scene": "10",
"t0": 20.32,
"t1": 21.35,
"text": "\u2026"
},
{
"scene": "10",
"t0": 21.35,
"t1": 22.85,
"text": "Usually, that kind of chaos"
},
{
"scene": "10",
"t0": 22.85,
"t1": 24.09,
"text": "would cause damage."
},
{
"scene": "10",
"t0": 24.09,
"t1": 25.85,
"text": "But the Greenland shark seems to have"
},
{
"scene": "10",
"t0": 25.85,
"t1": 27.82,
"text": "extra copies of genes that repair"
},
{
"scene": "10",
"t0": 27.82,
"t1": 29.55,
"text": "DNA. In its eyes,"
},
{
"scene": "10",
"t0": 29.55,
"t1": 31.16,
"text": "too, the 2025"
},
{
"scene": "10",
"t0": 31.16,
"t1": 32.71,
"text": "study found active repair"
},
{
"scene": "10",
"t0": 32.71,
"t1": 33.91,
"text": "genes."
},
{
"scene": "10",
"t0": 33.91,
"t1": 35.42,
"text": "The idea is that, over"
},
{
"scene": "10",
"t0": 35.42,
"t1": 37.09,
"text": "hundreds of years, its body"
},
{
"scene": "10",
"t0": 37.09,
"t1": 38.49,
"text": "keeps fixing itself."
},
{
"scene": "10",
"t0": 38.49,
"t1": 39.72,
"text": "Not perfectly, but well enough."
},
{
"scene": "10",
"t0": 39.72,
"t1": 40.95,
"text": "\u2026"
},
{
"scene": "10",
"t0": 40.95,
"t1": 42.53,
"text": "Scientists hope it could one day help"
},
{
"scene": "10",
"t0": 42.53,
"t1": 44.03,
"text": "us understand ageing in other"
},
{
"scene": "10",
"t0": 44.03,
"t1": 45.85,
"text": "animals, including us."
},
{
"scene": "10",
"t0": 45.85,
"t1": 46.88,
"text": "Why some bodies wear out in decades,"
},
{
"scene": "10",
"t0": 46.88,
"t1": 47.91,
"text": "\u2026"
},
{
"scene": "10",
"t0": 47.91,
"t1": 49.55,
"text": "and one shark's body lasts for"
},
{
"scene": "10",
"t0": 49.55,
"t1": 50.49,
"text": "centuries."
},
{
"scene": "11",
"t0": 0.0,
"t1": 1.7,
"text": "There is one more thing that makes"
},
{
"scene": "11",
"t0": 1.7,
"t1": 3.37,
"text": "this shark strange."
},
{
"scene": "11",
"t0": 3.37,
"t1": 4.66,
"text": "Its meat is poisonous."
},
{
"scene": "11",
"t0": 4.66,
"t1": 5.94,
"text": "\u2026"
},
{
"scene": "11",
"t0": 5.94,
"t1": 7.46,
"text": "To survive in deep,"
},
{
"scene": "11",
"t0": 7.46,
"t1": 9.19,
"text": "cold water, its body"
},
{
"scene": "11",
"t0": 9.19,
"t1": 10.22,
"text": "is full of a chemical called"
},
{
"scene": "11",
"t0": 10.22,
"t1": 11.26,
"text": "\u2026"
},
{
"scene": "11",
"t0": 11.26,
"t1": 12.82,
"text": "TMAO, which helps"
},
{
"scene": "11",
"t0": 12.82,
"t1": 14.35,
"text": "protect its proteins from the"
},
{
"scene": "11",
"t0": 14.35,
"t1": 15.37,
"text": "pressure and the cold."
},
{
"scene": "11",
"t0": 15.37,
"t1": 16.39,
"text": "\u2026"
},
{
"scene": "11",
"t0": 16.39,
"t1": 17.46,
"text": "But for people, and for dogs,"
},
{
"scene": "11",
"t0": 17.46,
"t1": 18.54,
"text": "\u2026"
},
{
"scene": "11",
"t0": 18.54,
"t1": 20.16,
"text": "fresh Greenland shark meat can"
},
{
"scene": "11",
"t0": 20.16,
"t1": 21.77,
"text": "cause sickness that looks like being"
},
{
"scene": "11",
"t0": 21.77,
"t1": 23.01,
"text": "very drunk."
},
{
"scene": "11",
"t0": 23.01,
"t1": 24.65,
"text": "In Iceland, people found"
},
{
"scene": "11",
"t0": 24.65,
"t1": 26.02,
"text": "a way around it."
},
{
"scene": "11",
"t0": 26.02,
"t1": 27.6,
"text": "The meat is left to ferment for"
},
{
"scene": "11",
"t0": 27.6,
"t1": 29.33,
"text": "weeks, then hung to dry"
},
{
"scene": "11",
"t0": 29.33,
"t1": 30.68,
"text": "for months."
},
{
"scene": "11",
"t0": 30.68,
"t1": 31.79,
"text": "The result is called h\u00e1karl."
},
{
"scene": "11",
"t0": 31.79,
"t1": 32.9,
"text": "\u2026"
},
{
"scene": "11",
"t0": 32.9,
"t1": 33.94,
"text": "It smells strongly of ammonia."
},
{
"scene": "11",
"t0": 33.94,
"t1": 34.98,
"text": "\u2026"
},
{
"scene": "11",
"t0": 34.98,
"t1": 36.68,
"text": "And it is still eaten today."
},
{
"scene": "12",
"t0": 0.0,
"t1": 1.96,
"text": "In April 2022,"
},
{
"scene": "12",
"t0": 1.96,
"t1": 3.32,
"text": "a team of fishermen and a"
},
{
"scene": "12",
"t0": 3.32,
"t1": 4.83,
"text": "researcher were tagging"
},
{
"scene": "12",
"t0": 4.83,
"t1": 6.44,
"text": "tiger sharks off Belize,"
},
{
"scene": "12",
"t0": 6.44,
"t1": 7.92,
"text": "in the Caribbean."
},
{
"scene": "12",
"t0": 7.92,
"t1": 9.0,
"text": "From the deep slope of Glover's Reef,"
},
{
"scene": "12",
"t0": 9.0,
"t1": 10.07,
"text": "\u2026"
},
{
"scene": "12",
"t0": 10.07,
"t1": 11.88,
"text": "at night, they pulled up something"
},
{
"scene": "12",
"t0": 11.88,
"t1": 13.26,
"text": "no one expected."
},
{
"scene": "12",
"t0": 13.26,
"t1": 14.88,
"text": "A huge, slow,"
},
{
"scene": "12",
"t0": 14.88,
"t1": 16.51,
"text": "grey shark with tiny"
},
{
"scene": "12",
"t0": 16.51,
"t1": 18.33,
"text": "eyes. It was most likely"
},
{
"scene": "12",
"t0": 18.33,
"t1": 19.83,
"text": "a Greenland shark, or a"
},
{
"scene": "12",
"t0": 19.83,
"t1": 21.77,
"text": "hybrid with its Pacific cousin."
},
{
"scene": "12",
"t0": 21.77,
"t1": 23.02,
"text": "Thousands of kilometres from the Arctic."
},
{
"scene": "12",
"t0": 23.02,
"t1": 24.28,
"text": "\u2026"
},
{
"scene": "12",
"t0": 24.28,
"t1": 25.85,
"text": "How? The surface there is"
},
{
"scene": "12",
"t0": 25.85,
"t1": 27.55,
"text": "warm. But the reef drops"
},
{
"scene": "12",
"t0": 27.55,
"t1": 29.25,
"text": "away steeply, from about"
},
{
"scene": "12",
"t0": 29.25,
"t1": 31.0,
"text": "five hundred metres to nearly three"
},
{
"scene": "12",
"t0": 31.0,
"t1": 32.32,
"text": "kilometres deep."
},
{
"scene": "12",
"t0": 32.32,
"t1": 33.98,
"text": "And far below the warm surface,"
},
{
"scene": "12",
"t0": 33.98,
"t1": 35.6,
"text": "the water is cold, all year"
},
{
"scene": "12",
"t0": 35.6,
"t1": 37.25,
"text": "round. Only a few degrees"
},
{
"scene": "12",
"t0": 37.25,
"t1": 38.49,
"text": "above freezing."
},
{
"scene": "12",
"t0": 38.49,
"t1": 40.02,
"text": "Greenland sharks may be living"
},
{
"scene": "12",
"t0": 40.02,
"t1": 41.1,
"text": "much further south than anyone knew."
},
{
"scene": "12",
"t0": 41.1,
"t1": 42.18,
"text": "\u2026"
},
{
"scene": "12",
"t0": 42.18,
"t1": 43.79,
"text": "Not in the Arctic sea, but"
},
{
"scene": "12",
"t0": 43.79,
"t1": 45.32,
"text": "in the cold, dark layer"
},
{
"scene": "12",
"t0": 45.32,
"t1": 46.78,
"text": "beneath the warm one."
},
{
"scene": "13",
"t0": 0.0,
"t1": 1.85,
"text": "For an animal this famous,"
},
{
"scene": "13",
"t0": 1.85,
"t1": 3.26,
"text": "we know very little."
},
{
"scene": "13",
"t0": 3.26,
"t1": 4.99,
"text": "Even the four-hundred-year figure"
},
{
"scene": "13",
"t0": 4.99,
"t1": 6.29,
"text": "is still an estimate."
},
{
"scene": "13",
"t0": 6.29,
"t1": 8.09,
"text": "It depends on how fast these sharks"
},
{
"scene": "13",
"t0": 8.09,
"t1": 9.71,
"text": "really grow, and that has never"
},
{
"scene": "13",
"t0": 9.71,
"t1": 10.73,
"text": "been measured over a whole lifetime."
},
{
"scene": "13",
"t0": 10.73,
"t1": 11.74,
"text": "\u2026"
},
{
"scene": "13",
"t0": 11.74,
"t1": 12.79,
"text": "Nobody has been around long enough."
},
{
"scene": "13",
"t0": 12.79,
"t1": 13.85,
"text": "\u2026"
},
{
"scene": "13",
"t0": 13.85,
"t1": 15.65,
"text": "Scientists still do not know exactly"
},
{
"scene": "13",
"t0": 15.65,
"t1": 17.57,
"text": "where Greenland sharks give birth,"
},
{
"scene": "13",
"t0": 17.57,
"t1": 18.86,
"text": "or how often."
},
{
"scene": "13",
"t0": 18.86,
"t1": 20.42,
"text": "Their young are almost never"
},
{
"scene": "13",
"t0": 20.42,
"t1": 21.49,
"text": "seen."
},
{
"scene": "13",
"t0": 21.49,
"t1": 22.58,
"text": "We do not know how many there are."
},
{
"scene": "13",
"t0": 22.58,
"t1": 23.67,
"text": "\u2026"
},
{
"scene": "13",
"t0": 23.67,
"t1": 25.32,
"text": "We do not know how far they travel"
},
{
"scene": "13",
"t0": 25.32,
"t1": 26.92,
"text": "in a lifetime, or what"
},
{
"scene": "13",
"t0": 26.92,
"t1": 28.67,
"text": "really happens in their brain,"
},
{
"scene": "13",
"t0": 28.67,
"t1": 30.35,
"text": "their heart and their muscles that lets"
},
{
"scene": "13",
"t0": 30.35,
"t1": 31.41,
"text": "them last for centuries."
},
{
"scene": "13",
"t0": 31.41,
"t1": 32.46,
"text": "\u2026"
},
{
"scene": "13",
"t0": 32.46,
"t1": 34.0,
"text": "Every answer so far has"
},
{
"scene": "13",
"t0": 34.0,
"t1": 35.47,
"text": "raised a new question."
},
{
"scene": "14",
"t0": 0.0,
"t1": 1.5,
"text": "And there is a danger"
},
{
"scene": "14",
"t0": 1.5,
"t1": 3.15,
"text": "in living slowly."
},
{
"scene": "14",
"t0": 3.15,
"t1": 4.68,
"text": "Every year, Greenland"
},
{
"scene": "14",
"t0": 4.68,
"t1": 6.29,
"text": "sharks are caught by accident"
},
{
"scene": "14",
"t0": 6.29,
"t1": 7.87,
"text": "in fishing nets and on"
},
{
"scene": "14",
"t0": 7.87,
"t1": 9.84,
"text": "lines in the North Atlantic."
},
{
"scene": "14",
"t0": 9.84,
"t1": 11.37,
"text": "For most fish, that can be"
},
{
"scene": "14",
"t0": 11.37,
"t1": 12.59,
"text": "replaced."
},
{
"scene": "14",
"t0": 12.59,
"t1": 14.2,
"text": "But a Greenland shark that dies"
},
{
"scene": "14",
"t0": 14.2,
"t1": 15.75,
"text": "today may have taken more"
},
{
"scene": "14",
"t0": 15.75,
"t1": 17.46,
"text": "than a century to grow up."
},
{
"scene": "14",
"t0": 17.46,
"t1": 19.28,
"text": "Its population could take centuries"
},
{
"scene": "14",
"t0": 19.28,
"t1": 20.35,
"text": "to recover."
},
{
"scene": "14",
"t0": 20.35,
"t1": 21.91,
"text": "That is why the Greenland shark is"
},
{
"scene": "14",
"t0": 21.91,
"t1": 23.64,
"text": "now listed as vulnerable."
},
{
"scene": "15",
"t0": 0.0,
"t1": 1.55,
"text": "Right now, somewhere"
},
{
"scene": "15",
"t0": 1.55,
"t1": 3.06,
"text": "in the dark under the Arctic"
},
{
"scene": "15",
"t0": 3.06,
"t1": 4.76,
"text": "ice, a Greenland shark"
},
{
"scene": "15",
"t0": 4.76,
"t1": 6.64,
"text": "is drifting slowly through water"
},
{
"scene": "15",
"t0": 6.64,
"t1": 7.92,
"text": "near freezing."
},
{
"scene": "15",
"t0": 7.92,
"t1": 9.68,
"text": "She has no idea how old she"
},
{
"scene": "15",
"t0": 9.68,
"t1": 11.23,
"text": "is. She was here before"
},
{
"scene": "15",
"t0": 11.23,
"t1": 12.87,
"text": "the Mayflower, perhaps."
},
{
"scene": "15",
"t0": 12.87,
"t1": 14.68,
"text": "Before steam engines, before"
},
{
"scene": "15",
"t0": 14.68,
"t1": 16.43,
"text": "electric light, before anyone"
},
{
"scene": "15",
"t0": 16.43,
"t1": 17.89,
"text": "took a photograph."
},
{
"scene": "15",
"t0": 17.89,
"t1": 19.59,
"text": "She has seen the sea change around"
},
{
"scene": "15",
"t0": 19.59,
"t1": 20.8,
"text": "her, slowly, for centuries."
},
{
"scene": "15",
"t0": 20.8,
"t1": 22.01,
"text": "\u2026"
},
{
"scene": "15",
"t0": 22.01,
"t1": 23.54,
"text": "And if we let her, she may"
},
{
"scene": "15",
"t0": 23.54,
"t1": 25.16,
"text": "still be swimming long after all"
},
{
"scene": "15",
"t0": 25.16,
"t1": 26.25,
"text": "of us are gone."
}
]