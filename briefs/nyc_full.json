 "events": [
  {
   "year": 1609,
   "tag": "SEP 1609",
   "title": "The Half Moon sails in",
   "body": "Henry Hudson, an English captain sailing for the Dutch East India Company, explores the river that will carry his name",
   "min_time": 7.5
  },
  {
   "year": 1624,
   "tag": "1624",
   "title": "The first colonists",
   "body": "About thirty families, most of them French-speaking Walloons, arrive for the Dutch West India Company"
  },
  {
   "year": 1626,
   "tag": "1626",
   "title": "A deal for an island",
   "body": "Peter Minuit pays the Lenape in trade goods valued at 60 guilders. The two sides understood land ownership very differently"
  },
  {
   "year": 1647,
   "tag": "1647",
   "title": "Stuyvesant takes charge",
   "body": "Peter Stuyvesant arrives to run the colony and governs it for seventeen years"
  },
  {
   "year": 1653,
   "tag": "1653",
   "title": "A wall of timber",
   "body": "A palisade is built across the island against English attack. Its path becomes Wall Street"
  },
  {
   "year": 1664.6,
   "tag": "1664",
   "title": "New Amsterdam becomes New York",
   "body": "English warships enter the harbour; the town surrenders without a fight and is renamed for the Duke of York"
  },
  {
   "year": 1673.5,
   "tag": "1673",
   "title": "Dutch again, briefly",
   "body": "A Dutch fleet recaptures the city as New Orange. A peace treaty hands it back to England in 1674"
  },
  {
   "year": 1699,
   "tag": "1699",
   "title": "The wall comes down",
   "body": "The old palisade is removed, but the street along its line keeps the name"
  },
  {
   "year": 1731,
   "tag": "1731",
   "title": "A busy colonial port",
   "body": "About 8,600 people live here. Wharves and warehouses crowd the East River shore"
  },
  {
   "year": 1766,
   "tag": "1766",
   "title": "St. Paul's Chapel",
   "body": "Completed this year, it is now the oldest surviving church building in Manhattan"
  },
  {
   "year": 1776.6,
   "tag": "AUG 1776",
   "title": "A fleet of hundreds",
   "body": "The largest British force of the war gathers in the harbour. By September the city is in British hands"
  },
  {
   "year": 1776.712,
   "tag": "21 SEP 1776",
   "title": "The Great Fire",
   "body": "Flames race up the west side, destroying hundreds of houses and Trinity Church"
  },
  {
   "year": 1783.88,
   "tag": "25 NOV 1783",
   "title": "Evacuation Day",
   "body": "The last British troops sail away and American forces march back in"
  },
  {
   "year": 1789.32,
   "tag": "30 APR 1789",
   "title": "A capital and a president",
   "body": "George Washington is sworn in at Federal Hall on Wall Street. New York is the nation's first capital"
  },
  {
   "year": 1811,
   "tag": "1811",
   "title": "The grid",
   "body": "The Commissioners' Plan lays 12 avenues and 155 streets over the island's hills, farms and streams"
  },
  {
   "year": 1825,
   "tag": "1825",
   "title": "The Erie Canal opens",
   "body": "Great Lakes cargo now reaches the harbour by water, and New York becomes the country's leading port"
  },
  {
   "year": 1835.95,
   "tag": "16 DEC 1835",
   "title": "The Great Fire of 1835",
   "body": "In freezing weather, fire levels roughly 17 blocks of the commercial district"
  },
  {
   "year": 1842.5,
   "tag": "1842",
   "title": "Croton water",
   "body": "An aqueduct brings fresh water 41 miles from the Croton River into the city"
  },
  {
   "year": 1845.54,
   "tag": "JUL 1845",
   "title": "Fire again",
   "body": "Another blaze destroys more than 300 buildings in lower Manhattan"
  },
  {
   "year": 1857,
   "tag": "1857",
   "title": "Seneca Village",
   "body": "A settlement of mostly Black landowners is cleared by the city to make room for a new park"
  },
  {
   "year": 1858.5,
   "tag": "1858",
   "title": "Central Park",
   "body": "Olmsted and Vaux win the design contest. Building the park takes about fifteen years"
  },
  {
   "year": 1883.39,
   "tag": "24 MAY 1883",
   "title": "The Brooklyn Bridge opens",
   "body": "Its 486 m main span is the longest of any suspension bridge until 1903"
  },
  {
   "year": 1886.82,
   "tag": "28 OCT 1886",
   "title": "The Statue of Liberty",
   "body": "A gift from the people of France is dedicated in the harbour"
  },
  {
   "year": 1888.2,
   "min_time": 285,
   "tag": "MAR 1888",
   "title": "The Great Blizzard",
   "body": "Hurricane-force winds and more than 20 inches of snow shut the city down for days"
  },
  {
   "year": 1892,
   "tag": "1892",
   "title": "Ellis Island",
   "body": "The immigration station opens. About 12 million people will pass through it"
  },
  {
   "year": 1898,
   "tag": "1 JAN 1898",
   "title": "One city, five boroughs",
   "body": "Manhattan joins Brooklyn, Queens, the Bronx and Staten Island as Greater New York"
  },
  {
   "year": 1904.8,
   "tag": "27 OCT 1904",
   "title": "The subway opens",
   "body": "The first line runs from City Hall to 145th Street"
  },
  {
   "year": 1913.3,
   "tag": "1913",
   "title": "The Woolworth Building",
   "body": "At 241 m it is the tallest building in the world"
  },
  {
   "year": 1930.3,
   "tag": "1930",
   "title": "The Chrysler Building",
   "body": "A steel spire, raised from inside the tower, lifts it to 319 m"
  },
  {
   "year": 1931.33,
   "tag": "1 MAY 1931",
   "title": "The Empire State Building",
   "body": "Built in just over a year, at 381 m it stays the world's tallest for almost four decades"
  },
  {
   "year": 1952.8,
   "tag": "1952",
   "title": "The United Nations",
   "body": "The UN Secretariat opens beside the East River"
  },
  {
   "year": 1966,
   "tag": "1966",
   "title": "Radio Row cleared",
   "body": "Blocks of electronics shops are demolished to make way for the World Trade Center"
  },
  {
   "year": 1973.3,
   "tag": "1973",
   "title": "The Twin Towers",
   "body": "At 417 m, the North Tower was briefly the tallest building on Earth"
  },
  {
   "year": 1975.8,
   "tag": "1975",
   "title": "On the brink",
   "body": "The city comes within hours of defaulting on its debts"
  },
  {
   "year": 1990,
   "tag": "1990",
   "title": "Battery Park City",
   "body": "Homes, offices and parks rise on new land along the Hudson"
  },
  {
   "year": 2001.69,
   "tag": "11 SEP 2001",
   "title": "In memory",
   "body": "The Twin Towers are destroyed in a terrorist attack. 2,753 people are killed at the World Trade Center"
  },
  {
   "year": 2002.2,
   "tag": "MAR 2002",
   "title": "Tribute in Light",
   "body": "Two beams of light rise beside the site, in memory of those who were killed"
  },
  {
   "year": 2014.8,
   "tag": "NOV 2014",
   "title": "One World Trade Center",
   "body": "At 1,776 ft (541 m), the tallest building in the Western Hemisphere"
  },
  {
   "year": 2020,
   "tag": "2020",
   "title": "The supertalls",
   "body": "Slender towers line 57th Street. Central Park Tower reaches 472 m"
  },
  {
   "year": 2023.4,
   "tag": "JUN 2023",
   "title": "An orange sky",
   "body": "Smoke from Canadian wildfires gives New York some of the worst air on Earth for a day"
  }
 ],
