 ],
 "events": [
  {
   "year": 43,
   "tag": "AD 43",
   "title": "The Romans arrive",
   "body": "Emperor Claudius sends four legions across the Channel. They cross the Thames near here",
   "min_time": 16.5
  },
  {
   "year": 50,
   "tag": "c. AD 50",
   "title": "Londinium",
   "body": "Traders build a timber bridge and a new town grows on the north bank"
  },
  {
   "year": 60.6,
   "tag": "AD 60",
   "title": "Boudica's revolt",
   "body": "The Iceni queen leads a British army against the Romans"
  },
  {
   "year": 60.85,
   "tag": "AD 60–61",
   "title": "Londinium burns",
   "body": "Boudica's warriors destroy the town. A layer of red ash still lies under the City"
  },
  {
   "year": 100,
   "tag": "c. AD 100",
   "title": "A Roman capital",
   "body": "Rebuilt in stone, with the largest forum north of the Alps"
  },
  {
   "year": 200,
   "tag": "c. AD 200",
   "title": "The London Wall",
   "body": "A wall about 3 km long is built around the city. Its line shaped the City for 1,500 years"
  },
  {
   "year": 410,
   "tag": "AD 410",
   "title": "The Romans leave",
   "body": "Roman rule ends. Within decades the walled town is almost empty"
  },
  {
   "year": 600,
   "tag": "7TH CENTURY",
   "title": "Lundenwic",
   "body": "Anglo-Saxon traders settle a new town upriver, along today's Strand"
  },
  {
   "year": 842.3,
   "tag": "842",
   "title": "Viking raids",
   "body": "Danish longships sail up the Thames. Lundenwic is attacked again and again"
  },
  {
   "year": 886,
   "tag": "886",
   "title": "Alfred the Great",
   "body": "The King of Wessex moves Londoners back inside the old Roman walls"
  },
  {
   "year": 1066.95,
   "tag": "25 DEC 1066",
   "title": "A Norman king",
   "body": "William the Conqueror is crowned in Westminster Abbey on Christmas Day"
  },
  {
   "year": 1078,
   "tag": "1078",
   "title": "The White Tower",
   "body": "William orders a stone fortress to watch over the city. It becomes the Tower of London"
  },
  {
   "year": 1209,
   "tag": "1209",
   "title": "Old London Bridge",
   "body": "A stone bridge with houses and shops along it. For 600 years it is the only bridge across the Thames"
  },
  {
   "year": 1381.45,
   "tag": "JUNE 1381",
   "title": "The Peasants' Revolt",
   "body": "Rebels from Kent and Essex pour across London Bridge and into the city"
  },
  {
   "year": 1561.5,
   "tag": "1561",
   "title": "Lightning strike",
   "body": "Old St. Paul's loses its spire, one of the tallest in Europe. It is never rebuilt"
  },
  {
   "year": 1599,
   "tag": "1599",
   "title": "The Globe",
   "body": "Shakespeare's company opens its theatre on the south bank"
  },
  {
   "year": 1605.84,
   "tag": "5 NOV 1605",
   "title": "The Gunpowder Plot",
   "body": "A plan to blow up Parliament is foiled. Bonfires celebrate it to this day"
  },
  {
   "year": 1665.5,
   "tag": "1665",
   "title": "The Great Plague",
   "body": "About 100,000 Londoners die, nearly a quarter of the city"
  },
  {
   "year": 1666.67,
   "tag": "2 SEP 1666",
   "title": "The Great Fire",
   "body": "Fire starts in a bakery on Pudding Lane. It burns for four days"
  },
  {
   "year": 1666.71,
   "tag": "SEP 1666",
   "title": "A city destroyed",
   "body": "More than 13,000 houses and 87 churches burn, including Old St. Paul's"
  },
  {
   "year": 1684.05,
   "tag": "WINTER 1683–84",
   "title": "The Frost Fair",
   "body": "The Thames freezes solid. Londoners hold a fair on the ice"
  },
  {
   "year": 1710,
   "tag": "1710",
   "title": "Wren's St. Paul's",
   "body": "Christopher Wren's cathedral is declared complete, 35 years after work began"
  },
  {
   "year": 1750,
   "tag": "1750s",
   "title": "Georgian London",
   "body": "Elegant squares and terraces spread west across fields and farms"
  },
  {
   "year": 1800,
   "tag": "1801",
   "title": "A city of a million",
   "body": "London becomes the largest city in the world"
  },
  {
