 ],
 "events": [
  {
   "year": -800,
   "tag": "c. 800 BC",
   "title": "Hills above a river",
   "body": "Shepherds and farmers live on wooded hills beside a bend of the Tiber"
  },
  {
   "year": -771,
   "tag": "LEGEND",
   "title": "Romulus and Remus",
   "body": "Abandoned by the river, twin boys are found and fed by a she-wolf, says the legend",
   "min_time": 16
  },
  {
   "year": -753,
   "tag": "21 APR 753 BC",
   "title": "The founding",
   "body": "Legend says Romulus draws the city's boundary on the Palatine Hill and names Rome after himself"
  },
  {
   "year": -700,
   "tag": "7TH CENTURY BC",
   "title": "Kings of Rome",
   "body": "Seven kings, the story goes. The marshy valley below the hills is drained and becomes the Forum"
  },
  {
   "year": -509,
   "tag": "509 BC",
   "title": "The Republic",
   "body": "The last king is expelled. Rome is now ruled by the Senate and elected consuls"
  },
  {
   "year": -390,
   "tag": "390 BC",
   "title": "The Gauls sack Rome",
   "body": "Gallic warriors storm in from the north and burn the city. Only the Capitoline holds out"
  },
  {
   "year": -200,
   "tag": "2ND CENTURY BC",
   "title": "Mistress of the Mediterranean",
   "body": "After the wars with Carthage, wealth and slaves pour into a fast-growing city"
  },
  {
   "year": -44.8,
   "tag": "15 MAR 44 BC",
   "title": "The Ides of March",
   "body": "Julius Caesar is stabbed to death by senators at a meeting in the Theatre of Pompey"
  },
  {
   "year": -27,
   "tag": "27 BC",
   "title": "Augustus",
   "body": "Rome's first emperor claims he found a city of brick and left it a city of marble"
  },
  {
   "year": 64.05,
   "tag": "JULY AD 64",
   "title": "The Great Fire",
   "body": "Fire burns for six days near the Circus Maximus. Much of Rome is destroyed. Nero is blamed"
  },
  {
   "year": 80,
   "tag": "AD 80",
   "title": "The Colosseum opens",
   "body": "Up to 50,000 spectators watch 100 days of games to celebrate its opening"
  },
  {
   "year": 100,
   "tag": "AD 100",
   "title": "A city of a million",
   "body": "Perhaps a million people live here, the largest city in the world at the time"
  },
  {
   "year": 126,
   "tag": "AD 126",
   "title": "The Pantheon",
   "body": "Hadrian's temple gets its great concrete dome, still the largest unreinforced dome on Earth"
  },
  {
   "year": 216,
   "tag": "AD 216",
   "title": "The Baths of Caracalla",
   "body": "Vast public baths open, with room for over 1,500 bathers at a time"
  },
  {
   "year": 271,
   "tag": "AD 271",
   "title": "The Aurelian Walls",
   "body": "With enemies at Italy's borders, Rome builds 19 km of new walls"
  },
  {
   "year": 312,
   "tag": "AD 312",
   "title": "Constantine",
   "body": "The first Christian emperor. Churches like Old St. Peter's begin to rise"
  },
  {
   "year": 410.62,
   "tag": "24 AUG 410",
   "title": "The Visigoths sack Rome",
   "body": "Alaric's army enters through the Salarian Gate at night. Rome is plundered for three days"
  },
  {
   "year": 455.45,
   "tag": "455",
   "title": "The Vandals",
   "body": "A second sack, this time for two weeks. The word 'vandalism' comes from it"
  },
  {
   "year": 476,
   "tag": "476",
   "title": "The end of the Western Empire",
   "body": "The last emperor in the West is deposed. Rome's population collapses"
  },
  {
   "year": 537,
   "tag": "537",
   "title": "The aqueducts are cut",
   "body": "During a siege the aqueducts are broken. The hills empty and people move down to the river"
  },
  {
   "year": 800.9,
   "tag": "25 DEC 800",
   "title": "Charlemagne crowned",
   "body": "The Pope crowns the Frankish king emperor in Old St. Peter's"
  },
  {
   "year": 1150,
   "tag": "12TH CENTURY",
   "title": "City of towers",
   "body": "Noble families build fortified towers and fight each other in the streets"
  },
  {
   "year": 1309,
   "tag": "1309",
   "title": "The popes leave",
   "body": "The papacy moves to Avignon. Rome shrinks to perhaps 20,000 people among the ruins"
  },
  {
   "year": 1450,
   "tag": "1450",
   "title": "The Renaissance",
   "body": "Popes return, rebuild and invite the great artists of the age"
  },
  {
   "year": 1506,
   "tag": "1506",
   "title": "A new St. Peter's",
   "body": "The 1,200-year-old basilica is pulled down. Its replacement will take 120 years"
  },
  {
   "year": 1527.34,
   "tag": "6 MAY 1527",
   "title": "The Sack of Rome",
   "body": "Mutinous imperial troops storm the walls. The Swiss Guard dies defending the Pope"
  },
  {
   "year": 1590,
   "tag": "1590",
   "title": "Michelangelo's dome",
   "body": "The great dome of St. Peter's is completed, 26 years after Michelangelo's death"
  },
  {
   "year": 1651,
   "tag": "1651",
   "title": "Baroque Rome",
   "body": "Bernini's fountains and squares transform the city. The Four Rivers Fountain fills Piazza Navona"
  },
  {
   "year": 1667,
   "tag": "1667",
   "title": "St. Peter's Square",
   "body": "Bernini's colonnade embraces the square like two open arms"
  },
  {
   "year": 1849.4,
   "tag": "1849",
   "title": "The Roman Republic",
   "body": "Revolutionaries declare a republic. French troops besiege the Janiculum and restore the Pope"
  },
  {
   "year": 1870.71,
   "tag": "20 SEP 1870",
   "title": "The breach of Porta Pia",
   "body": "Italian troops break through the walls. Rome becomes part of Italy, and soon its capital"
  },
  {
   "year": 1890,
   "tag": "1880s",
   "title": "A new capital",
   "body": "Ministries, boulevards and new districts rise inside and beyond the old walls"
  },
  {
   "year": 1911,
   "tag": "1911",
   "title": "The Vittoriano",
   "body": "A vast white monument to Italy's first king opens, 50 years after unification"
  },
  {
   "year": 1932,
   "tag": "1932",
   "title": "Via dei Fori Imperiali",
   "body": "A broad avenue is cut through the ancient forums, demolishing a neighbourhood"
  },
  {
   "year": 1943.53,
   "tag": "19 JUL 1943",
   "title": "The bombing of San Lorenzo",
   "body": "Allied bombers strike the rail yards. Around 1,500 people are killed in the district"
  },
  {
   "year": 1946.5,
   "tag": "1946",
   "title": "The Italian Republic",
   "body": "Italians vote to end the monarchy"
  },
  {
   "year": 1960.65,
   "tag": "1960",
   "title": "The Olympic Games",
   "body": "Rome hosts the Summer Olympics, the 'Dolce Vita' years"
  },
  {
   "year": 2000,
   "tag": "2000",
   "title": "The Great Jubilee",
   "body": "Some 25 million pilgrims visit the city"
  },
  {
   "year": 2026,
   "tag": "2026",
   "title": "Rome today",
   "body": "Nearly three million people live in the Eternal City"
  }
 ],
